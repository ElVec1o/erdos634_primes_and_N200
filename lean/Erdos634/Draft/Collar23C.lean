-- Draft/Collar23C.lean -- (2,3) collar, part C: the three checked tables: the 13-tile CAP of the trapezoid, the 4-tile C-slice
-- (parallelogram 10 x 4) and the 6-tile B-slice (parallelogram 15 x 6).  GENERATED by internal working notes
-- (tile tables: the project's AI assistant P1 cap coordinates, internal working notes); every table is verified here by `decide`
-- (congruence to the model, non-degeneracy, a separating edge line for every pair, vertices in the region) and the covering by a
-- generated decision tree of linear case splits.  UNAUDITED.  No sorry, no native_decide.  NOT imported by All.
-- Credit: B. Herdt (the 1125 template), Beeson-Rosu, Paliy.
import Erdos634.Draft.Collar23B

open scoped Classical
open Erdos634.Geometry Erdos634.CertCoord Erdos634.Draft.RegionTiling

namespace Erdos634.Draft.Collar23

/-! ### The cap: trapezoid x >= 0, y >= -8, 0 <= 2x+3y <= 30 (vertices (0,0),(12,-8),(27,-8),(0,10)), 13 tiles -/

def capTab : Fin 13 → ZT := ![
  ⟨(0, 0), (0, 5), (6, -4)⟩,
  ⟨(0, 5), (0, 10), (6, 1)⟩,
  ⟨(6, 1), (6, -4), (0, 5)⟩,
  ⟨(4, 4), (9, 4), (0, 10)⟩,
  ⟨(8, -2), (13, -2), (4, 4)⟩,
  ⟨(9, 4), (4, 4), (13, -2)⟩,
  ⟨(6, -4), (6, 1), (12, -8)⟩,
  ⟨(12, -8), (17, -8), (8, -2)⟩,
  ⟨(13, -2), (8, -2), (17, -8)⟩,
  ⟨(13, -2), (18, -2), (9, 4)⟩,
  ⟨(17, -8), (22, -8), (13, -2)⟩,
  ⟨(18, -2), (13, -2), (22, -8)⟩,
  ⟨(22, -8), (27, -8), (18, -2)⟩]

def capReg : Cons := [(1, 0, 0), (0, 1, 8), (2, 3, 0), (-2, -3, 30)]

theorem cap_nd : ∀ i, (capTab i).nd := by decide
theorem cap_model : ∀ i, (capTab i).model := by decide
theorem cap_sep : ∀ i j, i ≠ j → sep (capTab i) (capTab j) := by decide
theorem cap_in : ∀ i, inR capReg (capTab i).a ∧ inR capReg (capTab i).b ∧ inR capReg (capTab i).c := by decide

theorem cap_cover : ∀ z ∈ Rset capReg, ∃ i, z ∈ (capTab i).H := by
  rintro ⟨x, y⟩ hz
  have h0 := hz (1, 0, 0) (by decide)
  norm_num at h0
  have h1 := hz (0, 1, 8) (by decide)
  norm_num at h1
  have h2 := hz (2, 3, 0) (by decide)
  norm_num at h2
  have h3 := hz (-2, -3, 30) (by decide)
  norm_num at h3
  by_cases hk : 0 ≤ (9:ℝ) * x + (6:ℝ) * y + (-30:ℝ)
  · by_cases hk : 0 ≤ (9:ℝ) * x + (6:ℝ) * y + (-60:ℝ)
    · by_cases hk : 0 ≤ (-4:ℝ) * x + (-6:ℝ) * y + (30:ℝ)
      · by_cases hk : 0 ≤ (0:ℝ) * x + (5:ℝ) * y + (10:ℝ)
        · exact ⟨4, memH (8, -2) (13, -2) (4, 4) 1 (x, y) (by norm_num [zcr])
            (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
        · rw [not_le] at hk
          by_cases hk : 0 ≤ (-6:ℝ) * x + (-4:ℝ) * y + (70:ℝ)
          · by_cases hk : 0 ≤ (-6:ℝ) * x + (-9:ℝ) * y + (30:ℝ)
            · exact ⟨7, memH (12, -8) (17, -8) (8, -2) 1 (x, y) (by norm_num [zcr])
                (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
            · rw [not_le] at hk
              exact ⟨8, memH (13, -2) (8, -2) (17, -8) 1 (x, y) (by norm_num [zcr])
                (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
          · rw [not_le] at hk
            exact ⟨10, memH (17, -8) (22, -8) (13, -2) 1 (x, y) (by norm_num [zcr])
              (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
      · rw [not_le] at hk
        by_cases hk : 0 ≤ (5:ℝ) * x + (0:ℝ) * y + (-30:ℝ)
        · by_cases hk : 0 ≤ (0:ℝ) * x + (5:ℝ) * y + (-20:ℝ)
          · exact ⟨3, memH (4, 4) (9, 4) (0, 10) 1 (x, y) (by norm_num [zcr])
              (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
          · rw [not_le] at hk
            by_cases hk : 0 ≤ (0:ℝ) * x + (5:ℝ) * y + (10:ℝ)
            · by_cases hk : 0 ≤ (-6:ℝ) * x + (-9:ℝ) * y + (60:ℝ)
              · exact ⟨4, memH (8, -2) (13, -2) (4, 4) 1 (x, y) (by norm_num [zcr])
                  (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
              · rw [not_le] at hk
                by_cases hk : 0 ≤ (-6:ℝ) * x + (-4:ℝ) * y + (70:ℝ)
                · exact ⟨5, memH (9, 4) (4, 4) (13, -2) 1 (x, y) (by norm_num [zcr])
                    (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
                · rw [not_le] at hk
                  exact ⟨9, memH (13, -2) (18, -2) (9, 4) 1 (x, y) (by norm_num [zcr])
                    (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
            · rw [not_le] at hk
              by_cases hk : 0 ≤ (-6:ℝ) * x + (-9:ℝ) * y + (60:ℝ)
              · by_cases hk : 0 ≤ (-6:ℝ) * x + (-4:ℝ) * y + (70:ℝ)
                · exact ⟨8, memH (13, -2) (8, -2) (17, -8) 1 (x, y) (by norm_num [zcr])
                    (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
                · rw [not_le] at hk
                  exact ⟨10, memH (17, -8) (22, -8) (13, -2) 1 (x, y) (by norm_num [zcr])
                    (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
              · rw [not_le] at hk
                by_cases hk : 0 ≤ (-6:ℝ) * x + (-4:ℝ) * y + (100:ℝ)
                · exact ⟨11, memH (18, -2) (13, -2) (22, -8) 1 (x, y) (by norm_num [zcr])
                    (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
                · rw [not_le] at hk
                  exact ⟨12, memH (22, -8) (27, -8) (18, -2) 1 (x, y) (by norm_num [zcr])
                    (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
        · rw [not_le] at hk
          by_cases hk : 0 ≤ (0:ℝ) * x + (5:ℝ) * y + (-20:ℝ)
          · exact ⟨3, memH (4, 4) (9, 4) (0, 10) 1 (x, y) (by norm_num [zcr])
              (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
          · rw [not_le] at hk
            by_cases hk : 0 ≤ (-6:ℝ) * x + (-9:ℝ) * y + (60:ℝ)
            · exact ⟨4, memH (8, -2) (13, -2) (4, 4) 1 (x, y) (by norm_num [zcr])
                (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
            · rw [not_le] at hk
              exact ⟨5, memH (9, 4) (4, 4) (13, -2) 1 (x, y) (by norm_num [zcr])
                (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
    · rw [not_le] at hk
      by_cases hk : 0 ≤ (-4:ℝ) * x + (-6:ℝ) * y + (30:ℝ)
      · by_cases hk : 0 ≤ (5:ℝ) * x + (0:ℝ) * y + (-30:ℝ)
        · exact ⟨6, memH (6, -4) (6, 1) (12, -8) (-1) (x, y) (by norm_num [zcr])
            (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
        · rw [not_le] at hk
          exact ⟨2, memH (6, 1) (6, -4) (0, 5) (-1) (x, y) (by norm_num [zcr])
            (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
      · rw [not_le] at hk
        exact ⟨1, memH (0, 5) (0, 10) (6, 1) (-1) (x, y) (by norm_num [zcr])
          (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
  · rw [not_le] at hk
    exact ⟨0, memH (0, 0) (0, 5) (6, -4) (-1) (x, y) (by norm_num [zcr])
      (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩

noncomputable def capRT : RTiling (Phi '' Rset capReg) M23 13 :=
  ztiling capTab capReg cap_nd cap_model cap_sep cap_in cap_cover

/-! ### The C-slice: 0 <= x <= 6, 0 <= 2x+3y <= 30, two (4,5)-parallelograms = 4 tiles -/

def csTab : Fin 4 → ZT := ![
  ⟨(0, 0), (0, 5), (6, -4)⟩,
  ⟨(6, 1), (6, -4), (0, 5)⟩,
  ⟨(0, 5), (0, 10), (6, 1)⟩,
  ⟨(6, 6), (6, 1), (0, 10)⟩]

def csReg : Cons := [(1, 0, 0), (-1, 0, 6), (2, 3, 0), (-2, -3, 30)]

theorem cs_nd : ∀ i, (csTab i).nd := by decide
theorem cs_model : ∀ i, (csTab i).model := by decide
theorem cs_sep : ∀ i j, i ≠ j → sep (csTab i) (csTab j) := by decide
theorem cs_in : ∀ i, inR csReg (csTab i).a ∧ inR csReg (csTab i).b ∧ inR csReg (csTab i).c := by decide

theorem cs_cover : ∀ z ∈ Rset csReg, ∃ i, z ∈ (csTab i).H := by
  rintro ⟨x, y⟩ hz
  have h0 := hz (1, 0, 0) (by decide)
  norm_num at h0
  have h1 := hz (-1, 0, 6) (by decide)
  norm_num at h1
  have h2 := hz (2, 3, 0) (by decide)
  norm_num at h2
  have h3 := hz (-2, -3, 30) (by decide)
  norm_num at h3
  by_cases hk : 0 ≤ (9:ℝ) * x + (6:ℝ) * y + (-30:ℝ)
  · by_cases hk : 0 ≤ (4:ℝ) * x + (6:ℝ) * y + (-30:ℝ)
    · by_cases hk : 0 ≤ (9:ℝ) * x + (6:ℝ) * y + (-60:ℝ)
      · exact ⟨3, memH (6, 6) (6, 1) (0, 10) (-1) (x, y) (by norm_num [zcr])
          (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
      · rw [not_le] at hk
        exact ⟨2, memH (0, 5) (0, 10) (6, 1) (-1) (x, y) (by norm_num [zcr])
          (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
    · rw [not_le] at hk
      exact ⟨1, memH (6, 1) (6, -4) (0, 5) (-1) (x, y) (by norm_num [zcr])
        (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
  · rw [not_le] at hk
    exact ⟨0, memH (0, 0) (0, 5) (6, -4) (-1) (x, y) (by norm_num [zcr])
      (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩

noncomputable def csRT : RTiling (Phi '' Rset csReg) M23 4 :=
  ztiling csTab csReg cs_nd cs_model cs_sep cs_in cs_cover

/-! ### The B-slice: 0 <= y <= 6, 0 <= 2x+3y <= 30, three (6,5)-parallelograms = 6 tiles -/

def bsTab : Fin 6 → ZT := ![
  ⟨(0, 0), (5, 0), (-4, 6)⟩,
  ⟨(-4, 6), (-9, 6), (0, 0)⟩,
  ⟨(5, 0), (10, 0), (1, 6)⟩,
  ⟨(1, 6), (-4, 6), (5, 0)⟩,
  ⟨(10, 0), (15, 0), (6, 6)⟩,
  ⟨(6, 6), (1, 6), (10, 0)⟩]

def bsReg : Cons := [(0, 1, 0), (0, -1, 6), (2, 3, 0), (-2, -3, 30)]

theorem bs_nd : ∀ i, (bsTab i).nd := by decide
theorem bs_model : ∀ i, (bsTab i).model := by decide
theorem bs_sep : ∀ i j, i ≠ j → sep (bsTab i) (bsTab j) := by decide
theorem bs_in : ∀ i, inR bsReg (bsTab i).a ∧ inR bsReg (bsTab i).b ∧ inR bsReg (bsTab i).c := by decide

theorem bs_cover : ∀ z ∈ Rset bsReg, ∃ i, z ∈ (bsTab i).H := by
  rintro ⟨x, y⟩ hz
  have h0 := hz (0, 1, 0) (by decide)
  norm_num at h0
  have h1 := hz (0, -1, 6) (by decide)
  norm_num at h1
  have h2 := hz (2, 3, 0) (by decide)
  norm_num at h2
  have h3 := hz (-2, -3, 30) (by decide)
  norm_num at h3
  by_cases hk : 0 ≤ (-6:ℝ) * x + (-9:ℝ) * y + (30:ℝ)
  · by_cases hk : 0 ≤ (6:ℝ) * x + (4:ℝ) * y + (0:ℝ)
    · exact ⟨0, memH (0, 0) (5, 0) (-4, 6) 1 (x, y) (by norm_num [zcr])
        (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
    · rw [not_le] at hk
      exact ⟨1, memH (-4, 6) (-9, 6) (0, 0) 1 (x, y) (by norm_num [zcr])
        (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
  · rw [not_le] at hk
    by_cases hk : 0 ≤ (-6:ℝ) * x + (-9:ℝ) * y + (60:ℝ)
    · by_cases hk : 0 ≤ (6:ℝ) * x + (4:ℝ) * y + (-30:ℝ)
      · exact ⟨2, memH (5, 0) (10, 0) (1, 6) 1 (x, y) (by norm_num [zcr])
          (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
      · rw [not_le] at hk
        exact ⟨3, memH (1, 6) (-4, 6) (5, 0) 1 (x, y) (by norm_num [zcr])
          (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
    · rw [not_le] at hk
      by_cases hk : 0 ≤ (6:ℝ) * x + (4:ℝ) * y + (-60:ℝ)
      · exact ⟨4, memH (10, 0) (15, 0) (6, 6) 1 (x, y) (by norm_num [zcr])
          (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩
      · rw [not_le] at hk
        exact ⟨5, memH (6, 6) (1, 6) (10, 0) 1 (x, y) (by norm_num [zcr])
          (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith) (by norm_num [rcr]; linarith)⟩

noncomputable def bsRT : RTiling (Phi '' Rset bsReg) M23 6 :=
  ztiling bsTab bsReg bs_nd bs_model bs_sep bs_in bs_cover

end Erdos634.Draft.Collar23

