def P11 (d y t : ℝ) : ℝ × ℝ :=
  ((3*d + 2*y)*(2*d + t + y)*(3*d + t + 2*y),
   -t*(d + y)*(3*d + t + 2*y))

def P12 (d y t : ℝ) : ℝ × ℝ :=
  ((2*d + t + y)*(5*d^2 + 3*d*t + 8*d*y + 2*t*y + 3*y^2),
