/-- the hypotheses on the three positive parameters -/
structure Hyp (d y t : ℝ) : Prop where
  hd : 0 < d
  hy : 0 < y
  ht : 0 < t
  hR : 3 * d ^ 2 = y ^ 2 + y * t

def ea (d y : ℝ) : ℝ := 2 * d + y
def eb (d y t : ℝ) : ℝ := 2 * d + y + t
def ec (d y t : ℝ) : ℝ := 3 * d + 2 * y + t

theorem pa {d y t : ℝ} (H : Hyp d y t) : 0 < ea d y := by obtain ⟨hd, hy, ht, hR⟩ := H; unfold ea; positivity
theorem pb {d y t : ℝ} (H : Hyp d y t) : 0 < eb d y t := by obtain ⟨hd, hy, ht, hR⟩ := H; unfold eb; positivity
theorem pc {d y t : ℝ} (H : Hyp d y t) : 0 < ec d y t := by obtain ⟨hd, hy, ht, hR⟩ := H; unfold ec; positivity
theorem hcR {d y t : ℝ} (H : Hyp d y t) : ec d y t ^ 2 = ea d y ^ 2 + ea d y * eb d y t + eb d y t ^ 2 := by
  obtain ⟨hd, hy, ht, hR⟩ := H; unfold ea eb ec; linear_combination (-1 : ℝ) * hR

/-- the model tile (frame scale `c`): legs `b c`, `a c` -/
noncomputable def M3 {d y t : ℝ} (H : Hyp d y t) : Tri := Mod3 (pa H) (pb H) (pc H)


def P0 (d y t : ℝ) : ℝ × ℝ :=
  (-(2*d + y)^2*(3*d + t + 2*y),
   0)

def P1 (d y t : ℝ) : ℝ × ℝ :=
  (2*(2*d + y)*(2*d + t + y)*(3*d + t + 2*y),
   -(2*d + t + y)*(3*d + t + 2*y)*(6*d + t + 3*y))

def P2 (d y t : ℝ) : ℝ × ℝ :=
  (2*(2*d + y)*(2*d + t + y)*(3*d + t + 2*y),
   (2*d + t + y)*(3*d + t + 2*y)*(6*d + 2*t + 3*y))

def P3 (d y t : ℝ) : ℝ × ℝ :=
  ((2*d + y)*(2*d + t + y)*(3*d + t + 2*y),
   -(2*d + y)*(2*d + t + y)*(3*d + t + 2*y))

def P4 (d y t : ℝ) : ℝ × ℝ :=
  ((2*d + y)*(2*d + t + y)*(3*d + t + 2*y),
   (2*d + t + y)*(3*d + t + 2*y)*(4*d + t + 2*y))

def P5 (d y t : ℝ) : ℝ × ℝ :=
  (2*(2*d + y)*(2*d + t + y)*(3*d + t + 2*y),
   -2*(2*d + y)*(2*d + t + y)*(3*d + t + 2*y))

def P6 (d y t : ℝ) : ℝ × ℝ :=
  (2*(2*d + y)*(2*d + t + y)*(3*d + t + 2*y),
   (2*d + t + y)*(3*d + t + 2*y)*(4*d + t + 2*y))

def P7 (d y t : ℝ) : ℝ × ℝ :=
  ((3*d + 2*y)*(2*d + t + y)*(3*d + t + 2*y),
   -(3*d + 2*y)*(2*d + t + y)*(3*d + t + 2*y))

def P8 (d y t : ℝ) : ℝ × ℝ :=
  ((3*d + 2*y)*(2*d + t + y)*(3*d + t + 2*y),
