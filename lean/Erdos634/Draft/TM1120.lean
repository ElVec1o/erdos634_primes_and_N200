theorem hvol_all : ((∑ a, cnt a : ℕ) : ENNReal) * volume (brickL (3/2:ℝ) hf (5:ℝ) (6:ℝ) (by norm_num) (by norm_num)).carrier = volume tgt.carrier := by
  have hs := sD_pos hf
  have hM : volume (brickL (3/2:ℝ) hf (5:ℝ) (6:ℝ) (by norm_num) (by norm_num)).carrier = ENNReal.ofReal (sD (3/2:ℝ) / (2 * (3/2:ℝ)) * ((5:ℝ) * (6:ℝ)))
      * volume Erdos634.AreaDet.stdCarrier := by
    unfold brickL
    rw [vol_triC]
    congr 2
    rw [← abs_of_pos (show 0 < sD (3/2:ℝ) / (2 * (3/2:ℝ)) * ((5:ℝ) * (6:ℝ)) by positivity)]
    congr 1; ring
  have hT : volume tgt.carrier = ENNReal.ofReal (sD (3/2:ℝ) / (2 * (3/2:ℝ)) * (33600:ℝ))
      * volume Erdos634.AreaDet.stdCarrier := by
    unfold tgt
    rw [vol_triC]
    congr 2
    rw [← abs_of_pos (show 0 < sD (3/2:ℝ) / (2 * (3/2:ℝ)) * (33600:ℝ) by positivity)]
    congr 1; simp only [tA, tB, tC]; norm_num
  rw [hM, hT, ← mul_assoc, ← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (Nat.cast_nonneg _), sum_cnt]
  congr 2
  push_cast
  ring

