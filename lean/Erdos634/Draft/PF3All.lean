/-
Draft/PF3All.lean — **the PF3 family for ALL Eisenstein triples with `b < a` and `b c - a² ∈ ⟨a, b, c⟩`**: for naturals `0 < b < a`, `c² = a² + a b + b²`
and `A, B, s ∈ ℕ` with `A a + B b + s c + a² = b c` (D. Paliy's precondition: `b c - a²` lies in the numerical semigroup `⟨a, b, c⟩`),
`3 * (a + b) * (a + 2 * b)` is a tile count (and `3 * (a + b) * (a + 2 * b) k²` for every `k`).  Shape: ordered F3 (`b < a < 2b`): the triangle X Y K (frame scale `c²`) is tiled by `3(a+b)(a+2b)` copies of the tile `c²·(b, a, c)`.

Construction due to **D. Paliy** (unrefereed ledger, "nested corners"), decoded in `code/r8/rows.py`; the symbolic Lean proof for all
`(a, b, c)` and all witnesses is generated by a generator script (not shipped) (modules `PF3Defs`, `PF3Disj1..`, `PF3Sub`, `PF3Tile`, `PF3Asm`, `PF3Real`).
Instances below are the 22 values of the R8 table (exact-verified, `data/witnesses/r8_exact/`).  No sorry, no native_decide.
-/
import Erdos634.Draft.PF3Real

namespace Erdos634.Draft.PF3All
open Erdos634.Draft.TileCountFamilies

theorem pf3_family (a b c : ℕ) (hb : 0 < b) (hab : b < a) (h2 : a < 2 * b) (hc : c ^ 2 = a ^ 2 + a * b + b ^ 2)
    : TileCount (3 * (a + b) * (a + 2 * b)) := by
  obtain ⟨nd, ny, nt, hnd, hny, hnt, hR, rfl, rfl, rfl⟩ := Erdos634.Draft.PHyp.params a b c hb hab hc
  obtain ⟨w, hw⟩ : ∃ w, 2 * nd + ny = w + nt := ⟨2 * nd + ny - nt, by omega⟩
  have hwpos : 0 < w := by omega
  obtain ⟨D⟩ := Erdos634.Draft.PF3G.pf3_real nd ny nt w 0 0 hnd hny hnt hwpos hR (by omega)
  unfold TileCount
  have e : 3 * ((2 * nd + ny + nt) + (2 * nd + ny)) * ((2 * nd + ny + nt) + 2 * (2 * nd + ny)) = 72 * nd ^ 2 + 72 * nd * ny + 30 * nd * nt + 18 * ny ^ 2 + 15 * ny * nt + 3 * nt ^ 2 := by ring
  rw [e]
  exact ⟨D⟩


theorem tileCount_25179 : TileCount 25179 := by
  have h := pf3_family 45 32 67 (by norm_num) (by norm_num) (by norm_num) (by norm_num)
  norm_num at h
  exact h

