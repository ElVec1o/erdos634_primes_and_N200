/-! ### the regions `Z0`, `Z1`, …, `Z6` in `W_M` -/
theorem Z0_mem (q : ℝ × ℝ) (hq : q ∈ Z0 u g s x) :
    q.1 - cA u g ≤ cA u g * (wmM u g s x - 1) ∧ q.2 ≤ cB u g * (wmM u g s x - 1) ∧
      cA u g * cB u g * (wmM u g s x - 1) ≤ cB u g * (q.1 - cA u g) + cA u g * q.2 := by
  have hq' : (q - (cA u g, 0)).1 ≤ cA u g * (wmM u g s x - 1) ∧ (q - (cA u g, 0)).2 ≤ cB u g * (wmM u g s x - 1) ∧
      cA u g * cB u g * (wmM u g s x - 1) ≤ cB u g * (q - (cA u g, 0)).1 + cA u g * (q - (cA u g, 0)).2 := hq
  simpa only [Prod.fst_sub, Prod.snd_sub, sub_zero] using hq'

theorem cA_eq : cA u g * wmM u g s x = wU u g s x := by
  have h : g * (2 * u + g) ≠ 0 := by positivity
  simp only [cA, wU, wmM, cb]; field_simp; ring
theorem cB_eq : cB u g * wmM u g s x = wV u g s x := by
  have h : g * (2 * u + g) ≠ 0 := by positivity
  simp only [cB, wV, wmM]; field_simp; ring
theorem wU_ge : cA u g ≤ wU u g s x := by
  have hM := wM_gt hu hg hs hx
  have hA : 0 < cA u g := wcA_pos hu hg
  rw [← cA_eq hu hg hs hx]; nlinarith
theorem wV_ge : cB u g ≤ wV u g s x := by
  have hM := wM_gt hu hg hs hx
  have hB : 0 < cB u g := wcB_pos hu hg
  rw [← cB_eq hu hg hs hx]; nlinarith

/-- membership in `W_M` from the three linear conditions (the last one in the form of `Wt`) -/
theorem ZT_of_Wt (q : ℝ × ℝ) (h1 : q.1 ≤ wU u g s x) (h2 : q.2 ≤ wV u g s x)
    (h3 : cA u g * cB u g * wmM u g s x ≤ cB u g * q.1 + cA u g * q.2) : q ∈ ZT u g s x := by
  have hM := wM_gt hu hg hs hx
  have hM0 : 0 < wmM u g s x := by linarith
  have eU := cA_eq hu hg hs hx
  have eV := cB_eq hu hg hs hx
  show q.1 ≤ wU u g s x ∧ q.2 ≤ wV u g s x ∧ wU u g s x * wV u g s x ≤ wV u g s x * q.1 + wU u g s x * q.2
  refine ⟨h1, h2, ?_⟩
  rw [← eU, ← eV]
  nlinarith [mul_le_mul_of_nonneg_left h3 hM0.le]

theorem Z0_sub : Z0 u g s x ⊆ ZT u g s x := by
  intro q hq
  obtain ⟨h1, h2, h3⟩ := Z0_mem hu hg hs hx q hq
  have hM := wM_gt hu hg hs hx
  have hA : 0 < cA u g := wcA_pos hu hg
  have hB : 0 < cB u g := wcB_pos hu hg
  have eU := cA_eq hu hg hs hx
  have eV := cB_eq hu hg hs hx
  have hM0 : 0 < wmM u g s x := by linarith
  show q.1 ≤ wU u g s x ∧ q.2 ≤ wV u g s x ∧ wU u g s x * wV u g s x ≤ wV u g s x * q.1 + wU u g s x * q.2
  refine ⟨?_, ?_, ?_⟩
  · rw [← eU]; nlinarith
  · rw [← eV]; nlinarith
  · rw [← eU, ← eV]
    nlinarith [mul_le_mul_of_nonneg_left h3 hM0.le]

theorem Z1_sub : Z1 u g s x ⊆ ZT u g s x := fun q hq =>
  ZT_of_Wt hu hg hs hx q (by simpa only [one_mul, zero_mul, add_zero] using ct_x_1 hu hg hs hx q hq)
    (by simpa only [zero_mul, zero_add, one_mul] using ct_y_1 hu hg hs hx q hq) (ct_w_1 hu hg hs hx q hq)
