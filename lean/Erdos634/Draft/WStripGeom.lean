  | ⟨6, _⟩, ⟨2, _⟩ => (dW_2_6 hu hg hs hx).symm
  | ⟨6, _⟩, ⟨3, _⟩ => (dW_3_6 hu hg hs hx).symm
  | ⟨6, _⟩, ⟨4, _⟩ => (dW_4_6 hu hg hs hx).symm
