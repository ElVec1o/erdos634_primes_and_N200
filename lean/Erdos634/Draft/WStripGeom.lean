theorem y_ge_Z0 : ∀ q ∈ Z0 u g s x, q.2 ≤ wV u g s x - cB u g := by
  intro q hq
  obtain ⟨h1, h2, h3⟩ := Z0_mem hu hg hs hx q hq
  have eV := cB_eq hu hg hs hx
  have : cB u g * (wmM u g s x - 1) = wV u g s x - cB u g := by rw [← eV]; ring
  linarith

theorem x_le_Z0 : ∀ q ∈ Z0 u g s x, q.1 ≤ wU u g s x := fun q hq => (Z0_sub hu hg hs hx hq).1

theorem cB_poly : cB u g = (u ^ 3 + 4 * u ^ 2 * g + 2 * u * g ^ 2) := by
  simp only [cB]; ring

