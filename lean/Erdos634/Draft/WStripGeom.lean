/-! ### the seven regions as a family -/
theorem Wf_sub : ∀ a : Fin 7, Wf u g s x a ⊆ ZT u g s x := fun a => match a with
  | ⟨0, _⟩ => Z0_sub hu hg hs hx
  | ⟨1, _⟩ => Z1_sub hu hg hs hx
  | ⟨2, _⟩ => Z2_sub hu hg hs hx
  | ⟨3, _⟩ => Z3_sub hu hg hs hx
  | ⟨4, _⟩ => Z4_sub hu hg hs hx
  | ⟨5, _⟩ => Z5_sub hu hg hs hx
  | ⟨6, _⟩ => Z6_sub hu hg hs hx
  | ⟨k + 7, h⟩ => absurd h (by omega)

theorem dW_all : ∀ a b : Fin 7, a ≠ b → Disjoint (interior (Wf u g s x a)) (interior (Wf u g s x b)) := by
  intro a b hab
  exact match a, b with
  | ⟨0, _⟩, ⟨0, _⟩ => absurd rfl hab
  | ⟨0, _⟩, ⟨1, _⟩ => dW_0_1 hu hg hs hx
  | ⟨0, _⟩, ⟨2, _⟩ => dW_0_2 hu hg hs hx
  | ⟨0, _⟩, ⟨3, _⟩ => dW_0_3 hu hg hs hx
  | ⟨0, _⟩, ⟨4, _⟩ => dW_0_4 hu hg hs hx
  | ⟨0, _⟩, ⟨5, _⟩ => dW_0_5 hu hg hs hx
  | ⟨0, _⟩, ⟨6, _⟩ => dW_0_6 hu hg hs hx
  | ⟨1, _⟩, ⟨0, _⟩ => (dW_0_1 hu hg hs hx).symm
  | ⟨1, _⟩, ⟨1, _⟩ => absurd rfl hab
  | ⟨1, _⟩, ⟨2, _⟩ => dW_1_2 hu hg hs hx
  | ⟨1, _⟩, ⟨3, _⟩ => dW_1_3 hu hg hs hx
  | ⟨1, _⟩, ⟨4, _⟩ => dW_1_4 hu hg hs hx
  | ⟨1, _⟩, ⟨5, _⟩ => dW_1_5 hu hg hs hx
  | ⟨1, _⟩, ⟨6, _⟩ => dW_1_6 hu hg hs hx
  | ⟨2, _⟩, ⟨0, _⟩ => (dW_0_2 hu hg hs hx).symm
  | ⟨2, _⟩, ⟨1, _⟩ => (dW_1_2 hu hg hs hx).symm
  | ⟨2, _⟩, ⟨2, _⟩ => absurd rfl hab
  | ⟨2, _⟩, ⟨3, _⟩ => dW_2_3 hu hg hs hx
  | ⟨2, _⟩, ⟨4, _⟩ => dW_2_4 hu hg hs hx
  | ⟨2, _⟩, ⟨5, _⟩ => dW_2_5 hu hg hs hx
  | ⟨2, _⟩, ⟨6, _⟩ => dW_2_6 hu hg hs hx
  | ⟨3, _⟩, ⟨0, _⟩ => (dW_0_3 hu hg hs hx).symm
  | ⟨3, _⟩, ⟨1, _⟩ => (dW_1_3 hu hg hs hx).symm
  | ⟨3, _⟩, ⟨2, _⟩ => (dW_2_3 hu hg hs hx).symm
  | ⟨3, _⟩, ⟨3, _⟩ => absurd rfl hab
  | ⟨3, _⟩, ⟨4, _⟩ => dW_3_4 hu hg hs hx
  | ⟨3, _⟩, ⟨5, _⟩ => dW_3_5 hu hg hs hx
  | ⟨3, _⟩, ⟨6, _⟩ => dW_3_6 hu hg hs hx
  | ⟨4, _⟩, ⟨0, _⟩ => (dW_0_4 hu hg hs hx).symm
  | ⟨4, _⟩, ⟨1, _⟩ => (dW_1_4 hu hg hs hx).symm
  | ⟨4, _⟩, ⟨2, _⟩ => (dW_2_4 hu hg hs hx).symm
  | ⟨4, _⟩, ⟨3, _⟩ => (dW_3_4 hu hg hs hx).symm
