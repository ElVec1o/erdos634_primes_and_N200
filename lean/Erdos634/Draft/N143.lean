/-
Draft/N143.lean -- `143` IS a tile count.

`R143TilingBridge.r143_dissection_shape` (kernel-checked certificate `R143Tiling`, coordinates in `ℤ[√3]`): the triangle
with sides `546, 686, 770 = 14 · (39, 49, 55)` is cut into `143` congruent triangles with sides `42, 70, 98 =
14 · (3, 5, 7)`.  The target is the triangle with angles `(2α, 2β, α + β)` of the tile `(3, 5, 7)` (the target `F₂`
of the paper; `α + β = π/3`), and `143 = (a + 2b)(2a + b)` is the least value the area count allows on it.

    theorem tileCount_143 : TileCount 143
    theorem tileCount_143_sq {k : ℕ} (hk : 0 < k) : TileCount (k * k * 143)
    theorem dissection_143_unit : ∃ D : CongruentDissection 143, (target sides 39, 55, 49) ∧ (tile sides 3, 5, 7)
    theorem not_f2Inst143 : ¬ F2Inst143

`F2Inst143` is the hypothesis of `OpenRed.not_tile_143_of` and a field of `Spectrum200Cond.OpenInstances` and of
`Spectrum200Cond2.OpenInstances9`.  It is FALSE, so those three statements are vacuous from now on
(`openInstances_false`, `openInstances9_false`); the statement that replaces them is

    theorem tileCount_iff_le_200_of8 (h : OpenInstances8) {N : ℕ} (h1 : 1 ≤ N) (h200 : N ≤ 200) :
        TileCount N ↔ FamD N = true

with `FamD = FamC ∪ {143}` and eight instances (`132`, `135` twice, `154`, `156`, `161`, `184` twice).
`OpenInstances8` is NOT proved and is not known to hold.

The tiling was found by the float search `rust/mrv2` (order `lex`), snapped to `ℚ(√3)` and verified exactly
(a script, witness `data/witnesses/tiling_143_3_5_7_on_39_49_55.exact.txt`); the Lean
files `R143Tiling`, `R143TilingBridge` are generated by a script.

Composite-N statement; not prime-case work.  No sorry, no native_decide.
-/
import Erdos634.R143TilingBridge
import Erdos634.Draft.Spectrum200Cond2

namespace Erdos634.Draft.N143

open Erdos634.Geometry Erdos634.Draft.TileCountFamilies Erdos634.Draft.OpenRed
open Erdos634.Draft.Spectrum200d Erdos634.Draft.Spectrum200g Erdos634.Draft.Spectrum200Cond
open Erdos634.Draft.Spectrum200Cond2 Erdos634.Draft.IsoInst Erdos634.Draft.GapE120Exc
open Erdos634.Draft.CompositeFinal4 Erdos634.Draft.NSQM Erdos634.Draft.NSQRW Erdos634.Draft.GPairCert

/-- **143 is a tile count.** -/
theorem tileCount_143 : TileCount 143 := Erdos634.R143TilingBridge.r143_nonempty_congruentDissection

/-- **`143 k²` is a tile count for every `k ≥ 1`.** -/
theorem tileCount_143_sq {k : ℕ} (hk : 0 < k) : TileCount (k * k * 143) := tileCount_scale tileCount_143 hk

theorem eq_of_sq {d c : ℝ} (hd : 0 ≤ d) (hc : 0 < c) (h : d ^ 2 = c ^ 2) : d = c := by
  have h2 : (d - c) * (d + c) = 0 := by linear_combination h
  rcases mul_eq_zero.mp h2 with h3 | h3
  · linarith
  · linarith

/-- **The 143-tiling with its side lengths**: the target has sides `546, 686, 770` and the tile `42, 70, 98`. -/
theorem dissection_143_sides :
    ∃ D : CongruentDissection 143,
      dist (D.target.pts 0) (D.target.pts 1) = 546 ∧ dist (D.target.pts 1) (D.target.pts 2) = 686 ∧
      dist (D.target.pts 2) (D.target.pts 0) = 770 ∧
      dist (D.model.pts 0) (D.model.pts 1) = 42 ∧ dist (D.model.pts 1) (D.model.pts 2) = 70 ∧
      dist (D.model.pts 2) (D.model.pts 0) = 98 := by
  obtain ⟨D, t1, t2, t3, m1, m2, m3⟩ := Erdos634.R143TilingBridge.r143_dissection_shape
  exact ⟨D, eq_of_sq dist_nonneg (by norm_num) (by rw [t1]; norm_num),
    eq_of_sq dist_nonneg (by norm_num) (by rw [t2]; norm_num),
    eq_of_sq dist_nonneg (by norm_num) (by rw [t3]; norm_num),
    eq_of_sq dist_nonneg (by norm_num) (by rw [m1]; norm_num),
    eq_of_sq dist_nonneg (by norm_num) (by rw [m2]; norm_num),
    eq_of_sq dist_nonneg (by norm_num) (by rw [m3]; norm_num)⟩

open Erdos634.Realizable in
/-- **The statement at scale one**: a triangle with sides `39, 55, 49` is cut into `143` congruent triangles with
sides `3, 5, 7` (`oppLen k` is the length of the side opposite the vertex `k`). -/
theorem dissection_143_unit :
    ∃ D : CongruentDissection 143,
      D.target.oppLen 2 = 39 ∧ D.target.oppLen 1 = 55 ∧ D.target.oppLen 0 = 49 ∧
      D.model.oppLen 2 = 3 ∧ D.model.oppLen 0 = 5 ∧ D.model.oppLen 1 = 7 := by
  obtain ⟨D, t01, t12, t20, m01, m12, m20⟩ := dissection_143_sides
  have hν : (0:ℝ) < 1 / 14 := by norm_num
  set Ds := scaleDissection (D.model.pts 0) (1 / 14) hν.ne' D with hDs
  have htd : ∀ i j : Fin 3,
      dist (Ds.target.pts i) (Ds.target.pts j) = 1 / 14 * dist (D.target.pts i) (D.target.pts j) := by
    intro i j
    rw [hDs, scaleDissection_target_pts, scaleDissection_target_pts, homothetyEquiv_dist, abs_of_pos hν]
  have hmd : ∀ i j : Fin 3,
      dist (Ds.model.pts i) (Ds.model.pts j) = 1 / 14 * dist (D.model.pts i) (D.model.pts j) := by
    intro i j
    rw [hDs, scaleDissection_model_pts, scaleDissection_model_pts, homothetyEquiv_dist, abs_of_pos hν]
  have e01 := htd 0 1
  have e12 := htd 1 2
  have e20 := htd 2 0
  have f01 := hmd 0 1
  have f12 := hmd 1 2
  have f20 := hmd 2 0
  rw [t01] at e01
  rw [t12] at e12
  rw [t20] at e20
  rw [m01] at f01
  rw [m12] at f12
  rw [m20] at f20
  refine ⟨Ds, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · have : Ds.target.oppLen 2 = dist (Ds.target.pts 0) (Ds.target.pts 1) := rfl
    rw [this, e01]; norm_num
  · have : Ds.target.oppLen 1 = dist (Ds.target.pts 2) (Ds.target.pts 0) := rfl
    rw [this, e20]; norm_num
  · have : Ds.target.oppLen 0 = dist (Ds.target.pts 1) (Ds.target.pts 2) := rfl
    rw [this, e12]; norm_num
  · have : Ds.model.oppLen 2 = dist (Ds.model.pts 0) (Ds.model.pts 1) := rfl
    rw [this, f01]; norm_num
  · have : Ds.model.oppLen 0 = dist (Ds.model.pts 1) (Ds.model.pts 2) := rfl
    rw [this, f12]; norm_num
  · have : Ds.model.oppLen 1 = dist (Ds.model.pts 2) (Ds.model.pts 0) := rfl
    rw [this, f20]; norm_num

/-- the permutation `0 ↦ 2, 1 ↦ 0, 2 ↦ 1` -/
def rot : Equiv.Perm (Fin 3) := (Equiv.swap 0 2).trans (Equiv.swap 0 1)

theorem rot_vals : rot 0 = 2 ∧ rot 1 = 0 ∧ rot 2 = 1 := by decide

theorem swap_vals02 : (Equiv.swap (0 : Fin 3) 2) 0 = 2 ∧ (Equiv.swap (0 : Fin 3) 2) 1 = 1 ∧
    (Equiv.swap (0 : Fin 3) 2) 2 = 0 := by decide

/-- **The hypothesis of `OpenRed.not_tile_143_of` is false**: the triangle `(39, 55, 49)` is tiled by copies of
`(3, 5, 7)`. -/
theorem not_f2Inst143 : ¬ F2Inst143 := by
  intro h
  obtain ⟨D, h2, h1, h0, m2, m0, m1⟩ := dissection_143_unit
  obtain ⟨r0, r1, r2⟩ := rot_vals
  obtain ⟨s0, s1, s2⟩ := swap_vals02
  exact h D ⟨Equiv.swap 0 2, by rw [s0]; exact h2, by rw [s1]; exact h1, by rw [s2]; exact h0⟩
    ⟨rot, by rw [r0]; exact m2, by rw [r1]; exact m0, by rw [r2]; exact m1⟩

/-- `Spectrum200Cond.OpenInstances` cannot hold: `tileCount_iff_le_200_of` is vacuous. -/
theorem openInstances_false : ¬ OpenInstances := fun h => not_f2Inst143 h.i143

/-- `Spectrum200Cond2.OpenInstances9` cannot hold: `tileCount_iff_le_200_of9` is vacuous. -/
theorem openInstances9_false : ¬ OpenInstances9 := fun h => not_f2Inst143 h.i143

/-- the realizable table: the families of `FamC` and the value 143 -/
def FamD (N : ℕ) : Bool := FamC N || N == 143

/-- **The eight instances on which the spectrum up to 200 depends** (tile, then target):
`132`: `(5,3,7)` on `(42,42,66)`; `135`: the pair `(15,27)` and its mirror, `(3,5,7)` on the equilateral triangle of
side `45`; `154`: `(8,7,13)` on `(91,91,154)`; `156`: `(12,7,16)` on `(128,128,234)`; `161`: `(12,7,16)` on
`(112,112,161)`; `184`: `(7,8,13)` on `(104,104,184)` and `(10,21,25)` on `(184,210,250)`. -/
structure OpenInstances8 : Prop where
  i132 : IsoInst 5 3 7 6
  i135 : E120Pair 135 15 27
  i135' : E120Pair 135 27 15
  i154 : IsoInst 8 7 13 7
  i156 : S1Inst 2 3 4
  i161 : S3Inst 1 3 4
  i184 : IsoInst 7 8 13 8
  i184' : S4Inst 2 2 5

/-- **The spectrum up to 200, given the eight open instances**: six values (`132, 135, 154, 156, 161, 184`) depend
on them; `143` is a tile count. -/
theorem tileCount_iff_le_200_of8 (h : OpenInstances8) {N : ℕ} (h1 : 1 ≤ N) (h200 : N ≤ 200) :
    TileCount N ↔ FamD N = true := by
  by_cases h143 : N = 143
  · subst h143
    exact ⟨fun _ => by decide +kernel, fun _ => tileCount_143⟩
  have hD : FamD N = FamC N := by
    have : (N == 143) = false := by simpa using h143
    simp [FamD, this]
  rw [hD]
  by_cases hu : N ∈ undecided200g
  · simp only [undecided200g, List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨fun ⟨D⟩ => (not_tile_132_of h.i132 D).elim, fun hf => absurd hf (by decide +kernel)⟩
    · exact ⟨fun ⟨D⟩ => (Erdos634.Draft.N135.not_tile_135_of h.i135 h.i135' D).elim,
        fun hf => absurd hf (by decide +kernel)⟩
    · exact absurd rfl h143
    · exact ⟨fun ⟨D⟩ => (not_tile_154_of h.i154 D).elim, fun hf => absurd hf (by decide +kernel)⟩
    · exact ⟨fun ⟨D⟩ => (Erdos634.Draft.N156.not_tile_156_of_s1 h.i156 D).elim,
        fun hf => absurd hf (by decide +kernel)⟩
    · exact ⟨fun ⟨D⟩ => (not_tile_161_of h.i161 D).elim, fun hf => absurd hf (by decide +kernel)⟩
    · exact ⟨fun ⟨D⟩ => (not_tile_184_of h.i184 h.i184' D).elim, fun hf => absurd hf (by decide +kernel)⟩
  · exact tileCount_iff_le_200g h1 h200 hu

end Erdos634.Draft.N143

