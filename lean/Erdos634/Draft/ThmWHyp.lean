-- Draft/ThmWHyp.lean — hypotheses bundle `WP` of Theorem W (canonical parameters (t,r,q) of PROOF.md section 5) and the positive atoms
-- used by the generated sign lemmas.  GENERATED by (project working notes)  UNAUDITED.  No sorry.
import Mathlib.Tactic
namespace Erdos634.Draft.ThmW

/-- the eleven sign conditions of the six-piece template (C2..C8, LA, LB, LC of PROOF.md) with positivity of scales -/
structure WP (e f M t r q : ℝ) : Prop where
  he : 0 < e
  hef : e < f
  hM : 0 < M
  ht : 0 < t
  htr : t < r
  hq : 0 < q
  mq : q < M
  c3 : 0 < e * M - f * t
  c4 : 0 < f * r - e * M
  c5 : 0 < f * M - e * r
  c6 : 0 < f * q - e * r
  c7 : 0 < f * t - e * q
  c8 : 0 < f ^ 2 * t - e ^ 2 * r
  la : 0 < (f ^ 2 - e ^ 2) * f * M - e * (2 * f ^ 2 - e ^ 2) * t + f ^ 3 * q
  lb : 0 < (f ^ 2 - e ^ 2) * f * M - e * (2 * f ^ 2 - e ^ 2) * r + f ^ 3 * q
  lc : 0 < e * f * (f ^ 2 - e ^ 2) * M - e ^ 2 * (2 * f ^ 2 - e ^ 2) * r + f ^ 4 * t

theorem WP.hf {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < f := lt_trans h.he h.hef

theorem WP.a_e {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < e := h.he
theorem WP.a_f {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < f := lt_trans h.he h.hef
theorem WP.a_g {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < -e + f := by linarith [h.hef]
theorem WP.a_s {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < e + f := by linarith [h.he, h.hef]
theorem WP.a_M {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < M := h.hM
theorem WP.a_t {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < t := h.ht
theorem WP.a_r {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < r := by linarith [h.ht, h.htr]
theorem WP.a_q {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < q := h.hq
theorem WP.a_d {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < r - t := by linarith [h.htr]
theorem WP.a_mq {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < M - q := by linarith [h.mq]
theorem WP.a_c3 {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < M*e - f*t := by linarith [h.c3]
theorem WP.a_c4 {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < -M*e + f*r := by linarith [h.c4]
theorem WP.a_c5 {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < M*f - e*r := by linarith [h.c5]
theorem WP.a_c6 {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < -e*r + f*q := by linarith [h.c6]
theorem WP.a_c7 {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < -e*q + f*t := by linarith [h.c7]
theorem WP.a_c8 {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < -e^2*r + f^2*t := by linarith [h.c8]
theorem WP.a_la {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < M*f*(-e^2 + f^2) - e*t*(-e^2 + 2*f^2) + f^3*q := by linarith [h.la]
theorem WP.a_lb {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < M*f*(-e^2 + f^2) - e*r*(-e^2 + 2*f^2) + f^3*q := by linarith [h.lb]
theorem WP.a_lc {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < M*e*f*(-e^2 + f^2) - e^2*r*(-e^2 + 2*f^2) + f^4*t := by linarith [h.lc]
theorem WP.a_k {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < -e^2 + 2*f^2 := by nlinarith [mul_pos (WP.a_g h) (WP.a_s h), mul_pos h.he h.he]
theorem WP.a_x1 {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < M*f - e*t := by nlinarith [mul_pos (WP.a_f h) h.c3, mul_pos h.ht (mul_pos (WP.a_g h) (WP.a_s h)), h.he]
theorem WP.a_x2 {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < -e*t + f*q := by nlinarith [h.c6, mul_pos h.he (WP.a_d h)]
theorem WP.a_c9 {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < -e*q + f*r := by nlinarith [mul_pos (WP.a_f h) (WP.a_d h), h.c7]
theorem WP.a_y1 {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < M*(-e^2 + f^2) + e*f*t := by nlinarith [mul_pos (mul_pos (WP.a_g h) (WP.a_s h)) h.hM, mul_pos (mul_pos h.he (WP.a_f h)) h.ht]
theorem WP.a_y2 {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < M*e*f + t*(-e^2 + f^2) := by nlinarith [mul_pos (mul_pos (WP.a_g h) (WP.a_s h)) h.ht, mul_pos (mul_pos h.he (WP.a_f h)) h.hM]
theorem WP.a_y3 {e f M t r q : ℝ} (h : WP e f M t r q) : 0 < e^2*t + r*(-e^2 + f^2) := by nlinarith [mul_pos (mul_pos (WP.a_g h) (WP.a_s h)) (WP.a_r h), mul_pos (mul_pos h.he h.he) h.ht]

end Erdos634.Draft.ThmW
