-- No sorry, no native_decide, no axioms.
-- Control for the NoF2 leaf of GapR8: the F2-shaped tiling of N = 3575 (tile (3,5,7)*(2*49), target ~ nu*(39,55,49), nu = 5;
-- Zhang arXiv:2512.22696 Prop 6(2)).  The certificate is generated by an exact search program and checked in the kernel by
-- G3CCert.Cert.ok assembled from per-cluster facts, see G3NChunk.  It is a `CongruentDissection 3575` meeting every structural premise of the
-- F2 branch of `GapR8` (IrrPi alpha, TwoPiThreeData, F2to4Shape, hence F2Data with nu > 0), and NoF2 3575 is FALSE (x=10, r=45, z=35).
import Erdos634.Draft.G3NF2Cert
import Erdos634.Draft.G3CAng
import Erdos634.Draft.AllNExclusionArith
import Erdos634.Draft.R8F2to4Bridge

open scoped Classical

namespace Erdos634.Draft.G3NF2Control

open Erdos634.Geometry Erdos634.Draft.G3CCert Erdos634.Draft.TheoremPConditional Erdos634.Draft.Chain15
open Erdos634.Draft.G3CAng
open Erdos634.Draft.G3NF2Cert (cert cert_ok cert_len)
open Erdos634.Draft.FluxPaperWitness (cornerAngle_mem')

noncomputable abbrev D := cd cert cert_ok

theorem N_eq : cert.leaves.length = 3575 := cert_len

theorem m_opp0 : D.model.oppLen 0 = 490 := by
  rw [show D.model = _ from cd_model cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.model (0 + 1)) (vtx cert.model (0 + 2)) 490 (by decide)
  rw [this]; norm_num
theorem m_opp1 : D.model.oppLen 1 = 686 := by
  rw [show D.model = _ from cd_model cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.model (1 + 1)) (vtx cert.model (1 + 2)) 686 (by decide)
  rw [this]; norm_num
theorem m_opp2 : D.model.oppLen 2 = 294 := by
  rw [show D.model = _ from cd_model cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.model (2 + 1)) (vtx cert.model (2 + 2)) 294 (by decide)
  rw [this]; norm_num

theorem t_opp0 : D.target.oppLen 0 = 26950 := by
  rw [show D.target = _ from cd_target cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.target (0 + 1)) (vtx cert.target (0 + 2)) 26950 (by decide)
  rw [this]; norm_num
theorem t_opp1 : D.target.oppLen 1 = 24010 := by
  rw [show D.target = _ from cd_target cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.target (1 + 1)) (vtx cert.target (1 + 2)) 24010 (by decide)
  rw [this]; norm_num
theorem t_opp2 : D.target.oppLen 2 = 19110 := by
  rw [show D.target = _ from cd_target cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.target (2 + 1)) (vtx cert.target (2 + 2)) 19110 (by decide)
  rw [this]; norm_num

/-- vertex presentation: sigma sends (a,b,c) = (3,5,7) to the vertices opposite 294, 490, 686, i.e. (2, 0, 1) -/
def σm : Equiv.Perm (Fin 3) := ⟨![2, 0, 1], ![1, 2, 0], by decide, by decide⟩
theorem σm0 : σm 0 = 2 := rfl
theorem σm1 : σm 1 = 0 := rfl
theorem σm2 : σm 2 = 1 := rfl

noncomputable def α : ℝ := D.model.angleAt (σm 0)
noncomputable def β : ℝ := D.model.angleAt (σm 1)

theorem o0 : D.model.oppLen (σm 0) = 98 * 3 := by rw [σm0, m_opp2]; norm_num
theorem o1 : D.model.oppLen (σm 1) = 98 * 5 := by rw [σm1, m_opp0]; norm_num
theorem o2 : D.model.oppLen (σm 2) = 98 * 7 := by rw [σm2, m_opp1]; norm_num

theorem data : D.model.TwoPiThreeData α (98 * 3) (98 * 5) (98 * 7) :=
  tp_data D.model σm 98 3 5 7 (by norm_num) (by norm_num) (by norm_num) (by norm_num) o0 o1 o2

theorem hβ : β = Real.pi / 3 - α :=
  (tp_angles D.model σm 98 3 5 7 (by norm_num) (by norm_num) (by norm_num) (by norm_num) o0 o1 o2).2

theorem cos_α : Real.cos α = 13 / 14 := by
  unfold α
  rw [cos_s0 D.model σm (by rw [o1]; norm_num) (by rw [o2]; norm_num), o0, o1, o2]; norm_num

theorem cos_β : Real.cos β = 11 / 14 := by
  unfold β
  rw [cos_s1 D.model σm (by rw [o0]; norm_num) (by rw [o2]; norm_num), o0, o1, o2]; norm_num

theorem α_irr : IrrPi α :=
  irrPi_of_cos α (13 / 14) (by rw [cos_α]; norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num)

theorem α_nn : 0 ≤ α := (cornerAngle_mem' _ _ _ : 0 ≤ D.model.angleAt (σm 0) ∧ _).1
theorem β_nn : 0 ≤ β := (cornerAngle_mem' _ _ _ : 0 ≤ D.model.angleAt (σm 1) ∧ _).1

theorem lt_half_of_cos_pos {x : ℝ} (hx : x ≤ Real.pi) (hc : 0 < Real.cos x) : x < Real.pi / 2 := by
  by_contra h
  push Not at h
  have := Real.cos_nonpos_of_pi_div_two_le_of_le h (by linarith [hx, Real.pi_pos])
  linarith

theorem α_lt : α < Real.pi / 2 :=
  lt_half_of_cos_pos (cornerAngle_mem' _ _ _ : _ ∧ D.model.angleAt (σm 0) ≤ Real.pi).2 (by rw [cos_α]; norm_num)
theorem β_lt : β < Real.pi / 2 :=
  lt_half_of_cos_pos (cornerAngle_mem' _ _ _ : _ ∧ D.model.angleAt (σm 1) ≤ Real.pi).2 (by rw [cos_β]; norm_num)

/-- target cosines: vertex 2 ~ 2α, vertex 0 ~ 2β, vertex 1 ~ π/3 -/
theorem t_cos2 : Real.cos (D.target.angleAt 2) = 71 / 98 := by
  have := cos_s2 D.target 1 (by simp [t_opp0]) (by simp [t_opp1])
  simp only [Equiv.Perm.coe_one, id_eq] at this
  rw [this, t_opp0, t_opp1, t_opp2]; norm_num
theorem t_cos0 : Real.cos (D.target.angleAt 0) = 23 / 98 := by
  have := cos_s0 D.target 1 (by simp [t_opp1]) (by simp [t_opp2])
  simp only [Equiv.Perm.coe_one, id_eq] at this
  rw [this, t_opp0, t_opp1, t_opp2]; norm_num
theorem t_cos1 : Real.cos (D.target.angleAt 1) = 1 / 2 := by
  have := cos_s1 D.target 1 (by simp [t_opp0]) (by simp [t_opp2])
  simp only [Equiv.Perm.coe_one, id_eq] at this
  rw [this, t_opp0, t_opp1, t_opp2]; norm_num

theorem t_ang2 : D.target.angleAt 2 = 2 * α := by
  have hc : Real.cos (2 * α) = 71 / 98 := by rw [Real.cos_two_mul, cos_α]; norm_num
  have := α_lt; have := α_nn
  exact Real.injOn_cos (cornerAngle_mem' _ _ _) ⟨by linarith, by linarith⟩ (t_cos2.trans hc.symm)

theorem t_ang0 : D.target.angleAt 0 = 2 * (Real.pi / 3 - α) := by
  have hc : Real.cos (2 * β) = 23 / 98 := by rw [Real.cos_two_mul, cos_β]; norm_num
  have := β_lt; have := β_nn
  rw [← hβ]
  exact Real.injOn_cos (cornerAngle_mem' _ _ _) ⟨by linarith, by linarith⟩ (t_cos0.trans hc.symm)

theorem t_ang1 : D.target.angleAt 1 = Real.pi / 3 := by
  have hc : Real.cos (Real.pi / 3) = 1 / 2 := Real.cos_pi_div_three
  have hpi := Real.pi_pos
  exact Real.injOn_cos (cornerAngle_mem' _ _ _) ⟨by positivity, by linarith⟩ (t_cos1.trans hc.symm)

theorem f2_tgt : TgtAngles D (2 * α) (2 * (Real.pi / 3 - α)) (α + (Real.pi / 3 - α)) := by
  refine ⟨σm, ?_, ?_, ?_⟩
  · rw [σm0]; exact t_ang2
  · rw [σm1]; exact t_ang0
  · rw [σm2, t_ang1]; ring

/-- **F2 shape**: the target of the real 3575-tiling has angles `(2α, 2β, π/3)`, `β = π/3 − α`. -/
theorem f2_shape : F2to4Shape D α := Or.inl f2_tgt

/-- every non-arithmetic premise of the F2 branch of `GapR8` holds on the real 3575-tiling -/
theorem premises : IrrPi α ∧ D.model.TwoPiThreeData α (98 * 3) (98 * 5) (98 * 7) ∧ F2to4Shape D α :=
  ⟨α_irr, data, f2_shape⟩

/-- … hence also the premises of `F2.f2_prime_contradiction` (F2Data with nu > 0, a, b > 0). -/
theorem f2_leaf_premises :
    IrrPi α ∧ D.model.TwoPiThreeData α (98 * 3) (98 * 5) (98 * 7) ∧ (0 : ℝ) < 98 * 3 ∧ (0 : ℝ) < 98 * 5 ∧
      ∃ ν > 0, D.target.F2Data α (98 * 3) (98 * 5) (98 * 7) ν :=
  ⟨α_irr, data, by norm_num, by norm_num, Erdos634.Draft.R8F2to4Bridge.f2_data_of_shape D data f2_tgt⟩

/-! ### the leaf: GapR8 is refuted at 3575 and its NoF2 hypothesis is false there -/

theorem not_gapR8_3575 : ¬ GapR8 3575 := by
  intro g
  have h : cert.leaves.length = 3575 := cert_len
  rw [← h] at g
  exact g D α _ _ _ α_irr data f2_shape

/-- the NoF2 hypothesis of the F2 leaf is FALSE at 3575: x = 10, r = 45, z = 35 (N = 55*65 = 3*35^2 - 10^2) -/
theorem not_noF2_3575 : ¬ Erdos634.Draft.R8Gen2.NoF2 3575 := by
  intro h
  exact h.2 10 (by norm_num) 45 (by norm_num) (by norm_num) 35 (by norm_num)

theorem not_noF2Chk_3575 : ¬ Erdos634.Draft.AllNExclusion.NoF2Chk 3575 := fun h =>
  not_noF2_3575 (Erdos634.Draft.AllNExclusion.noF2_of_chk h)

/-- consequently the three arithmetic leaves of `gapR8_of_arith2` cannot all hold at 3575. -/
theorem not_all_r8_3575 :
    ¬ (Erdos634.Draft.R8Gen2.NoF2 3575 ∧ Erdos634.Draft.R8Gen2.NoF3 3575 ∧ Erdos634.Draft.R8Gen2.NoF4z 3575) :=
  fun ⟨a, b, c⟩ => not_gapR8_3575 (Erdos634.Draft.R8Gen2.gapR8_of_arith2 3575 a b c)

/-- non-vacuity of the F2 leaf in one statement: a real dissection with all structural premises exists at N = 3575 and the
arithmetic hypothesis `NoF2` fails there (so `f2_prime_contradiction` is not applicable, as it must not be). -/
theorem f2_leaf_witness :
    (∃ (N : ℕ) (D : CongruentDissection N) (α a b c : ℝ), IrrPi α ∧ D.model.TwoPiThreeData α a b c ∧
      F2to4Shape D α ∧ 0 < a ∧ 0 < b ∧ N = 3575) ∧ ¬ Erdos634.Draft.R8Gen2.NoF2 3575 :=
  ⟨⟨_, D, α, _, _, _, α_irr, data, f2_shape, by norm_num, by norm_num, cert_len⟩, not_noF2_3575⟩

end Erdos634.Draft.G3NF2Control

#print axioms Erdos634.Draft.G3NF2Control.premises
#print axioms Erdos634.Draft.G3NF2Control.f2_leaf_premises
#print axioms Erdos634.Draft.G3NF2Control.not_gapR8_3575
#print axioms Erdos634.Draft.G3NF2Control.not_noF2_3575
#print axioms Erdos634.Draft.G3NF2Control.not_noF2Chk_3575
#print axioms Erdos634.Draft.G3NF2Control.not_all_r8_3575
#print axioms Erdos634.Draft.G3NF2Control.f2_leaf_witness
