  exact key _ hsum D hDm hDt


theorem lt_of_thin (e f b : ℕ) (hb : f * f = e * e + b) (hq : e * f < b) : e < f := by
  by_contra hh
  push_neg at hh
  nlinarith [Nat.mul_le_mul hh hh]

/-- **Base case, all thin rows.**  For `f*f = e*e + b` with `e f < b` (thin row, `e ≥ 1`), the target `T_2` of the row is tiled by `4 N0` tiles,
`N0 = b (b + f f)`, by the six-piece layout, in the frame `φ = f/e`. -/
theorem g2_base (e f b : ℕ) (he : 0 < e) (hb : f * f = e * e + b) (hq : e * f < b) {φ : ℝ} (hφ : 1 < φ) (hφE : φ = (f : ℝ) / e) :
    Nonempty (RTiling (TG φ (e : ℝ) (f : ℝ) ((2 : ℕ) : ℝ)) (Mrow hφ e f he (lt_of_thin e f b hb hq)) ((b * (b + f * f)) * 2 * 2)) := by
  have hef : e < f := lt_of_thin e f b hb hq
  have hbR : (b : ℝ) = (f : ℝ) ^ 2 - (e : ℝ) ^ 2 := by
    have : ((f * f : ℕ) : ℝ) = ((e * e + b : ℕ) : ℝ) := by rw [hb]
    push_cast at this; nlinarith
  have hER : (0 : ℝ) < e := by exact_mod_cast he
  have hEFR : (e : ℝ) < f := by exact_mod_cast hef
  have hqR : (e : ℝ) * f + (e : ℝ) ^ 2 < (f : ℝ) ^ 2 := by
    have : ((e * f : ℕ) : ℝ) < (b : ℝ) := by exact_mod_cast hq
    push_cast at this; nlinarith
  have h := g2f_of hER hEFR hqR
  have h1 : e * f ≤ b := hq.le
  have h2 : f * f ≤ 2 * b := by
    have : ((f * f : ℕ) : ℝ) ≤ ((2 * b : ℕ) : ℝ) := by
      push_cast; rw [hbR]; nlinarith [hqR, mul_pos hER (sub_pos.mpr hEFR)]
    exact_mod_cast this
  have h3 : e * f ≤ 2 * b := by linarith
  have core := g2_seed_core h hφ hφE (2 * b) (2 * b - f * f) (f * f) (2 * b - e * f) (e * f) b (b - e * f) b (b - e * f) (b * (b + f * f))
    (by push_cast; rw [hbR])
    (by rw [Nat.cast_sub h2]; push_cast; rw [hbR]; ring)
    (by push_cast; ring)
    (by rw [Nat.cast_sub h3]; push_cast; rw [hbR])
    (by push_cast; ring)
    hbR
    (by rw [Nat.cast_sub h1, hbR]; push_cast; ring)
    hbR
    (by rw [Nat.cast_sub h1, hbR]; push_cast; ring)
    (Nat.sub_le _ _) (Nat.sub_le _ _) (Nat.sub_le _ _)
    (by push_cast; rw [hbR]; ring)
  have h2' : ((2 : ℕ) : ℝ) = 2 := by norm_num
  rw [h2']
  exact core

/-- **G2 for every thin row, parametrically.**  For naturals `e ≥ 1`, `f`, `b` with `f² = e² + b` and `e f < b`
(i.e. `f² − e f − e² ≥ 1`), `b (b + f²) g²` is a tile count for every `g ≥ 2`. -/
theorem tileCount_g2_param (e f b : ℕ) (he : 0 < e) (hb : f * f = e * e + b) (hq : e * f < b) (g : ℕ) (hg : 2 ≤ g) :
    TileCount (b * (b + f * f) * g * g) := by
  have hef : e < f := lt_of_thin e f b hb hq
  have hER : (0 : ℝ) < e := by exact_mod_cast he
  have hEFR : (e : ℝ) < f := by exact_mod_cast hef
  have hφ : 1 < (f : ℝ) / e := by rw [lt_div_iff₀ hER]; linarith
  obtain ⟨R⟩ := up_rtiling hφ e f b (b * (b + f * f)) 2 he hef hb hq.le rfl rfl (by norm_num) (g2_base e f b he hb hq hφ rfl) g hg
  exact tileCount_of_rtiling hφ hER hEFR (by exact_mod_cast (show 0 < g by omega)) R


/-- **G2, statement in the original variables.**  If `e ≥ 1` and `e f + e² < f²` (thin row), then `(f²−e²)(2f²−e²) g²` is a tile count for every `g ≥ 2`. -/
theorem tileCount_g2_thin (e f : ℕ) (he : 0 < e) (hq : e * f + e * e < f * f) (g : ℕ) (hg : 2 ≤ g) :
    TileCount ((f * f - e * e) * ((f * f - e * e) + f * f) * g * g) := by
  have hee : e * e ≤ f * f := by nlinarith [Nat.zero_le (e * f)]
  exact tileCount_g2_param e f (f * f - e * e) he (Nat.add_sub_cancel' hee).symm (Nat.lt_sub_of_add_lt hq) g hg

