theorem g2f_of {E F : ℝ} (hE : 0 < E) (hEF : E < F) (hq : E * F + E ^ 2 < F ^ 2) : G2F E F := by
  have hF : 0 < F := by linarith
  have hq' : 0 < F ^ 2 - E * F - E ^ 2 := by linarith
  have hFE : 0 < F - E := by linarith
  have hEF' : 0 < E * F := mul_pos hE hF
  exact ⟨hE, hF, hEF, hq,
    (by linarith),
    (by linarith),
    (by
    have h1 := mul_pos hq' (show 0 < F ^ 2 + 2 * E * F by positivity)
    have h2 := mul_pos (pow_pos hE 3) (show 0 < E + F by linarith)
    nlinarith [h1, h2]),
    (by nlinarith [hq', hEF']),
    (by nlinarith [hq', hEF', mul_pos hE hE]),
    (by nlinarith [hq', hEF']),
    (by linarith [hq']),
    (by nlinarith [hq', mul_pos hE hFE]),
    (by nlinarith [hq', hEF', mul_pos hE hE]),
    (by linarith),
    (by nlinarith [hq', hEF']),
    (by linarith)⟩

