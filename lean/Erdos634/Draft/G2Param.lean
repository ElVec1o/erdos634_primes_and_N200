  have dd_35 : Disjoint (interior (Phi φ '' Preg (g2g1 E F) (g2g2 E F) (g2g4 E F) (((0:ℕ):ℝ)/(k3:ℝ)))) (interior (Phi φ '' Preg (g2g12 E F) (g2g11 E F) (g2g2 E F) ((sp5:ℝ)/(k5:ℝ)))) :=
