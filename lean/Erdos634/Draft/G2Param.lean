  have sepA_45 : ∀ p ∈ Preg (g2g10 E F) (g2g1 E F) (g2g2 E F) ((sp4:ℝ)/(k4:ℝ)), (0) * p.1 + (-1) * p.2 ≤ (E^3*F - E*F^3) :=
    preg_le4 _ _ _ (g2g9 E F) (g2g11 E F) _ _ _ _ hs0_R4 hs1_R4 eq_R4.1 eq_R4.2.1 eq_R4.2.2.1 eq_R4.2.2.2 (sfS_45A_g9 h) (sfS_45A_g11 h) (sfS_45A_g1 h) (sfS_45A_g2 h)
  have sepB_45 : ∀ p ∈ Preg (g2g12 E F) (g2g11 E F) (g2g2 E F) ((sp5:ℝ)/(k5:ℝ)), (E^3*F - E*F^3) ≤ (0) * p.1 + (-1) * p.2 :=
    preg_ge4 _ _ _ (g2g8 E F) (g2g6 E F) _ _ _ _ hs0_R5 hs1_R5 eq_R5.1 eq_R5.2.1 eq_R5.2.2.1 eq_R5.2.2.2 (sfS_45B_g8 h) (sfS_45B_g6 h) (sfS_45B_g11 h) (sfS_45B_g2 h)
  have dd_45 : Disjoint (interior (Phi φ '' Preg (g2g10 E F) (g2g1 E F) (g2g2 E F) ((sp4:ℝ)/(k4:ℝ)))) (interior (Phi φ '' Preg (g2g12 E F) (g2g11 E F) (g2g2 E F) ((sp5:ℝ)/(k5:ℝ)))) :=
    (disjoint_image hφ (interior_disj_snd (-E^3*F + E*F^3) (fun p hp => by have := sepB_45 p hp; linarith) (fun p hp => by have := sepA_45 p hp; linarith))).symm
  let S6 : Fin 6 → Set Plane := ![Phi φ '' Preg (g2g3 E F) (g2g1 E F) (g2g0 E F) ((sp0:ℝ)/(k0:ℝ)),
    Phi φ '' Preg (g2g5 E F) (g2g2 E F) (g2g6 E F) (((0:ℕ):ℝ)/(k1:ℝ)),
    Phi φ '' Preg (g2g7 E F) (g2g8 E F) (g2g9 E F) (((0:ℕ):ℝ)/(k2:ℝ)),
    Phi φ '' Preg (g2g1 E F) (g2g2 E F) (g2g4 E F) (((0:ℕ):ℝ)/(k3:ℝ)),
    Phi φ '' Preg (g2g10 E F) (g2g1 E F) (g2g2 E F) ((sp4:ℝ)/(k4:ℝ)),
    Phi φ '' Preg (g2g12 E F) (g2g11 E F) (g2g2 E F) ((sp5:ℝ)/(k5:ℝ))]
  let n6 : Fin 6 → ℕ := ![k0 * k0 - sp0 * sp0, k1 * k1 - 0 * 0, k2 * k2 - 0 * 0, k3 * k3 - 0 * 0, k4 * k4 - sp4 * sp4, k5 * k5 - sp5 * sp5]
  let Rf : ∀ a : Fin 6, TFam (S6 a) Mdl (n6 a) := fun a => match a with
    | ⟨0, _⟩ => fam_R0
    | ⟨1, _⟩ => fam_R1
    | ⟨2, _⟩ => fam_R2
    | ⟨3, _⟩ => fam_R3
    | ⟨4, _⟩ => fam_R4
    | ⟨5, _⟩ => fam_R5
    | ⟨k + 6, h⟩ => absurd h (by omega)
  have hSd : ∀ a b : Fin 6, a ≠ b → Disjoint (interior (S6 a)) (interior (S6 b)) := by
    intro a b hab
    fin_cases a <;> fin_cases b <;>
      first
        | exact absurd rfl hab
        | exact dd_01 | exact dd_01.symm | exact dd_02 | exact dd_02.symm | exact dd_03 | exact dd_03.symm | exact dd_04 | exact dd_04.symm | exact dd_05 | exact dd_05.symm | exact dd_12 | exact dd_12.symm | exact dd_13 | exact dd_13.symm | exact dd_14 | exact dd_14.symm | exact dd_15 | exact dd_15.symm | exact dd_23 | exact dd_23.symm | exact dd_24 | exact dd_24.symm | exact dd_25 | exact dd_25.symm | exact dd_34 | exact dd_34.symm | exact dd_35 | exact dd_35.symm | exact dd_45 | exact dd_45.symm
  have hg0 : (0 : ℝ) < 2 := by norm_num
  have hba : E * F ≤ F ^ 2 - E ^ 2 := by linarith [h.hq0]
  have hB0 : 0 < pB0 E F := by unfold pB0; exact mul_pos hb (add_pos hb hc)
  have hdetT : ((pB0 E F * 2, (0 : ℝ)).1 - ((0 : ℝ), (0 : ℝ)).1) *
      (((F^2-E^2)^2 * 2, E*F*(F^2-E^2) * 2).2 - ((0 : ℝ), (0 : ℝ)).2) -
      (((F^2-E^2)^2 * 2, E*F*(F^2-E^2) * 2).1 - ((0 : ℝ), (0 : ℝ)).1) *
      ((pB0 E F * 2, (0 : ℝ)).2 - ((0 : ℝ), (0 : ℝ)).2) ≠ 0 := by
    have : ((pB0 E F * 2, (0 : ℝ)).1 - ((0 : ℝ), (0 : ℝ)).1) *
      (((F^2-E^2)^2 * 2, E*F*(F^2-E^2) * 2).2 - ((0 : ℝ), (0 : ℝ)).2) -
      (((F^2-E^2)^2 * 2, E*F*(F^2-E^2) * 2).1 - ((0 : ℝ), (0 : ℝ)).1) *
      ((pB0 E F * 2, (0 : ℝ)).2 - ((0 : ℝ), (0 : ℝ)).2) = pB0 E F * 2 * (E*F*(F^2-E^2) * 2) := by
      simp only []; ring
    rw [this]
    exact (mul_pos (mul_pos hB0 hg0) (mul_pos (mul_pos ha hb) hg0)).ne'
  let tgt : Tri := triC φ hφ ((0 : ℝ), (0 : ℝ)) (pB0 E F * 2, 0)
    ((F^2-E^2)^2 * 2, E*F*(F^2-E^2) * 2) hdetT
  have tgt_car : tgt.carrier = TG φ E F 2 := carrier_triC _ _ _ _ _ _
  have hsub : ∀ a : Fin 6, S6 a ⊆ tgt.carrier := by
    intro a
    rw [tgt_car]
    fin_cases a
    · exact Set.image_mono (fun p hp => inT_mem E F 2 h.hE h.hEF hg0 hba (inR_R0 p hp))
    · exact Set.image_mono (fun p hp => inT_mem E F 2 h.hE h.hEF hg0 hba (inR_R1 p hp))
    · exact Set.image_mono (fun p hp => inT_mem E F 2 h.hE h.hEF hg0 hba (inR_R2 p hp))
    · exact Set.image_mono (fun p hp => inT_mem E F 2 h.hE h.hEF hg0 hba (inR_R3 p hp))
    · exact Set.image_mono (fun p hp => inT_mem E F 2 h.hE h.hEF hg0 hba (inR_R4 p hp))
    · exact Set.image_mono (fun p hp => inT_mem E F 2 h.hE h.hEF hg0 hba (inR_R5 p hp))
  have hsum : (∑ a, n6 a) = N0 * 2 * 2 := by
    have h0 : sp0 * sp0 ≤ k0 * k0 := Nat.mul_self_le_mul_self hsp0le
    have h4 : sp4 * sp4 ≤ k4 * k4 := Nat.mul_self_le_mul_self hsp4le
    have h5 : sp5 * sp5 ≤ k5 * k5 := Nat.mul_self_le_mul_self hsp5le
    have e : (∑ a, n6 a) = (k0 * k0 - sp0 * sp0) + k1 * k1 + k2 * k2 + k3 * k3 + (k4 * k4 - sp4 * sp4) + (k5 * k5 - sp5 * sp5) := by
      rw [Fin.sum_univ_six]
      show k0 * k0 - sp0 * sp0 + (k1 * k1 - 0 * 0) + (k2 * k2 - 0 * 0) + (k3 * k3 - 0 * 0) + (k4 * k4 - sp4 * sp4) + (k5 * k5 - sp5 * sp5) = _
      simp
    rw [e]
    apply Nat.cast_injective (R := ℝ)
    push_cast [Nat.cast_sub h0, Nat.cast_sub h4, Nat.cast_sub h5]
    rw [hk0, hsp0, hk1, hk2, hk3, hk4, hsp4, hk5, hsp5, hN0]
    ring
  have hvol : ((∑ a, n6 a : ℕ) : ENNReal) * volume Mdl.carrier = volume tgt.carrier := by
    have hs := sD_pos hφ
    have hφ0 : 0 < φ := by linarith
    have hM : volume Mdl.carrier = ENNReal.ofReal (sD φ / (2 * φ) * ((F ^ 2 - E ^ 2) * (E * F)))
