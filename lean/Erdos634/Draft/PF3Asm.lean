  intro i
  rw [carrier_tgtT H]
  exact match i with
    | ⟨0, _⟩ => Set.image_mono (sub_T1 H)
    | ⟨1, _⟩ => Set.image_mono (sub_T2 H)
    | ⟨2, _⟩ => Set.image_mono (sub_T3 H)
    | ⟨3, _⟩ => Set.image_mono (sub_G1 H)
    | ⟨4, _⟩ => Set.image_mono (sub_G2a H)
    | ⟨5, _⟩ => Set.image_mono (sub_G2b H)
