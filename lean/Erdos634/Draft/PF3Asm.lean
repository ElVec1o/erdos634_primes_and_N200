noncomputable def regionOf (nd ny nt nA nB ns : ℕ) : Fin 9 → Set Plane := fun i => match i with
  | ⟨0, _⟩ => Phi 1 '' RegT1 (nd:ℝ) ny nt nA nB ns
  | ⟨1, _⟩ => Phi 1 '' RegT2 (nd:ℝ) ny nt nA nB ns
  | ⟨2, _⟩ => Phi 1 '' RegT3 (nd:ℝ) ny nt nA nB ns
  | ⟨3, _⟩ => Phi 1 '' RegG1 (nd:ℝ) ny nt nA nB ns
  | ⟨4, _⟩ => Phi 1 '' RegG2a (nd:ℝ) ny nt nA nB ns
  | ⟨5, _⟩ => Phi 1 '' RegG2b (nd:ℝ) ny nt nA nB ns
  | ⟨6, _⟩ => Phi 1 '' RegG3a (nd:ℝ) ny nt nA nB ns
  | ⟨7, _⟩ => Phi 1 '' RegG3b (nd:ℝ) ny nt nA nB ns
  | ⟨8, _⟩ => Phi 1 '' RegG3c (nd:ℝ) ny nt nA nB ns
  | ⟨k + 9, h⟩ => absurd h (by omega)

def cntN (nd ny nt nA nB ns : ℕ) : ℕ → ℕ
  | 0 => (3 * nd + 2 * ny + nt) * (3 * nd + 2 * ny + nt)
  | 1 => (3 * nd + 2 * ny + nt) * (3 * nd + 2 * ny + nt)
  | 2 => (3 * nd + 2 * ny + nt) * (3 * nd + 2 * ny + nt)
  | 3 => (4 * nd + 2 * ny + nt) * (4 * nd + 2 * ny + nt)
  | 4 => 2 * (2 * nd + ny) * (2 * nd + ny)
  | 5 => (2 * nd + ny) * (2 * nd + ny)
  | 6 => 2 * (2 * nd + ny) * (2 * nd + ny)
  | 7 => 2 * (nt) * (nA)
  | 8 => (nt) * (nt)
  | _ => 0

def cnt (nd ny nt nA nB ns : ℕ) (i : Fin 9) : ℕ := cntN nd ny nt nA nB ns i.val

