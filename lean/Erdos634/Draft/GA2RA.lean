/-
GA2R-A: the sine table (T) for the n = 30, 60 area kill of GapA2 (N = 15).
`SL60 u <= 2^32 * sin (u*pi/60) <= SH60 u` for 0 <= u <= 60 (the n = 30 table is `u |-> 2u`).
Method: Mathlib's `Real.hasSum_sin` + `alternating_series_error_bound` (12 terms, error x^25/25!), sin monotone to pass
to rational points xl <= x <= xh (pi from `Real.pi_gt_d20`, `Real.pi_lt_d20`), then a Rat comparison by `decide +kernel`.
Data: generated by an exact program (bits = 32); checked by the kernel.  No sorry / native_decide.
-/
import Mathlib

namespace Erdos634.GA2R

open Finset

def SL60 : List ℕ := [0, 224781220, 448946331, 671880911, 892973912, 1111619334, 1327217884, 1539178623, 1746920580, 1949874349, 2147483647, 2339206843, 2524518435, 2702910498, 2873894071, 3037000499, 3191782721, 3337816488, 3474701532, 3602062661, 3719550786, 3826843881, 3923647863, 4009697399, 4084756634, 4148619834, 4201111955, 4242089121, 4271439015, 4289081192, 4294967295, 4289081192, 4271439015, 4242089121, 4201111955, 4148619834, 4084756634, 4009697399, 3923647863, 3826843881, 3719550786, 3602062661, 3474701532, 3337816488, 3191782721, 3037000499, 2873894071, 2702910498, 2524518435, 2339206843, 2147483647, 1949874349, 1746920580, 1539178623, 1327217884, 1111619334, 892973912, 671880911, 448946331, 224781220, 0]

def SH60 : List ℕ := [1, 224781221, 448946332, 671880912, 892973913, 1111619335, 1327217885, 1539178624, 1746920581, 1949874350, 2147483649, 2339206844, 2524518436, 2702910499, 2873894072, 3037000500, 3191782722, 3337816489, 3474701533, 3602062662, 3719550787, 3826843882, 3923647864, 4009697400, 4084756635, 4148619835, 4201111956, 4242089122, 4271439016, 4289081193, 4294967297, 4289081193, 4271439016, 4242089122, 4201111956, 4148619835, 4084756635, 4009697400, 3923647864, 3826843882, 3719550787, 3602062662, 3474701533, 3337816489, 3191782722, 3037000500, 2873894072, 2702910499, 2524518436, 2339206844, 2147483649, 1949874350, 1746920581, 1539178624, 1327217885, 1111619335, 892973913, 671880912, 448946332, 224781221, 1]

/-- 12-term Taylor polynomial of sin over ℚ / ℝ -/
def polyQ (q : ℚ) : ℚ := ∑ i ∈ range 12, (-1) ^ i * (q ^ (2 * i + 1) / ((2 * i + 1).factorial : ℚ))
noncomputable def polyR (x : ℝ) : ℝ := ∑ i ∈ range 12, (-1) ^ i * (x ^ (2 * i + 1) / ((2 * i + 1).factorial : ℝ))

theorem polyR_cast (q : ℚ) : polyR (q : ℝ) = (polyQ q : ℝ) := by
  unfold polyR polyQ; push_cast; rfl

theorem sin_poly_bound (x : ℝ) (h0 : 0 ≤ x) (h2 : x ≤ 2) :
    |Real.sin x - polyR x| ≤ x ^ 25 / ((25).factorial : ℝ) := by
  set f : ℕ → ℝ := fun i => x ^ (2 * i + 1) / ((2 * i + 1).factorial : ℝ) with hf
  have hfa : Antitone f := by
    refine antitone_nat_of_succ_le (fun i => ?_)
    simp only [hf]
    have hfac : ((2 * (i + 1) + 1).factorial : ℝ) = ((2 * i + 1).factorial : ℝ) * ((2 * i + 2) * (2 * i + 3)) := by
      rw [show 2 * (i + 1) + 1 = (2 * i + 1) + 1 + 1 by ring, Nat.factorial_succ, Nat.factorial_succ]
      push_cast; ring
    have hpos : (0 : ℝ) < ((2 * i + 1).factorial : ℝ) := by exact_mod_cast Nat.factorial_pos _
    rw [hfac, div_le_div_iff₀ (by positivity) hpos]
    have hx2 : x ^ 2 ≤ (2 * i + 2) * (2 * i + 3) := by
      have : (0 : ℝ) ≤ i := Nat.cast_nonneg i
      nlinarith
    have : x ^ (2 * (i + 1) + 1) = x ^ (2 * i + 1) * x ^ 2 := by ring
    rw [this]
    have hp : 0 ≤ x ^ (2 * i + 1) := by positivity
    nlinarith [mul_le_mul_of_nonneg_left hx2 (mul_nonneg hp hpos.le)]
  have hfs : Summable f := by
    have := (Real.hasSum_sinh x).summable
    simpa [hf] using this
  have hsin : Real.sin x = ∑' i : ℕ, (-1) ^ i * f i := by
    rw [Real.sin_eq_tsum]; congr 1; ext i; simp only [hf]; ring
  have := alternating_series_error_bound f hfa hfs 12
  rw [← hsin] at this
  simpa [polyR, hf] using this

def pl : ℚ := 314159265358979323846 / 10 ^ 20
def ph : ℚ := 314159265358979323847 / 10 ^ 20

theorem pl_lt : (pl : ℝ) < Real.pi := by
  have := Real.pi_gt_d20; unfold pl; push_cast; norm_num at this ⊢; linarith
theorem lt_ph : Real.pi < (ph : ℝ) := by
  have := Real.pi_lt_d20; unfold ph; push_cast; norm_num at this ⊢; linarith

/-- the checkable table condition at one index `1 <= u <= 29` -/
def tabCond (u sl sh : ℕ) : Bool :=
  decide ((sl : ℚ) / 2 ^ 32 ≤ polyQ (u * pl / 60) - (u * pl / 60) ^ 25 / ((25).factorial : ℚ)) &&
  decide (polyQ (u * ph / 60) + (u * ph / 60) ^ 25 / ((25).factorial : ℚ) ≤ (sh : ℚ) / 2 ^ 32)

theorem sin_enc (u sl sh : ℕ) (hu1 : 1 ≤ u) (hu : u ≤ 29) (h : tabCond u sl sh = true) :
    (sl : ℝ) ≤ 2 ^ 32 * Real.sin (u * Real.pi / 60) ∧ 2 ^ 32 * Real.sin (u * Real.pi / 60) ≤ sh := by
  unfold tabCond at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨hl, hh⟩ := h
  have hu' : (u : ℝ) ≤ 29 := by exact_mod_cast hu
  have hu0 : (0 : ℝ) ≤ u := Nat.cast_nonneg u
  have hpl := pl_lt; have hph := lt_ph
  have hpl0 : (0 : ℝ) < pl := by unfold pl; push_cast; norm_num
  have hphq : (ph : ℝ) < 3.2 := by unfold ph; push_cast; norm_num
  have hpi2 : Real.pi < 3.2 := by linarith
  set x : ℝ := u * Real.pi / 60 with hx
  set xl : ℚ := u * pl / 60 with hxl
  set xh : ℚ := u * ph / 60 with hxh
  have hph0 : (0 : ℝ) ≤ ph := by linarith [Real.pi_pos]
  have hxl' : (xl : ℝ) = u * (pl : ℝ) / 60 := by simp [hxl]
  have hxh' : (xh : ℝ) = u * (ph : ℝ) / 60 := by simp [hxh]
  have hxl_le : (xl : ℝ) ≤ x := by rw [hxl', hx]; gcongr
  have hx_le : x ≤ (xh : ℝ) := by rw [hxh', hx]; gcongr
  have hxl0 : (0 : ℝ) ≤ xl := by rw [hxl']; positivity
  have hxl2 : (xl : ℝ) ≤ 2 := by rw [hxl']; nlinarith
  have hxh2 : (xh : ℝ) ≤ 2 := by rw [hxh']; nlinarith
  have hxhp : (xh : ℝ) ≤ Real.pi / 2 := by
    rw [hxh']
    have : (u : ℝ) * ph / 60 ≤ 29 * ph / 60 := by gcongr
    have h29 : (29 : ℝ) * ph / 60 ≤ Real.pi / 2 := by
      have := Real.pi_gt_d20
      have hph' : (ph : ℝ) = 3.14159265358979323847 := by unfold ph; push_cast; norm_num
      rw [hph']; norm_num at this ⊢; linarith
    linarith
  have hxp : x ≤ Real.pi / 2 := le_trans hx_le hxhp
  have hpi : -(Real.pi / 2) ≤ (xl : ℝ) := by linarith [Real.pi_pos]
  have s1 : Real.sin xl ≤ Real.sin x := Real.sin_le_sin_of_le_of_le_pi_div_two hpi hxp hxl_le
  have s2 : Real.sin x ≤ Real.sin xh :=
    Real.sin_le_sin_of_le_of_le_pi_div_two (by linarith [Real.pi_pos, hxl_le, hxl0]) hxhp hx_le
  have b1 := sin_poly_bound xl hxl0 hxl2
  have b2 := sin_poly_bound xh (le_trans hxl0 (le_trans hxl_le hx_le)) hxh2
  rw [polyR_cast] at b1 b2
  have c1 : (sl : ℝ) / 2 ^ 32 ≤ (polyQ xl : ℝ) - (xl : ℝ) ^ 25 / ((25).factorial : ℝ) := by
    have := (Rat.cast_le (K := ℝ)).mpr hl
    push_cast at this; exact this
  have c2 : (polyQ xh : ℝ) + (xh : ℝ) ^ 25 / ((25).factorial : ℝ) ≤ (sh : ℝ) / 2 ^ 32 := by
    have := (Rat.cast_le (K := ℝ)).mpr hh
    push_cast at this; exact this
  have l1 := (abs_le.mp b1).1
  have u2 := (abs_le.mp b2).2
  constructor
  · have : (sl : ℝ) / 2 ^ 32 ≤ Real.sin x := by linarith
    rw [div_le_iff₀ (by positivity)] at this; linarith
  · have : Real.sin x ≤ (sh : ℝ) / 2 ^ 32 := by linarith
    rw [le_div_iff₀ (by positivity)] at this; linarith

/-- all checks at once -/
def tabAll : Bool := (List.range 29).all fun i => tabCond (i + 1) (SL60.getD (i + 1) 0) (SH60.getD (i + 1) 0)

theorem tabAll_true : tabAll = true := by decide +kernel


def symmOk : Bool := (List.range 61).all fun u =>
  decide (SL60.getD u 0 = SL60.getD (60 - u) 0) && decide (SH60.getD u 0 = SH60.getD (60 - u) 0)
theorem symmOk_true : symmOk = true := by decide +kernel
theorem lenOk : SL60.length = 61 ∧ SH60.length = 61 := by decide +kernel
theorem end0 : SL60.getD 0 0 = 0 ∧ SH60.getD 0 0 = 1 := by decide +kernel
theorem end30 : SL60.getD 30 0 + 1 = 2 ^ 32 ∧ SH60.getD 30 0 = 2 ^ 32 + 1 := by decide +kernel

/-- **(T)** the sine table: `SL60 u <= 2^32 sin(u pi / 60) <= SH60 u` for `u <= 60`. -/
theorem sin_tab60 (u : ℕ) (hu : u ≤ 60) :
    (SL60.getD u 0 : ℝ) ≤ 2 ^ 32 * Real.sin (u * Real.pi / 60) ∧
      2 ^ 32 * Real.sin (u * Real.pi / 60) ≤ (SH60.getD u 0 : ℝ) := by
  have low : ∀ v, v ≤ 30 →
      (SL60.getD v 0 : ℝ) ≤ 2 ^ 32 * Real.sin (v * Real.pi / 60) ∧
        2 ^ 32 * Real.sin (v * Real.pi / 60) ≤ (SH60.getD v 0 : ℝ) := by
    intro v hv
    by_cases h0 : v = 0
    · subst h0
      obtain ⟨a, b⟩ := end0
      rw [a, b]; simp
    by_cases h30 : v = 30
    · subst h30
      obtain ⟨a, b⟩ := end30
      have e : ((30 : ℕ) : ℝ) * Real.pi / 60 = Real.pi / 2 := by push_cast; ring
      rw [e, Real.sin_pi_div_two]
      have a' : (SL60.getD 30 0 : ℝ) + 1 = 2 ^ 32 := by exact_mod_cast a
      rw [b]; push_cast; constructor <;> linarith
    have := tabAll_true
    unfold tabAll at this
    rw [List.all_eq_true] at this
    have hm := this (v - 1) (List.mem_range.mpr (by omega))
    rw [show v - 1 + 1 = v by omega] at hm
    exact sin_enc v _ _ (by omega) (by omega) hm
  by_cases hlo : u ≤ 30
  · exact low u hlo
  · have sy := symmOk_true
    unfold symmOk at sy
    rw [List.all_eq_true] at sy
    have hs := sy u (List.mem_range.mpr (by omega))
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hs
    have h2 := low (60 - u) (by omega)
    have e : Real.sin (u * Real.pi / 60) = Real.sin (((60 - u : ℕ) : ℝ) * Real.pi / 60) := by
      rw [← Real.sin_pi_sub]; congr 1
      rw [Nat.cast_sub (by omega)]; push_cast; ring
    rw [e, hs.1, hs.2]; exact h2

#print axioms sin_tab60

end Erdos634.GA2R
