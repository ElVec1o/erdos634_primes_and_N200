import Erdos634.Draft.S51CertData
import Erdos634.Refl.SoundStage13
import Erdos634.NormalPosition

/-! Instance (1,4) of the S5 family: tile (4,15,16) (e=1, f=4), isosceles target (120,120,30)
    (base 30, apex (15, 45 sqrt 7)).  The reflective certificate `S51CertData` (2051 nodes, base-down scan,
    generated by an exact search program; the data is checked by the Lean kernel) is checked by `Refl.checkAll_sound`, with the NormalPosition
    lift, mirroring `Refl.BridgeA`/`BridgeB`.  Result `S51.s5_14_no_tiling`: no `CongruentDissection` (any `N`,
    reflections allowed) has target congruent to `TGT` and model congruent to `MODEL`. -/

open Erdos634.CertNode Erdos634.Geometry Erdos634.CertCoord Refl

namespace S51

theorem hD7 : (0:ℝ) < 7 := by norm_num

theorem TGT_pos : 0 < ef 0 0 30 0 15 45 := by unfold ef; norm_num
/-- The target `(0, 0)`, `(30, 0)`, `(15, 45·r)`, `r = sqrt 7`: sides `120, 120, 30`. -/
noncomputable def TGT : Erdos634.Geometry.Tri := rtri 7 hD7 0 0 30 0 15 45 TGT_pos
theorem MODEL_pos : 0 < ef 0 0 4 0 (47/8) (45/8) := by unfold ef; norm_num
/-- The model tile `(0, 0)`, `(4, 0)`, `(47/8, 45/8·r)`: sides `4, 15, 16`. -/
noncomputable def MODEL : Erdos634.Geometry.Tri := rtri 7 hD7 0 0 4 0 (47/8) (45/8) MODEL_pos
theorem MODEL_sides : dist (MODEL.pts 0) (MODEL.pts 1) = 4 ∧ dist (MODEL.pts 1) (MODEL.pts 2) = 15 ∧
    dist (MODEL.pts 0) (MODEL.pts 2) = 16 :=
  model_sides_rp hD7 MODEL_pos (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)

theorem w_ok : instS51.ok = true := by decide +kernel
theorem w_base : instS51.baseY = true := by decide +kernel
set_option maxRecDepth 100000 in
theorem w_check : instS51.checkAll 200 treeS51 = true := by decide +kernel

theorem tgt_ok : instS51.tgt.ok = true := by decide +kernel

theorem tgt_carr : instS51.tgt.carr 7 = TGT.carrier := by
  obtain ⟨hp, h⟩ := Tri.ok_sem 7 hD7 instS51.tgt tgt_ok
  rw [h]
  have e1 : instS51.tgt.a.X = 0 := by simp [instS51, pt, Pt.X]
  have e2 : instS51.tgt.a.Y = 0 := by simp [instS51, pt, Pt.Y]
  have e3 : instS51.tgt.b.X = 30 := by simp [instS51, pt, Pt.X]
  have e4 : instS51.tgt.b.Y = 0 := by simp [instS51, pt, Pt.Y]
  have e5 : instS51.tgt.c.X = 15 := by simp [instS51, pt, Pt.X]
  have e6 : instS51.tgt.c.Y = 45 := by simp [instS51, pt, Pt.Y]
  unfold TGT
  simp only [e1, e2, e3, e4, e5, e6]

theorem s5_14_no_tiling {N : ℕ} (D : CongruentDissection N)
    (hT : D.target.Congruent TGT) (hM : D.model.Congruent MODEL) : False := by
  obtain ⟨g, D', hD'T, hD'M, -⟩ := Erdos634.NormalPosition.exists_normal_position_congruent D hT
  obtain ⟨hMa, hMb, hMc⟩ := MODEL_sides
  have S : Sound 7 instS51 MODEL [] := checkAll_sound 7 hD7 instS51 (by norm_num [instS51]) MODEL
    (by simpa [instS51] using hMa) (by simpa [instS51] using hMb) (by simpa [instS51] using hMc)
    w_base 200 treeS51 w_check
  exact S D' (by rw [hD'T, tgt_carr]) (by rw [hD'M]; exact hM) (by simp)

end S51
#print axioms S51.s5_14_no_tiling
