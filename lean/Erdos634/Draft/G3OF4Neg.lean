-- No sorry, no native_decide, no axioms.
-- Rejection checks for the chunked F4 certificate (N = 7128), on the real clusters generated by an exact search program:
-- (i)   a target with one vertex moved (origin corner by 1000 lattice units) is rejected by `insideT` (clusters 0, 3);
-- (ii)  the model with one vertex moved is rejected by `congT` (clusters 3, 9);
-- (iii) the real cluster 5 with one vertex of its first tile moved by one lattice unit is rejected by `congT`;
-- (iv)  the real clusters 0 and 1 (adjacent trapezoids) and 3 and 4 (adjacent strips) are not separated by an unrelated line;
-- (v)   the positive counterparts on the true data hold.
import Erdos634.Draft.G3OF4Cl0
import Erdos634.Draft.G3OF4Cl1
import Erdos634.Draft.G3OF4Cl3
import Erdos634.Draft.G3OF4Cl4
import Erdos634.Draft.G3OF4Cl5
import Erdos634.Draft.G3OF4Cl9
import Erdos634.Draft.G3OF4Data
set_option maxRecDepth 100000
namespace Erdos634.Draft.G3OF4Neg
open Erdos634.Draft.G3CCert
open Erdos634.Draft.G3OF4Cl0 (cl0)
open Erdos634.Draft.G3OF4Cl1 (cl1)
open Erdos634.Draft.G3OF4Cl3 (cl3)
open Erdos634.Draft.G3OF4Cl4 (cl4)
open Erdos634.Draft.G3OF4Cl5 (cl5)
open Erdos634.Draft.G3OF4Cl9 (cl9)

def badTarget : LT := ((1000,0),(6930,0),(378,1512))
def badModel : LT := ((0,0),(42,0),(78,35))

theorem bad_target3 : cl3.leaves.all (insideT badTarget) = false := by decide +kernel
theorem bad_target0 : cl0.leaves.all (insideT badTarget) = false := by decide +kernel
theorem bad_model3 : cl3.leaves.all (congT badModel) = false := by decide +kernel
theorem bad_model9 : cl9.leaves.all (congT badModel) = false := by decide +kernel

/-- cluster 5 with vertex 0 of its first tile moved by one lattice unit -/
def moved5 : List LT :=
  match cl5.leaves with
  | t :: ts => (((t.1.1 + 1, t.1.2), t.2.1, t.2.2) : LT) :: ts
  | [] => []

theorem moved5_not_cong : moved5.all (congT Erdos634.Draft.G3OF4Data.model) = false := by decide +kernel
theorem cl5_cong : cl5.leaves.all (congT Erdos634.Draft.G3OF4Data.model) = true := by decide +kernel

theorem bad_sep01 : clSep (0,0) (70,0) cl0 cl1 = false := by decide +kernel
theorem bad_sep34 : clSep (0,0) (70,0) cl3 cl4 = false := by decide +kernel

-- positive counterpart of the same predicates on the true data (must hold)
theorem good_target3 : cl3.leaves.all (insideT Erdos634.Draft.G3OF4Data.target) = true := by decide +kernel
theorem good_target9 : cl9.leaves.all (insideT Erdos634.Draft.G3OF4Data.target) = true := by decide +kernel
theorem good_model3 : cl3.leaves.all (congT Erdos634.Draft.G3OF4Data.model) = true := by decide +kernel

end Erdos634.Draft.G3OF4Neg
