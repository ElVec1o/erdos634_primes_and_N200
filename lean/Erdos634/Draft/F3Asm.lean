  | ⟨11, _⟩, ⟨4, _⟩ => (dis_Z1_Z8 H).symm
  | ⟨11, _⟩, ⟨5, _⟩ => (dis_Z2_Z8 H).symm
  | ⟨11, _⟩, ⟨6, _⟩ => (dis_Z3_Z8 H).symm
  | ⟨11, _⟩, ⟨7, _⟩ => (dis_Z4_Z8 H).symm
  | ⟨11, _⟩, ⟨8, _⟩ => (dis_Z5_Z8 H).symm
  | ⟨11, _⟩, ⟨9, _⟩ => (dis_Z6_Z8 H).symm
  | ⟨11, _⟩, ⟨10, _⟩ => (dis_Z7_Z8 H).symm
  | ⟨11, _⟩, ⟨11, _⟩ => absurd rfl hij
  | ⟨k + 12, h⟩, _ => absurd h (by omega)
  | _, ⟨k + 12, h⟩ => absurd h (by omega)

theorem hsub_all {d y t : ℝ} (H : Hyp d y t) : ∀ i : Fin 12, regionOf d y t i ⊆ (tgtT H).carrier := by
  intro i
  rw [carrier_tgtT H]
  exact match i with
    | ⟨0, _⟩ => Set.image_mono (sub_T1 H)
    | ⟨1, _⟩ => Set.image_mono (sub_T2 H)
    | ⟨2, _⟩ => Set.image_mono (sub_T3 H)
    | ⟨3, _⟩ => Set.image_mono (sub_F4 H)
    | ⟨4, _⟩ => Set.image_mono (sub_Z1 H)
    | ⟨5, _⟩ => Set.image_mono (sub_Z2 H)
    | ⟨6, _⟩ => Set.image_mono (sub_Z3 H)
    | ⟨7, _⟩ => Set.image_mono (sub_Z4 H)
    | ⟨8, _⟩ => Set.image_mono (sub_Z5 H)
    | ⟨9, _⟩ => Set.image_mono (sub_Z6 H)
    | ⟨10, _⟩ => Set.image_mono (sub_Z7 H)
    | ⟨11, _⟩ => Set.image_mono (sub_Z8 H)
    | ⟨k + 12, h⟩ => absurd h (by omega)

/-- sides of the target: `c·(c², 3b(a+b), c(a+2b))` -/
theorem sides_tgt {d y t : ℝ} (H : Hyp d y t) :
    dist ((tgtT H).pts 0) ((tgtT H).pts 1) = ec d y t * (ec d y t * ec d y t) ∧
    dist ((tgtT H).pts 1) ((tgtT H).pts 2) = ec d y t * (3 * eb d y t * (ea d y + eb d y t)) ∧
    dist ((tgtT H).pts 2) ((tgtT H).pts 0) = ec d y t * (ec d y t * (ea d y + 2 * eb d y t)) := by
  have h1 := pa H; have h2 := pb H; have h3 := pc H
  obtain ⟨hd, hy, ht, hR⟩ := H
  refine ⟨?_, ?_, ?_⟩
  · exact dist01_of _ _ _ _ _ (by positivity) (by simp only [nq, P0, P1, ea, eb, ec]; linear_combination (189*d^4 + 234*d^3*t + 468*d^3*y + 111*d^2*t^2 + 435*d^2*t*y + 435*d^2*y^2 + 24*d*t^3 + 138*d*t^2*y + 270*d*t*y^2 + 180*d*y^3 + 2*t^4 + 15*t^3*y + 43*t^2*y^2 + 56*t*y^3 + 28*y^4) * hR)
  · exact dist12_of _ _ _ _ _ (by positivity) (by simp only [nq, P1, P2, ea, eb, ec]; ring)
  · exact dist20_of _ _ _ _ _ (by positivity) (by simp only [nq, P2, P0, ea, eb, ec]; linear_combination (324*d^4 + 432*d^3*t + 756*d^3*y + 216*d^2*t^2 + 756*d^2*t*y + 657*d^2*y^2 + 48*d*t^3 + 252*d*t^2*y + 438*d*t*y^2 + 252*d*y^3 + 4*t^4 + 28*t^3*y + 73*t^2*y^2 + 84*t*y^3 + 36*y^4) * hR)


