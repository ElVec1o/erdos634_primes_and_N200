theorem hdetF4 {d y t : ℝ} (H : Hyp d y t) : (((P3 d y t).1 - (P0 d y t).1) * ((P4 d y t).2 - (P0 d y t).2) - ((P4 d y t).1 - (P0 d y t).1) * ((P3 d y t).2 - (P0 d y t).2)) ≠ 0 := by
  obtain ⟨hd, hy, ht, hR⟩ := H
  have e : (((P3 d y t).1 - (P0 d y t).1) * ((P4 d y t).2 - (P0 d y t).2) - ((P4 d y t).1 - (P0 d y t).1) * ((P3 d y t).2 - (P0 d y t).2)) = 864*d^6 + 1368*d^5*t + 2880*d^5*y + 840*d^4*t^2 + 3780*d^4*t*y + 3984*d^4*y^2 + 250*d^3*t^3 + 1840*d^3*t^2*y + 4162*d^3*t*y^2 + 2928*d^3*y^3 + 36*d^2*t^4 + 405*d^2*t^3*y + 1506*d^2*t^2*y^2 + 2283*d^2*t*y^3 + 1206*d^2*y^4 + 2*d*t^5 + 38*d*t^4*y + 218*d*t^3*y^2 + 546*d*t^2*y^3 + 624*d*t*y^4 + 264*d*y^5 + t^5*y + 10*t^4*y^2 + 39*t^3*y^3 + 74*t^2*y^4 + 68*t*y^5 + 24*y^6 := by
    simp only [P0, P3, P4, ea, eb, ec]
    ring
  rw [e]; positivity

theorem M3_d01 {d y t : ℝ} (H : Hyp d y t) : dist ((M3 H).pts 0) ((M3 H).pts 1) = eb d y t * ec d y t := by
  unfold M3; rw [Mod3_eq (pa H) (pb H) (pc H)]
  have h1 := pb H; have h2 := pc H
  exact dist01_of _ _ _ _ _ (by positivity) (nq_01 (pa H) (pb H) (pc H) (hcR H))
theorem M3_d12 {d y t : ℝ} (H : Hyp d y t) : dist ((M3 H).pts 1) ((M3 H).pts 2) = ea d y * ec d y t := by
  unfold M3; rw [Mod3_eq (pa H) (pb H) (pc H)]
  have h1 := pa H; have h2 := pc H
  exact dist12_of _ _ _ _ _ (by positivity) (nq_12 (pa H) (pb H) (pc H) (hcR H))
theorem M3_d20 {d y t : ℝ} (H : Hyp d y t) : dist ((M3 H).pts 2) ((M3 H).pts 0) = ec d y t * ec d y t := by
  unfold M3; rw [Mod3_eq (pa H) (pb H) (pc H)]
  have h1 := pc H
  exact dist20_of _ _ _ _ _ (by positivity) (by rw [nq_20 (pa H) (pb H) (pc H) (hcR H)]; ring)


theorem f4_geom {d y t : ℝ} (H : Hyp d y t) {N : ℕ} (D : CongruentDissection N) (hM : D.model.Congruent (M3 H))
    (hD01 : dist (D.target.pts 0) (D.target.pts 1) = ec d y t * (ea d y * ec d y t))
    (hD12 : dist (D.target.pts 1) (D.target.pts 2) = ec d y t * (eb d y t * (2 * ea d y + eb d y t)))
    (hD20 : dist (D.target.pts 2) (D.target.pts 0) = ec d y t * ((ea d y + eb d y t) * ec d y t)) :
    Nonempty (RTiling (Phi 1 '' RegF4 d y t) (M3 H) N) := by
  have h1 := pa H; have h2 := pb H; have h3 := pc H
  obtain ⟨hd, hy, ht, hR⟩ := H
  exact rt_tri_of_cd D (P0 d y t) (P3 d y t) (P4 d y t) (hdetF4 ⟨hd, hy, ht, hR⟩) (M3 ⟨hd, hy, ht, hR⟩) hM _ _ _
    (by positivity) (by positivity) (by positivity) hD01 hD12 hD20
    (by simp only [nq, P0, P3, P4, ea, eb, ec]; linear_combination (36*d^4 + 24*d^3*t + 84*d^3*y + 4*d^2*t^2 + 40*d^2*t*y + 73*d^2*y^2 + 4*d*t^2*y + 22*d*t*y^2 + 28*d*y^3 + t^2*y^2 + 4*t*y^3 + 4*y^4) * hR)
    (by simp only [nq, P0, P3, P4, ea, eb, ec]; ring)
    (by simp only [nq, P0, P3, P4, ea, eb, ec]; linear_combination (144*d^4 + 168*d^3*t + 336*d^3*y + 73*d^2*t^2 + 292*d^2*t*y + 292*d^2*y^2 + 14*d*t^3 + 84*d*t^2*y + 168*d*t*y^2 + 112*d*y^3 + t^4 + 8*t^3*y + 24*t^2*y^2 + 32*t*y^3 + 16*y^4) * hR)


/-- the target triangle -/
noncomputable def tgtT {d y t : ℝ} (H : Hyp d y t) : Tri := triC 1 hf1 ((P0 d y t)) ((P1 d y t)) ((P2 d y t)) (detTgt H).ne'

theorem carrier_tgtT {d y t : ℝ} (H : Hyp d y t) : (tgtT H).carrier = Phi 1 '' RegTgt d y t := carrier_triC _ _ _ _ _ _

open MeasureTheory in
theorem volM3 {d y t : ℝ} (H : Hyp d y t) : volume (M3 H).carrier
    = ENNReal.ofReal (|sD 1 / (2 * 1)| * (eb d y t * ec d y t * (ea d y * ec d y t))) * volume Erdos634.AreaDet.stdCarrier := by
  have h1 := pa H; have h2 := pb H; have h3 := pc H
  unfold M3 Mod3 brickL
  rw [vol_triC]
  congr 2
  rw [abs_mul]
  congr 1
  rw [← abs_of_pos (show 0 < eb d y t * ec d y t * (ea d y * ec d y t) by positivity)]
  congr 1
  ring

open MeasureTheory in
theorem volTgt {d y t : ℝ} (H : Hyp d y t) : volume (tgtT H).carrier
    = ENNReal.ofReal (|sD 1 / (2 * 1)| * ((((P1 d y t)).1 - ((P0 d y t)).1) * (((P2 d y t)).2 - ((P0 d y t)).2) - (((P2 d y t)).1 - ((P0 d y t)).1) * (((P1 d y t)).2 - ((P0 d y t)).2))) * volume Erdos634.AreaDet.stdCarrier := by
  unfold tgtT
  rw [vol_triC, abs_mul, abs_of_pos (detTgt H)]


open MeasureTheory in
theorem hvol_all {d y t : ℝ} (H : Hyp d y t) (N : ℕ) (hN : (N : ℝ) = 72*d^2 + 42*d*t + 72*d*y + 6*t^2 + 21*t*y + 18*y^2) :
    (N : ENNReal) * volume (M3 H).carrier = volume (tgtT H).carrier := by
  obtain ⟨hd, hy, ht, hR⟩ := H
  rw [volM3 ⟨hd, hy, ht, hR⟩, volTgt ⟨hd, hy, ht, hR⟩, ← mul_assoc, ← ENNReal.ofReal_natCast,
    ← ENNReal.ofReal_mul (Nat.cast_nonneg _)]
  congr 2
  rw [hN]
  simp only [P0, P1, P2, ea, eb, ec]
  ring


noncomputable def regionOf (d y t : ℝ) : Fin 12 → Set Plane := fun i => match i with
  | ⟨0, _⟩ => Phi 1 '' RegT1 d y t
  | ⟨1, _⟩ => Phi 1 '' RegT2 d y t
  | ⟨2, _⟩ => Phi 1 '' RegT3 d y t
  | ⟨3, _⟩ => Phi 1 '' RegF4 d y t
  | ⟨4, _⟩ => Phi 1 '' RegZ1 d y t
  | ⟨5, _⟩ => Phi 1 '' RegZ2 d y t
  | ⟨6, _⟩ => Phi 1 '' RegZ3 d y t
  | ⟨7, _⟩ => Phi 1 '' RegZ4 d y t
  | ⟨8, _⟩ => Phi 1 '' RegZ5 d y t
  | ⟨9, _⟩ => Phi 1 '' RegZ6 d y t
  | ⟨10, _⟩ => Phi 1 '' RegZ7 d y t
  | ⟨11, _⟩ => Phi 1 '' RegZ8 d y t
  | ⟨k + 12, h⟩ => absurd h (by omega)

def cntN (nd ny nt : ℕ) : ℕ → ℕ
  | 0 => (3*nd+2*ny+nt) * (3*nd+2*ny+nt)
  | 1 => (2*nd+ny+nt) * (2*nd+ny+nt)
  | 2 => (2*nd+ny+nt) * (2*nd+ny+nt)
  | 3 => ((2*(2*nd+ny)+(2*nd+ny+nt))*((2*nd+ny)+(2*nd+ny+nt)))
  | 4 => nd * nd
  | 5 => 2 * (2*nd+2*ny+nt) * nd
  | 6 => (2*nd+ny) * (2*nd+ny)
  | 7 => (nd+ny+nt) * (nd+ny+nt)
  | 8 => 2 * nd * (2*nd+ny+nt)
  | 9 => (nd+ny) * (nd+ny)
  | 10 => (2*nd+ny+nt) * (2*nd+ny+nt)
  | 11 => 2 * (3*nd+ny+2*nt) * (2*nd+ny)
  | _ => 0

def cnt (nd ny nt : ℕ) (i : Fin 12) : ℕ := cntN nd ny nt i.val

