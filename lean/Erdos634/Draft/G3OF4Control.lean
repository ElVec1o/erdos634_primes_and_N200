-- No sorry, no native_decide, no axioms.
-- Control for the F4' branch of GapR8 and its arithmetic hypothesis NoF4z: the F4-shaped tiling of N = 7128 (= F4' of the swapped tile (5,3,7))
-- (tile (5,3,7)*(2*7); Zhang arXiv:2512.22696 Prop 9(1)+Cor. 1).  The certificate is generated by an exact search program and checked in the kernel by
-- G3CCert.Cert.ok assembled from per-cluster facts and per-row separation facts, see G3NChunk, G3OPairs.  It is a `CongruentDissection 7128`
-- meeting every structural premise of the F4' branch of `GapR8` (IrrPi alpha, TwoPiThreeData, F2to4Shape, hence F4PrimeData with nu > 0),
-- and NoF4z is FALSE at 7128 ((x, y, z) = (27, 45, 63)).
import Erdos634.Draft.G3OF4Cert
import Erdos634.Draft.G3CAng
import Erdos634.Draft.AllNExclusionArith
import Erdos634.Draft.R8F2to4Bridge

open scoped Classical

namespace Erdos634.Draft.G3OF4Control

open Erdos634.Geometry Erdos634.Draft.G3CCert Erdos634.Draft.TheoremPConditional Erdos634.Draft.Chain15
open Erdos634.Draft.G3CAng
open Erdos634.Draft.G3OF4Cert (cert cert_ok cert_len)
open Erdos634.Draft.FluxPaperWitness (cornerAngle_mem')

noncomputable abbrev D := cd cert cert_ok

theorem N_eq : cert.leaves.length = 7128 := cert_len

theorem m_opp0 : D.model.oppLen 0 = 70 := by
  rw [show D.model = _ from cd_model cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.model (0 + 1)) (vtx cert.model (0 + 2)) 70 (by decide)
  rw [this]; norm_num
theorem m_opp1 : D.model.oppLen 1 = 98 := by
  rw [show D.model = _ from cd_model cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.model (1 + 1)) (vtx cert.model (1 + 2)) 98 (by decide)
  rw [this]; norm_num
theorem m_opp2 : D.model.oppLen 2 = 42 := by
  rw [show D.model = _ from cd_model cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.model (2 + 1)) (vtx cert.model (2 + 2)) 42 (by decide)
  rw [this]; norm_num

theorem t_opp0 : D.target.oppLen 0 = 7056 := by
  rw [show D.target = _ from cd_target cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.target (0 + 1)) (vtx cert.target (0 + 2)) 7056 (by decide)
  rw [this]; norm_num
theorem t_opp1 : D.target.oppLen 1 = 2646 := by
  rw [show D.target = _ from cd_target cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.target (1 + 1)) (vtx cert.target (1 + 2)) 2646 (by decide)
  rw [this]; norm_num
theorem t_opp2 : D.target.oppLen 2 = 6930 := by
  rw [show D.target = _ from cd_target cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.target (2 + 1)) (vtx cert.target (2 + 2)) 6930 (by decide)
  rw [this]; norm_num

/-- vertex presentation: sigma sends (a,b,c) = (5,3,7) to the vertices opposite 70, 42, 98 (a=5 b=3 c=7), i.e. (0, 2, 1) -/
def σm : Equiv.Perm (Fin 3) := ⟨![0, 2, 1], ![0, 2, 1], by decide, by decide⟩
theorem σm0 : σm 0 = 0 := rfl
theorem σm1 : σm 1 = 2 := rfl
theorem σm2 : σm 2 = 1 := rfl

noncomputable def α : ℝ := D.model.angleAt (σm 0)
noncomputable def β : ℝ := D.model.angleAt (σm 1)

theorem o0 : D.model.oppLen (σm 0) = 14 * 5 := by rw [σm0, m_opp0]; norm_num
theorem o1 : D.model.oppLen (σm 1) = 14 * 3 := by rw [σm1, m_opp2]; norm_num
theorem o2 : D.model.oppLen (σm 2) = 14 * 7 := by rw [σm2, m_opp1]; norm_num

theorem data : D.model.TwoPiThreeData α (14 * 5) (14 * 3) (14 * 7) :=
  tp_data D.model σm 14 5 3 7 (by norm_num) (by norm_num) (by norm_num) (by norm_num) o0 o1 o2

theorem hβ : β = Real.pi / 3 - α :=
  (tp_angles D.model σm 14 5 3 7 (by norm_num) (by norm_num) (by norm_num) (by norm_num) o0 o1 o2).2

theorem cos_α : Real.cos α = 11 / 14 := by
  unfold α
  rw [cos_s0 D.model σm (by rw [o1]; norm_num) (by rw [o2]; norm_num), o0, o1, o2]; norm_num

theorem cos_β : Real.cos β = 13 / 14 := by
  unfold β
  rw [cos_s1 D.model σm (by rw [o0]; norm_num) (by rw [o2]; norm_num), o0, o1, o2]; norm_num

theorem α_irr : IrrPi α :=
  irrPi_of_cos α (11 / 14) (by rw [cos_α]; norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num)

theorem α_nn : 0 ≤ α := (cornerAngle_mem' _ _ _ : 0 ≤ D.model.angleAt (σm 0) ∧ _).1
theorem β_nn : 0 ≤ β := (cornerAngle_mem' _ _ _ : 0 ≤ D.model.angleAt (σm 1) ∧ _).1

theorem lt_half_of_cos_pos {x : ℝ} (hx : x ≤ Real.pi) (hc : 0 < Real.cos x) : x < Real.pi / 2 := by
  by_contra h
  push Not at h
  have := Real.cos_nonpos_of_pi_div_two_le_of_le h (by linarith [hx, Real.pi_pos])
  linarith

theorem α_lt : α < Real.pi / 2 :=
  lt_half_of_cos_pos (cornerAngle_mem' _ _ _ : _ ∧ D.model.angleAt (σm 0) ≤ Real.pi).2 (by rw [cos_α]; norm_num)

/-- target vertex cosines (F4': vertex 1 ~ beta, vertex 2 ~ 2 alpha, vertex 0 ~ alpha + 2 beta) -/
theorem t_cos1 : Real.cos (D.target.angleAt 1) = 13 / 14 := by
  have := cos_s1 D.target 1 (by simp [t_opp0]) (by simp [t_opp2])
  simp only [Equiv.Perm.coe_one, id_eq] at this
  rw [this, t_opp0, t_opp1, t_opp2]; norm_num
theorem t_cos2 : Real.cos (D.target.angleAt 2) = 23 / 98 := by
  have := cos_s2 D.target 1 (by simp [t_opp0]) (by simp [t_opp1])
  simp only [Equiv.Perm.coe_one, id_eq] at this
  rw [this, t_opp0, t_opp1, t_opp2]; norm_num

/-- target vertices in the order of the shape (beta, 2 alpha, alpha + 2 beta): 1, 2, 0 -/
def σt : Equiv.Perm (Fin 3) := ⟨![1, 2, 0], ![2, 0, 1], by decide, by decide⟩

theorem hα2 : Real.cos (2 * α) = 23 / 98 := by rw [Real.cos_two_mul, cos_α]; norm_num

theorem α2_ok : 0 ≤ 2 * α ∧ 2 * α ≤ Real.pi := by
  have := α_lt; have := α_nn; constructor <;> linarith

theorem t_angV1 : D.target.angleAt 1 = Real.pi / 3 - α :=
  (angle_eq_of_cos 1 (σm 1) (t_cos1.trans cos_β.symm)).trans hβ
theorem t_angV2 : D.target.angleAt 2 = 2 * α :=
  Real.injOn_cos (cornerAngle_mem' _ _ _) α2_ok (t_cos2.trans hα2.symm)
/-- the third target angle from the angle sum -/
theorem t_angV0 : D.target.angleAt 0 = α + 2 * (Real.pi / 3 - α) := by
  have hs := sum_perm D.target 1
  simp only [Equiv.Perm.coe_one, id_eq] at hs
  rw [t_angV1, t_angV2] at hs
  linarith

theorem f4p_tgt : TgtAngles D (Real.pi / 3 - α) (2 * α) (α + 2 * (Real.pi / 3 - α)) :=
  ⟨σt, t_angV1, t_angV2, t_angV0⟩

/-- **F4' shape** -/
theorem f4p_shape : F2to4Shape D α := Or.inr (Or.inr (Or.inr (Or.inr f4p_tgt)))

theorem premises : IrrPi α ∧ D.model.TwoPiThreeData α (14 * 5) (14 * 3) (14 * 7) ∧ F2to4Shape D α :=
  ⟨α_irr, data, f4p_shape⟩

/-- the F4' shape data of the leaf: `F4PrimeData` with nu > 0 (and a, b > 0) -/
theorem f4p_leaf_premises :
    IrrPi α ∧ D.model.TwoPiThreeData α (14 * 5) (14 * 3) (14 * 7) ∧ (0 : ℝ) < 14 * 5 ∧ (0 : ℝ) < 14 * 3 ∧
      ∃ ν > 0, D.target.F4PrimeData α (14 * 5) (14 * 3) (14 * 7) ν :=
  ⟨α_irr, data, by norm_num, by norm_num, Erdos634.Draft.R8F2to4Bridge.f4prime_data_of_shape D data f4p_tgt⟩

theorem not_gapR8_7128 : ¬ GapR8 7128 := by
  intro g
  have h : cert.leaves.length = 7128 := cert_len
  rw [← h] at g
  exact g D α _ _ _ α_irr data f4p_shape

/-- the NoF4z hypothesis of the F4/F4' leaf is FALSE at 7128: (x, y, z) = (27, 45, 63) -/
theorem not_noF4z_7128 : ¬ Erdos634.Draft.R8Gen2.NoF4z 7128 := by
  intro h
  exact h 27 (by norm_num) 45 (by norm_num) (by norm_num) 63 (by norm_num)

theorem not_all_r8_7128 :
    ¬ (Erdos634.Draft.R8Gen2.NoF2 7128 ∧ Erdos634.Draft.R8Gen2.NoF3 7128 ∧ Erdos634.Draft.R8Gen2.NoF4z 7128) :=
  fun ⟨a, b, c⟩ => not_gapR8_7128 (Erdos634.Draft.R8Gen2.gapR8_of_arith2 7128 a b c)

theorem f4p_leaf_witness :
    (∃ (N : ℕ) (D : CongruentDissection N) (α a b c : ℝ), IrrPi α ∧ D.model.TwoPiThreeData α a b c ∧
      F2to4Shape D α ∧ 0 < a ∧ 0 < b ∧ N = 7128) ∧ ¬ Erdos634.Draft.R8Gen2.NoF4z 7128 :=
  ⟨⟨_, D, α, _, _, _, α_irr, data, f4p_shape, by norm_num, by norm_num, cert_len⟩, not_noF4z_7128⟩

end Erdos634.Draft.G3OF4Control

