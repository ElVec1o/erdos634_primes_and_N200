  have sepA_34 : ∀ p ∈ Preg (sP1 F) (sW F) (sA F) (((0:ℕ):ℝ)/(k3:ℝ)), (1) * p.1 + (0) * p.2 ≤ (F^5 + F^4 - 2*F^3 - 2*F^2 + F + 1) :=
    preg_le4 _ _ _ (sP1 F) (sP1 F) _ _ _ _ hs0_R3 hs1_R3 eq_R3.1 eq_R3.2.1 eq_R3.2.2.1 eq_R3.2.2.2 (sfS_34A_P1 F hF) (sfS_34A_P1 F hF) (sfS_34A_W F hF) (sfS_34A_A F hF)
  have sepB_34 : ∀ p ∈ Preg (sA F) (sW F) (sZ F) (((0:ℕ):ℝ)/(k4:ℝ)), (F^5 + F^4 - 2*F^3 - 2*F^2 + F + 1) ≤ (1) * p.1 + (0) * p.2 :=
    preg_ge4 _ _ _ (sA F) (sA F) _ _ _ _ hs0_R4 hs1_R4 eq_R4.1 eq_R4.2.1 eq_R4.2.2.1 eq_R4.2.2.2 (sfS_34B_A F hF) (sfS_34B_A F hF) (sfS_34B_W F hF) (sfS_34B_Z F hF)
  have dd_34 : Disjoint (interior (Phi F '' Preg (sP1 F) (sW F) (sA F) (((0:ℕ):ℝ)/(k3:ℝ)))) (interior (Phi F '' Preg (sA F) (sW F) (sZ F) (((0:ℕ):ℝ)/(k4:ℝ)))) :=
    disjoint_image hφ (interior_disj_lin _ _ _ (by intro h; have : (0:ℝ) < (1) := (by (obtain ⟨s, hs, rfl⟩ : ∃ s, 0 ≤ s ∧ F = 2 + s := ⟨F - 2, by linarith, by ring⟩; ring_nf; positivity)); linarith) sepA_34 sepB_34)
  have sepA_35 : ∀ p ∈ Preg (sP1 F) (sW F) (sA F) (((0:ℕ):ℝ)/(k3:ℝ)), (0) * p.1 + (-1) * p.2 ≤ (-F^3 + F) :=
