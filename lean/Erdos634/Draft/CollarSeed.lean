    rw [tgt_car]
    fin_cases a

    · exact Set.image_mono (fun p hp => inT_mem 1 F _ one_pos hφ hg0 (by nlinarith) (inR_R0 p hp))
    · exact Set.image_mono (fun p hp => inT_mem 1 F _ one_pos hφ hg0 (by nlinarith) (inR_R1 p hp))
    · exact Set.image_mono (fun p hp => inT_mem 1 F _ one_pos hφ hg0 (by nlinarith) (inR_R2 p hp))
