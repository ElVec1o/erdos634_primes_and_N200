    rw [this]
    exact (mul_pos (mul_pos hB0 hg0) (mul_pos (mul_pos ha hb) hg0)).ne'
  let tgt : Tri := triC F hφ ((0 : ℝ), (0 : ℝ)) (pB0 1 F * (F + 1), 0)
    ((F^2-1^2)^2 * (F + 1), 1*F*(F^2-1^2) * (F + 1)) hdetT
