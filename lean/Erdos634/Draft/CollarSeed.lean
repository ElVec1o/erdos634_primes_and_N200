  let S6 : Fin 6 → Set Plane := ![Phi F '' Preg (sO F) (sP1 F) (sC0 F) (((0:ℕ):ℝ)/(k0:ℝ)),
    Phi F '' Preg (sE0 F) (sLp F) (sA F) (((0:ℕ):ℝ)/(k1:ℝ)),
    Phi F '' Preg (sX2 F) (sW F) (sP1 F) ((sp2:ℝ)/(k2:ℝ)),
    Phi F '' Preg (sP1 F) (sW F) (sA F) (((0:ℕ):ℝ)/(k3:ℝ)),
    Phi F '' Preg (sA F) (sW F) (sZ F) (((0:ℕ):ℝ)/(k4:ℝ)),
    Phi F '' Preg (sX5 F) (sV5 F) (sW F) ((sp5:ℝ)/(k5:ℝ))]
  let n6 : Fin 6 → ℕ := ![k0 * k0 - 0 * 0, k1 * k1 - 0 * 0, k2 * k2 - sp2 * sp2, k3 * k3 - 0 * 0, k4 * k4 - 0 * 0, k5 * k5 - sp5 * sp5]
  let Rf : ∀ a : Fin 6, TFam (S6 a) Mdl (n6 a) := fun a => match a with
    | ⟨0, _⟩ => fam_R0
    | ⟨1, _⟩ => fam_R1
    | ⟨2, _⟩ => fam_R2
    | ⟨3, _⟩ => fam_R3
    | ⟨4, _⟩ => fam_R4
    | ⟨5, _⟩ => fam_R5
    | ⟨k + 6, h⟩ => absurd h (by omega)
  have hSd : ∀ a b : Fin 6, a ≠ b → Disjoint (interior (S6 a)) (interior (S6 b)) := by
    intro a b hab
    fin_cases a <;> fin_cases b <;>
      first
        | exact absurd rfl hab
        | exact dd_01 | exact dd_01.symm | exact dd_02 | exact dd_02.symm | exact dd_03 | exact dd_03.symm | exact dd_04 | exact dd_04.symm | exact dd_05 | exact dd_05.symm | exact dd_12 | exact dd_12.symm | exact dd_13 | exact dd_13.symm | exact dd_14 | exact dd_14.symm | exact dd_15 | exact dd_15.symm | exact dd_23 | exact dd_23.symm | exact dd_24 | exact dd_24.symm | exact dd_25 | exact dd_25.symm | exact dd_34 | exact dd_34.symm | exact dd_35 | exact dd_35.symm | exact dd_45 | exact dd_45.symm
  have hg0 : (0 : ℝ) < F + 1 := by linarith
  have hB0 : 0 < pB0 1 F := by unfold pB0; positivity
  have hdetT : ((pB0 1 F * (F + 1), (0 : ℝ)).1 - ((0 : ℝ), (0 : ℝ)).1) *
      (((F^2-1^2)^2 * (F + 1), 1*F*(F^2-1^2) * (F + 1)).2 - ((0 : ℝ), (0 : ℝ)).2) -
      (((F^2-1^2)^2 * (F + 1), 1*F*(F^2-1^2) * (F + 1)).1 - ((0 : ℝ), (0 : ℝ)).1) *
