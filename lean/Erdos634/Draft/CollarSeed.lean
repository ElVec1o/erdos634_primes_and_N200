      rw [vol_triC]; congr 2
      rw [← abs_of_pos (show 0 < sD F / (2 * F) * (pB0 1 F * (F + 1) * (1*F*(F^2-1^2) * (F + 1))) from
        mul_pos (div_pos hs (by linarith)) (mul_pos (mul_pos hB0 hg0) (mul_pos (mul_pos ha hb) hg0)))]
      congr 1; simp only []; ring
    rw [hM, hT, hsum, ← mul_assoc, ← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (Nat.cast_nonneg _)]
    congr 2
    push_cast
    rw [hN0, hg]; unfold pB0; ring
  obtain ⟨D, hDm, hDt⟩ := pack_exists' (M := Mdl) (T := tgt) S6 n6 Rf hSd hsub hvol
  have key : ∀ N : ℕ, N = N0 * g * g → ∀ D : CongruentDissection N, D.model = Mdl → D.target = tgt →
