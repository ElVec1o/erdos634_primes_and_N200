      show k0 * k0 - 0 * 0 + (k1 * k1 - 0 * 0) + (k2 * k2 - sp2 * sp2) + (k3 * k3 - 0 * 0) + (k4 * k4 - 0 * 0) + (k5 * k5 - sp5 * sp5) = _
