  have dd_35 : Disjoint (interior (Phi F '' Preg (sP1 F) (sW F) (sA F) (((0:ℕ):ℝ)/(k3:ℝ)))) (interior (Phi F '' Preg (sX5 F) (sV5 F) (sW F) ((sp5:ℝ)/(k5:ℝ)))) :=
    (disjoint_image hφ (interior_disj_snd (F^3 - F) (fun p hp => by have := sepB_35 p hp; linarith) (fun p hp => by have := sepA_35 p hp; linarith))).symm
  have sepA_45 : ∀ p ∈ Preg (sA F) (sW F) (sZ F) (((0:ℕ):ℝ)/(k4:ℝ)), (-1) * p.1 + (-F) * p.2 ≤ (-F^5 - 2*F^4 + 2*F^3 + 3*F^2 - F - 1) :=
    preg_le4 _ _ _ (sA F) (sA F) _ _ _ _ hs0_R4 hs1_R4 eq_R4.1 eq_R4.2.1 eq_R4.2.2.1 eq_R4.2.2.2 (sfS_45A_A F hF) (sfS_45A_A F hF) (sfS_45A_W F hF) (sfS_45A_Z F hF)
  have sepB_45 : ∀ p ∈ Preg (sX5 F) (sV5 F) (sW F) ((sp5:ℝ)/(k5:ℝ)), (-F^5 - 2*F^4 + 2*F^3 + 3*F^2 - F - 1) ≤ (-1) * p.1 + (-F) * p.2 :=
