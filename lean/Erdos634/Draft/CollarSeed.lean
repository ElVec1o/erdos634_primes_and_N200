    have h2 : sp2 * sp2 ≤ k2 * k2 := Nat.mul_self_le_mul_self hsp2le
    have h5 : sp5 * sp5 ≤ k5 * k5 := Nat.mul_self_le_mul_self hsp5le
    have e : (∑ a, n6 a) = k0 * k0 + k1 * k1 + (k2 * k2 - sp2 * sp2) + k3 * k3 + k4 * k4 + (k5 * k5 - sp5 * sp5) := by
