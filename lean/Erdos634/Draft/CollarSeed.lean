    rw [e]
    apply Nat.cast_injective (R := ℝ)
    push_cast [Nat.cast_sub h2, Nat.cast_sub h5]
    rw [hk0, hk1, hk2, hsp2, hk3, hk4, hk5, hsp5, hN0, hg]
