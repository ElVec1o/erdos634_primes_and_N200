theorem hsub_all : ∀ a : Fin 6, regionOf a ⊆ tgt.carrier := by
  intro a
  rw [tgt_carrier]
  exact match a with
  | ⟨0, _⟩ => sub0
  | ⟨1, _⟩ => sub1
  | ⟨2, _⟩ => sub2
  | ⟨3, _⟩ => sub3
  | ⟨4, _⟩ => sub4
  | ⟨5, _⟩ => sub5
  | ⟨k + 6, h⟩ => absurd h (by omega)

