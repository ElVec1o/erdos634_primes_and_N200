noncomputable def regionOf (nd ny nt nA nB ns : ℕ) : Fin 10 → Set Plane := fun i => match i with
  | ⟨0, _⟩ => Phi 1 '' RegPa1 (nd:ℝ) ny nt nA nB ns
  | ⟨1, _⟩ => condSet (ns = 0) (Phi 1 '' RegPa2 (nd:ℝ) ny nt nA nB ns)
  | ⟨2, _⟩ => Phi 1 '' RegPa3 (nd:ℝ) ny nt nA nB ns
  | ⟨3, _⟩ => Phi 1 '' RegT2 (nd:ℝ) ny nt nA nB ns
  | ⟨4, _⟩ => Phi 1 '' RegT3 (nd:ℝ) ny nt nA nB ns
  | ⟨5, _⟩ => condSet (nA = 0) (Phi 1 '' RegSA (nd:ℝ) ny nt nA nB ns)
  | ⟨6, _⟩ => condSet (nB = 0) (Phi 1 '' RegSB (nd:ℝ) ny nt nA nB ns)
  | ⟨7, _⟩ => Phi 1 '' RegX1 (nd:ℝ) ny nt nA nB ns
  | ⟨8, _⟩ => Phi 1 '' RegX2 (nd:ℝ) ny nt nA nB ns
  | ⟨9, _⟩ => Phi 1 '' RegX3 (nd:ℝ) ny nt nA nB ns
  | ⟨k + 10, h⟩ => absurd h (by omega)

def cntN (nd ny nt nA nB ns : ℕ) : ℕ → ℕ
  | 0 => 2 * (3 * nd + 2 * ny) * (nt + ns)
  | 1 => 2 * (nt) * (ns)
  | 2 => (nt) * (nt)
  | 3 => (2 * nd + ny + nt) * (2 * nd + ny + nt)
  | 4 => (nd + ny) * (nd + ny)
  | 5 => 2 * (nA) * (2 * nd + ny + nt)
  | 6 => 2 * (nB) * (2 * nd + ny)
  | 7 => (2 * nd + ny + nt) * (2 * nd + ny + nt)
  | 8 => (2 * nd + ny + nt) * (2 * nd + ny + nt)
  | 9 => (2 * nd + ny) * (2 * nd + ny)
  | _ => 0

def cnt (nd ny nt nA nB ns : ℕ) (i : Fin 10) : ℕ := cntN nd ny nt nA nB ns i.val

