  intro i
  rw [carrier_tgtT H]
  exact match i with
    | ⟨0, _⟩ => Set.image_mono (sub_Pa1 H)
    | ⟨1, _⟩ => cd_sub (fun hp => Set.image_mono (sub_Pa2 H (by have := Nat.pos_of_ne_zero hp; exact_mod_cast this)))
    | ⟨2, _⟩ => Set.image_mono (sub_Pa3 H)
    | ⟨3, _⟩ => Set.image_mono (sub_T2 H)
    | ⟨4, _⟩ => Set.image_mono (sub_T3 H)
    | ⟨5, _⟩ => cd_sub (fun hp => Set.image_mono (sub_SA H (by have := Nat.pos_of_ne_zero hp; exact_mod_cast this)))
    | ⟨6, _⟩ => cd_sub (fun hp => Set.image_mono (sub_SB H (by have := Nat.pos_of_ne_zero hp; exact_mod_cast this)))
    | ⟨7, _⟩ => Set.image_mono (sub_X1 H)
    | ⟨8, _⟩ => Set.image_mono (sub_X2 H)
    | ⟨9, _⟩ => Set.image_mono (sub_X3 H)
    | ⟨k + 10, h⟩ => absurd h (by omega)

