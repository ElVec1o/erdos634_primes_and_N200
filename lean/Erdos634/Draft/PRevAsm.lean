/-- the target triangle -/
noncomputable def tgtT {d y t A B s : ℝ} (H : Hyp d y t A B s) : Tri := triC 1 hf1 ((Pp0 d y t A B s)) ((Pp1 d y t A B s)) ((Pp2 d y t A B s)) (detTgt H).ne'

theorem carrier_tgtT {d y t A B s : ℝ} (H : Hyp d y t A B s) : (tgtT H).carrier = Phi 1 '' RegTgt d y t A B s := carrier_triC _ _ _ _ _ _

open MeasureTheory in
theorem volM {d y t A B s : ℝ} (H : Hyp d y t A B s) : volume (MK H).carrier
    = ENNReal.ofReal (|sD 1 / (2 * 1)| * (eb d y * eK d y t * (ea d y t * eK d y t))) * volume Erdos634.AreaDet.stdCarrier := by
  have h1 := pa H; have h2 := pb H; have h3 := pK H
  unfold MK ModK brickL
  rw [vol_triC]
  congr 2
  rw [abs_mul]
  congr 1
  rw [← abs_of_pos (show 0 < eb d y * eK d y t * (ea d y t * eK d y t) by positivity)]
  congr 1
  ring

open MeasureTheory in
theorem volTgt {d y t A B s : ℝ} (H : Hyp d y t A B s) : volume (tgtT H).carrier
    = ENNReal.ofReal (|sD 1 / (2 * 1)| * ((((Pp1 d y t A B s)).1 - ((Pp0 d y t A B s)).1) * (((Pp2 d y t A B s)).2 - ((Pp0 d y t A B s)).2) - (((Pp2 d y t A B s)).1 - ((Pp0 d y t A B s)).1) * (((Pp1 d y t A B s)).2 - ((Pp0 d y t A B s)).2))) * volume Erdos634.AreaDet.stdCarrier := by
  unfold tgtT
  rw [vol_triC, abs_mul, abs_of_pos (detTgt H)]


