theorem detT (e f M t r q : ℝ) (h : WP e f M t r q) :
    ((pt_B e f M t r q).1 - 0) * ((pt_A e f M t r q).2 - 0) - ((pt_A e f M t r q).1 - 0) * (0 - 0) ≠ 0 := by
  have := mul_pos (posB e f M t r q h) (posYA e f M t r q h)
  simp only [sub_zero, mul_zero, sub_self]
  exact this.ne'

noncomputable def tgtT (e f M t r q : ℝ) (h : WP e f M t r q) (hF : 1 < f / e) : Erdos634.Geometry.Tri :=
  triC (f / e) hF ((0:ℝ), (0:ℝ)) ((pt_B e f M t r q).1, 0) ((pt_A e f M t r q).1, (pt_A e f M t r q).2) (detT e f M t r q h)

theorem tgt_carrier (e f M t r q : ℝ) (h : WP e f M t r q) (hF : 1 < f / e) :
    (tgtT e f M t r q h hF).carrier = Phi (f / e) '' convexHull ℝ ({((0:ℝ), (0:ℝ)), ((pt_B e f M t r q).1, 0), ((pt_A e f M t r q).1, (pt_A e f M t r q).2)} : Set (ℝ × ℝ)) :=
  carrier_triC _ _ _ _ _ _

def regionOf (e f M t r q : ℝ) (z : Sc e f M t r q) : Fin 6 → Set Plane := fun i => match i with

  | ⟨0, _⟩ => Phi (f / e) '' reg0 e f M t r q z
  | ⟨1, _⟩ => Phi (f / e) '' reg1 e f M t r q z
  | ⟨2, _⟩ => Phi (f / e) '' reg2 e f M t r q z
  | ⟨3, _⟩ => Phi (f / e) '' reg3 e f M t r q z
  | ⟨4, _⟩ => Phi (f / e) '' reg4 e f M t r q z
  | ⟨5, _⟩ => Phi (f / e) '' reg5 e f M t r q z
  | ⟨k + 6, hk⟩ => absurd hk (by omega)

def cntF {e f M t r q : ℝ} (z : Sc e f M t r q) : Fin 6 → ℕ := fun i => match i with
  | ⟨0, _⟩ => z.K0 * z.K0 - z.S0 * z.S0
  | ⟨1, _⟩ => z.K1 * z.K1 - 0 * 0
  | ⟨2, _⟩ => z.K2 * z.K2 - 0 * 0
  | ⟨3, _⟩ => z.K3 * z.K3 - z.S3 * z.S3
  | ⟨4, _⟩ => 2 * z.s4 * z.x4
  | ⟨5, _⟩ => z.K5 * z.K5 - z.S5 * z.S5
  | ⟨k + 6, hk⟩ => absurd hk (by omega)

noncomputable def famAll (e f M t r q : ℝ) (h : WP e f M t r q) (z : Sc e f M t r q) (hF : 1 < f / e) (hA : 0 < e * f) (hB : 0 < f ^ 2 - e ^ 2) :
    ∀ a : Fin 6, TFam (regionOf e f M t r q z a) (brickL (f / e) hF (e * f) (f ^ 2 - e ^ 2) hA hB) (cntF z a) := fun a => match a with
  | ⟨0, _⟩ => fam0 e f M t r q h z hF hA hB
  | ⟨1, _⟩ => fam1 e f M t r q h z hF hA hB
  | ⟨2, _⟩ => fam2 e f M t r q h z hF hA hB
  | ⟨3, _⟩ => fam3 e f M t r q h z hF hA hB
  | ⟨4, _⟩ => fam4 e f M t r q h z hF hA hB
  | ⟨5, _⟩ => fam5 e f M t r q h z hF hA hB
  | ⟨k + 6, hk⟩ => absurd hk (by omega)

theorem hS_all (e f M t r q : ℝ) (h : WP e f M t r q) (z : Sc e f M t r q) (hF : 1 < f / e) : ∀ a b : Fin 6, a ≠ b → Disjoint (interior (regionOf e f M t r q z a)) (interior (regionOf e f M t r q z b)) :=
  fun a b hab => match a, b with
  | ⟨0, _⟩, ⟨0, _⟩ => absurd rfl hab
  | ⟨0, _⟩, ⟨1, _⟩ => dis0_1 e f M t r q h z hF
  | ⟨0, _⟩, ⟨2, _⟩ => dis0_2 e f M t r q h z hF
  | ⟨0, _⟩, ⟨3, _⟩ => dis0_3 e f M t r q h z hF
  | ⟨0, _⟩, ⟨4, _⟩ => dis0_4 e f M t r q h z hF
  | ⟨0, _⟩, ⟨5, _⟩ => dis0_5 e f M t r q h z hF
  | ⟨1, _⟩, ⟨0, _⟩ => (dis0_1 e f M t r q h z hF).symm
  | ⟨1, _⟩, ⟨1, _⟩ => absurd rfl hab
  | ⟨1, _⟩, ⟨2, _⟩ => dis1_2 e f M t r q h z hF
  | ⟨1, _⟩, ⟨3, _⟩ => dis1_3 e f M t r q h z hF
  | ⟨1, _⟩, ⟨4, _⟩ => dis1_4 e f M t r q h z hF
  | ⟨1, _⟩, ⟨5, _⟩ => dis1_5 e f M t r q h z hF
  | ⟨2, _⟩, ⟨0, _⟩ => (dis0_2 e f M t r q h z hF).symm
  | ⟨2, _⟩, ⟨1, _⟩ => (dis1_2 e f M t r q h z hF).symm
  | ⟨2, _⟩, ⟨2, _⟩ => absurd rfl hab
  | ⟨2, _⟩, ⟨3, _⟩ => dis2_3 e f M t r q h z hF
  | ⟨2, _⟩, ⟨4, _⟩ => dis2_4 e f M t r q h z hF
  | ⟨2, _⟩, ⟨5, _⟩ => dis2_5 e f M t r q h z hF
  | ⟨3, _⟩, ⟨0, _⟩ => (dis0_3 e f M t r q h z hF).symm
  | ⟨3, _⟩, ⟨1, _⟩ => (dis1_3 e f M t r q h z hF).symm
  | ⟨3, _⟩, ⟨2, _⟩ => (dis2_3 e f M t r q h z hF).symm
  | ⟨3, _⟩, ⟨3, _⟩ => absurd rfl hab
  | ⟨3, _⟩, ⟨4, _⟩ => dis3_4 e f M t r q h z hF
  | ⟨3, _⟩, ⟨5, _⟩ => dis3_5 e f M t r q h z hF
  | ⟨4, _⟩, ⟨0, _⟩ => (dis0_4 e f M t r q h z hF).symm
  | ⟨4, _⟩, ⟨1, _⟩ => (dis1_4 e f M t r q h z hF).symm
  | ⟨4, _⟩, ⟨2, _⟩ => (dis2_4 e f M t r q h z hF).symm
  | ⟨4, _⟩, ⟨3, _⟩ => (dis3_4 e f M t r q h z hF).symm
  | ⟨4, _⟩, ⟨4, _⟩ => absurd rfl hab
  | ⟨4, _⟩, ⟨5, _⟩ => dis4_5 e f M t r q h z hF
  | ⟨5, _⟩, ⟨0, _⟩ => (dis0_5 e f M t r q h z hF).symm
  | ⟨5, _⟩, ⟨1, _⟩ => (dis1_5 e f M t r q h z hF).symm
  | ⟨5, _⟩, ⟨2, _⟩ => (dis2_5 e f M t r q h z hF).symm
  | ⟨5, _⟩, ⟨3, _⟩ => (dis3_5 e f M t r q h z hF).symm
  | ⟨5, _⟩, ⟨4, _⟩ => (dis4_5 e f M t r q h z hF).symm
  | ⟨5, _⟩, ⟨5, _⟩ => absurd rfl hab
  | ⟨k + 6, hk⟩, _ => absurd hk (by omega)
  | _, ⟨k + 6, hk⟩ => absurd hk (by omega)

theorem hsub_all (e f M t r q : ℝ) (h : WP e f M t r q) (z : Sc e f M t r q) (hF : 1 < f / e) : ∀ a : Fin 6, regionOf e f M t r q z a ⊆ (tgtT e f M t r q h hF).carrier := by
  intro a
  rw [tgt_carrier e f M t r q h hF]
  exact match a with
  | ⟨0, _⟩ => sub0 e f M t r q h z
  | ⟨1, _⟩ => sub1 e f M t r q h z
  | ⟨2, _⟩ => sub2 e f M t r q h z
  | ⟨3, _⟩ => sub3 e f M t r q h z
  | ⟨4, _⟩ => sub4 e f M t r q h z
  | ⟨5, _⟩ => sub5 e f M t r q h z
  | ⟨k + 6, hk⟩ => absurd hk (by omega)

theorem sum_cnt_real (e f M t r q : ℝ) (h : WP e f M t r q) (z : Sc e f M t r q) :
    ((∑ a : Fin 6, cntF z a : ℕ) : ℝ) = (2 * f ^ 2 - e ^ 2) * M ^ 2 := by
  have l0 : z.S0 * z.S0 ≤ z.K0 * z.K0 := Nat.mul_le_mul z.lS0 z.lS0
  have l3 : z.S3 * z.S3 ≤ z.K3 * z.K3 := Nat.mul_le_mul z.lS3 z.lS3
  have l5 : z.S5 * z.S5 ≤ z.K5 * z.K5 := Nat.mul_le_mul z.lS5 z.lS5
  have c0 : ((z.K0 * z.K0 - z.S0 * z.S0 : ℕ) : ℝ) = f ^ 2 * M ^ 2 - e ^ 2 * t ^ 2 := by
    rw [Nat.cast_sub l0]; push_cast; rw [z.hK0, z.hS0]; ring
  have c1 : ((z.K1 * z.K1 - 0 * 0 : ℕ) : ℝ) = (f * M - e * r) ^ 2 := by
    rw [Nat.mul_zero, Nat.sub_zero]; push_cast; rw [z.hK1]; ring
  have c2 : ((z.K2 * z.K2 - 0 * 0 : ℕ) : ℝ) = (f * t) ^ 2 := by
    rw [Nat.mul_zero, Nat.sub_zero]; push_cast; rw [z.hK2]; ring
  have c3 : ((z.K3 * z.K3 - z.S3 * z.S3 : ℕ) : ℝ) = (f * (r - t)) ^ 2 - (f * r - e * M) ^ 2 := by
    rw [Nat.cast_sub l3]; push_cast; rw [z.hK3, z.hS3]; ring
  have c4 : ((2 * z.s4 * z.x4 : ℕ) : ℝ) = 2 * (f * (r - t)) * (f * t - e * q) := by
    push_cast; rw [z.hs4, z.hx4]
  have c5 : ((z.K5 * z.K5 - z.S5 * z.S5 : ℕ) : ℝ) = (f * q - e * t) ^ 2 - (f * q - e * r) ^ 2 := by
    rw [Nat.cast_sub l5]; push_cast; rw [z.hK5, z.hS5]; ring
  rw [Fin.sum_univ_six]
  have e0 : cntF z 0 = z.K0 * z.K0 - z.S0 * z.S0 := rfl
  have e1 : cntF z 1 = z.K1 * z.K1 - 0 * 0 := rfl
  have e2 : cntF z 2 = z.K2 * z.K2 - 0 * 0 := rfl
  have e3 : cntF z 3 = z.K3 * z.K3 - z.S3 * z.S3 := rfl
  have e4 : cntF z 4 = 2 * z.s4 * z.x4 := rfl
  have e5 : cntF z 5 = z.K5 * z.K5 - z.S5 * z.S5 := rfl
  rw [e0, e1, e2, e3, e4, e5]
  simp only [Nat.cast_add]
  rw [c0, c1, c2, c3, c4, c5]
  ring

theorem exists_dissection_W (e f M t r q : ℝ) (h : WP e f M t r q) (z : Sc e f M t r q) (hF : 1 < f / e) (hA : 0 < e * f) (hB : 0 < f ^ 2 - e ^ 2) :
    ∃ D : CongruentDissection (∑ a : Fin 6, cntF z a), D.model = (brickL (f / e) hF (e * f) (f ^ 2 - e ^ 2) hA hB) ∧ D.target = tgtT e f M t r q h hF := by
  refine pack_exists' (M := (brickL (f / e) hF (e * f) (f ^ 2 - e ^ 2) hA hB)) (T := tgtT e f M t r q h hF) (regionOf e f M t r q z) (cntF z)
    (famAll e f M t r q h z hF hA hB) (hS_all e f M t r q h z hF) (hsub_all e f M t r q h z hF) ?_
  unfold tgtT
  refine hvol_gen hF (e * f) (f ^ 2 - e ^ 2) hA hB _ _ _ _ _ ?_
  rw [sum_cnt_real e f M t r q h z]
  simp only [pt_B, pt_A]
  ring

