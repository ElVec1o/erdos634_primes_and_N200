-- No sorry, no native_decide, no axioms.
-- Control for the F3 branch of GapR8 and its arithmetic hypothesis NoF3: the F3-shaped tiling of N = 7800
-- (tile (3,5,7)*(2*49); Zhang arXiv:2512.22696).  The certificate is generated by an exact search program and checked in the kernel by
-- G3CCert.Cert.ok assembled from per-cluster facts, see G3NChunk.  It is a `CongruentDissection 7800` meeting every structural
-- premise of the F3 branch of `GapR8` (IrrPi alpha, TwoPiThreeData, F2to4Shape, hence the shape data with nu > 0), and
-- NoF3 is FALSE at 7800.
import Erdos634.Draft.G3NF3Cert
import Erdos634.Draft.G3CAng
import Erdos634.Draft.AllNExclusionArith
import Erdos634.Draft.R8F2to4Bridge

open scoped Classical

namespace Erdos634.Draft.G3NF3Control

open Erdos634.Geometry Erdos634.Draft.G3CCert Erdos634.Draft.TheoremPConditional Erdos634.Draft.Chain15
open Erdos634.Draft.G3CAng
open Erdos634.Draft.G3NF3Cert (cert cert_ok cert_len)
open Erdos634.Draft.FluxPaperWitness (cornerAngle_mem')

noncomputable abbrev D := cd cert cert_ok

theorem N_eq : cert.leaves.length = 7800 := cert_len

theorem m_opp0 : D.model.oppLen 0 = 490 := by
  rw [show D.model = _ from cd_model cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.model (0 + 1)) (vtx cert.model (0 + 2)) 490 (by decide)
  rw [this]; norm_num
theorem m_opp1 : D.model.oppLen 1 = 686 := by
  rw [show D.model = _ from cd_model cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.model (1 + 1)) (vtx cert.model (1 + 2)) 686 (by decide)
  rw [this]; norm_num
theorem m_opp2 : D.model.oppLen 2 = 294 := by
  rw [show D.model = _ from cd_model cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.model (2 + 1)) (vtx cert.model (2 + 2)) 294 (by decide)
  rw [this]; norm_num

theorem t_opp0 : D.target.oppLen 0 = 58800 := by
  rw [show D.target = _ from cd_target cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.target (0 + 1)) (vtx cert.target (0 + 2)) 58800 (by decide)
  rw [this]; norm_num
theorem t_opp1 : D.target.oppLen 1 = 24010 := by
  rw [show D.target = _ from cd_target cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.target (1 + 1)) (vtx cert.target (1 + 2)) 24010 (by decide)
  rw [this]; norm_num
theorem t_opp2 : D.target.oppLen 2 = 44590 := by
  rw [show D.target = _ from cd_target cert cert_ok, oppLen_triOf]
  have := dist_toPt_nat (vtx cert.target (2 + 1)) (vtx cert.target (2 + 2)) 44590 (by decide)
  rw [this]; norm_num

/-- vertex presentation: sigma sends (a,b,c) = (3,5,7) to the vertices opposite 294, 490, 686, i.e. (2, 0, 1) -/
def σm : Equiv.Perm (Fin 3) := ⟨![2, 0, 1], ![1, 2, 0], by decide, by decide⟩
theorem σm0 : σm 0 = 2 := rfl
theorem σm1 : σm 1 = 0 := rfl
theorem σm2 : σm 2 = 1 := rfl

noncomputable def α : ℝ := D.model.angleAt (σm 0)
noncomputable def β : ℝ := D.model.angleAt (σm 1)

theorem o0 : D.model.oppLen (σm 0) = 98 * 3 := by rw [σm0, m_opp2]; norm_num
theorem o1 : D.model.oppLen (σm 1) = 98 * 5 := by rw [σm1, m_opp0]; norm_num
theorem o2 : D.model.oppLen (σm 2) = 98 * 7 := by rw [σm2, m_opp1]; norm_num

theorem data : D.model.TwoPiThreeData α (98 * 3) (98 * 5) (98 * 7) :=
  tp_data D.model σm 98 3 5 7 (by norm_num) (by norm_num) (by norm_num) (by norm_num) o0 o1 o2

theorem hβ : β = Real.pi / 3 - α :=
  (tp_angles D.model σm 98 3 5 7 (by norm_num) (by norm_num) (by norm_num) (by norm_num) o0 o1 o2).2

theorem cos_α : Real.cos α = 13 / 14 := by
  unfold α
  rw [cos_s0 D.model σm (by rw [o1]; norm_num) (by rw [o2]; norm_num), o0, o1, o2]; norm_num

theorem cos_β : Real.cos β = 11 / 14 := by
  unfold β
  rw [cos_s1 D.model σm (by rw [o0]; norm_num) (by rw [o2]; norm_num), o0, o1, o2]; norm_num

theorem α_irr : IrrPi α :=
  irrPi_of_cos α (13 / 14) (by rw [cos_α]; norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num)

theorem α_nn : 0 ≤ α := (cornerAngle_mem' _ _ _ : 0 ≤ D.model.angleAt (σm 0) ∧ _).1
theorem β_nn : 0 ≤ β := (cornerAngle_mem' _ _ _ : 0 ≤ D.model.angleAt (σm 1) ∧ _).1

theorem lt_half_of_cos_pos {x : ℝ} (hx : x ≤ Real.pi) (hc : 0 < Real.cos x) : x < Real.pi / 2 := by
  by_contra h
  push Not at h
  have := Real.cos_nonpos_of_pi_div_two_le_of_le h (by linarith [hx, Real.pi_pos])
  linarith

theorem α_lt : α < Real.pi / 2 :=
  lt_half_of_cos_pos (cornerAngle_mem' _ _ _ : _ ∧ D.model.angleAt (σm 0) ≤ Real.pi).2 (by rw [cos_α]; norm_num)
theorem β_lt : β < Real.pi / 2 :=
  lt_half_of_cos_pos (cornerAngle_mem' _ _ _ : _ ∧ D.model.angleAt (σm 1) ≤ Real.pi).2 (by rw [cos_β]; norm_num)


/-- target vertex cosines -/
theorem t_cos0 : Real.cos (D.target.angleAt 0) = -143 / 343 := by
  have := cos_s0 D.target 1 (by simp [t_opp1]) (by simp [t_opp2])
  simp only [Equiv.Perm.coe_one, id_eq] at this
  rw [this, t_opp0, t_opp1, t_opp2]; norm_num
theorem t_cos1 : Real.cos (D.target.angleAt 1) = 13 / 14 := by
  have := cos_s1 D.target 1 (by simp [t_opp0]) (by simp [t_opp2])
  simp only [Equiv.Perm.coe_one, id_eq] at this
  rw [this, t_opp0, t_opp1, t_opp2]; norm_num
theorem t_cos2 : Real.cos (D.target.angleAt 2) = 71 / 98 := by
  have := cos_s2 D.target 1 (by simp [t_opp0]) (by simp [t_opp1])
  simp only [Equiv.Perm.coe_one, id_eq] at this
  rw [this, t_opp0, t_opp1, t_opp2]; norm_num

/-- target vertices: 0 ~ 3β, 1 ~ α, 2 ~ 2α ; σt lists them in the order of the shape (α, 2α, 3β) -/
def σt : Equiv.Perm (Fin 3) := ⟨![1, 2, 0], ![2, 0, 1], by decide, by decide⟩

theorem hα3 : Real.cos (3 * α) = 143 / 343 := by
  rw [Real.cos_three_mul, cos_α]; norm_num
theorem hβ3 : Real.cos (3 * β) = -143 / 343 := by
  rw [Real.cos_three_mul, cos_β]; norm_num
theorem hα2 : Real.cos (2 * α) = 71 / 98 := by rw [Real.cos_two_mul, cos_α]; norm_num
theorem hβ2 : Real.cos (2 * β) = 23 / 98 := by rw [Real.cos_two_mul, cos_β]; norm_num

theorem α3_ok : 0 ≤ 3 * α ∧ 3 * α ≤ Real.pi := by
  have := β_nn; have h := hβ; have := α_nn; have := Real.pi_pos
  constructor <;> linarith
theorem β3_ok : 0 ≤ 3 * β ∧ 3 * β ≤ Real.pi := by
  have := β_nn; have h := hβ; have := α_nn; have := Real.pi_pos
  constructor <;> linarith
theorem α2_ok : 0 ≤ 2 * α ∧ 2 * α ≤ Real.pi := by
  have := α_lt; have := α_nn; constructor <;> linarith
theorem β2_ok : 0 ≤ 2 * β ∧ 2 * β ≤ Real.pi := by
  have := β_lt; have := β_nn; constructor <;> linarith

theorem t_angV1 : D.target.angleAt 1 = α := angle_eq_of_cos 1 (σm 0) (t_cos1.trans cos_α.symm)
theorem t_angV2 : D.target.angleAt 2 = 2 * α :=
  Real.injOn_cos (cornerAngle_mem' _ _ _) α2_ok (t_cos2.trans hα2.symm)
theorem t_angV0 : D.target.angleAt 0 = 3 * (Real.pi / 3 - α) := by
  rw [← hβ]
  exact Real.injOn_cos (cornerAngle_mem' _ _ _) β3_ok (t_cos0.trans hβ3.symm)

theorem f3_tgt : TgtAngles D α (2 * α) (3 * (Real.pi / 3 - α)) :=
  ⟨σt, t_angV1, t_angV2, t_angV0⟩

/-- **F3 shape** -/
theorem f3_shape : F2to4Shape D α := Or.inr (Or.inl f3_tgt)

theorem premises : IrrPi α ∧ D.model.TwoPiThreeData α (98 * 3) (98 * 5) (98 * 7) ∧ F2to4Shape D α :=
  ⟨α_irr, data, f3_shape⟩

theorem not_gapR8_7800 : ¬ GapR8 7800 := by
  intro g
  have h : cert.leaves.length = 7800 := cert_len
  rw [← h] at g
  exact g D α _ _ _ α_irr data f3_shape

/-- the NoF3 hypothesis of the F3/F3' leaf is FALSE at 7800: (s, j) = (55, 25), 4N = 3 (s+j)(s+3j) -/
theorem not_noF3_7800 : ¬ Erdos634.Draft.R8Gen2.NoF3 7800 := by
  intro h
  exact h 55 25 (by norm_num) (by norm_num) (by norm_num)

theorem not_all_r8_7800 :
    ¬ (Erdos634.Draft.R8Gen2.NoF2 7800 ∧ Erdos634.Draft.R8Gen2.NoF3 7800 ∧ Erdos634.Draft.R8Gen2.NoF4z 7800) :=
  fun ⟨a, b, c⟩ => not_gapR8_7800 (Erdos634.Draft.R8Gen2.gapR8_of_arith2 7800 a b c)

theorem f3_leaf_witness :
    (∃ (N : ℕ) (D : CongruentDissection N) (α a b c : ℝ), IrrPi α ∧ D.model.TwoPiThreeData α a b c ∧
      F2to4Shape D α ∧ 0 < a ∧ 0 < b ∧ N = 7800) ∧ ¬ Erdos634.Draft.R8Gen2.NoF3 7800 :=
  ⟨⟨_, D, α, _, _, _, α_irr, data, f3_shape, by norm_num, by norm_num, cert_len⟩, not_noF3_7800⟩

end Erdos634.Draft.G3NF3Control

#print axioms Erdos634.Draft.G3NF3Control.premises
#print axioms Erdos634.Draft.G3NF3Control.not_gapR8_7800
#print axioms Erdos634.Draft.G3NF3Control.not_noF3_7800
#print axioms Erdos634.Draft.G3NF3Control.not_all_r8_7800
#print axioms Erdos634.Draft.G3NF3Control.f3_leaf_witness
