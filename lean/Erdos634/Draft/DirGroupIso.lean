/-
Draft/DirGroupIso.lean: the group clause of the direction group statement: `ℤ² / ⟨(p, q)⟩ ≅ ℤ ⊕ ℤ/d`.

For `(p, q) = d (p', q')` with `gcd(p', q') = 1` and `d ≥ 1`:

* `quotEquiv`: `(ℤ × ℤ) ⧸ ⟨(d p', d q')⟩ ≃+ ℤ × ZMod d`, by `(x, y) ↦ (q' x − p' y, u x + v y mod d)` with
  `u p' + v q' = 1`;
* `range_equiv`: for any homomorphism `χ : ℤ × ℤ →+ A` whose kernel is generated by `(d p', d q')`, the image of
  `χ` is isomorphic to `ℤ × ZMod d`.  With `A = ℝ/πℤ` and `χ (x, y) = x α + y β` the image is `⟨α, β⟩` and the kernel
  is the relation lattice `Λ`.

* `label_ker`, `label_surjective`: the label `L (x, y) = q' x − p' y` is onto `ℤ` with kernel `ℤ (p', q')`;
* `dirgroup_iso`: the instance `A = ℝ/πℤ`, `χ (x, y) = x α + y β`.

Algebra only.  No sorry, no native_decide.
-/
import Mathlib

namespace Erdos634.Draft.DirGroupIso

/-- `(x, y) ↦ (q' x − p' y, u x + v y mod d)` -/
noncomputable def psi (p' q' u v : ℤ) (d : ℕ) : ℤ × ℤ →+ ℤ × ZMod d :=
  ((zmultiplesHom ℤ q').coprod (zmultiplesHom ℤ (-p'))).prod
    ((Int.castAddHom (ZMod d)).comp ((zmultiplesHom ℤ u).coprod (zmultiplesHom ℤ v)))

theorem psi_apply (p' q' u v : ℤ) (d : ℕ) (x y : ℤ) :
    psi p' q' u v d (x, y) = (q' * x - p' * y, ((u * x + v * y : ℤ) : ZMod d)) := by
  simp only [psi, AddMonoidHom.prod_apply, AddMonoidHom.coprod_apply, AddMonoidHom.comp_apply,
    zmultiplesHom_apply, smul_eq_mul, Int.coe_castAddHom]
  refine Prod.ext ?_ ?_
  · show x * q' + y * -p' = q' * x - p' * y
    ring
  · show ((x * u + y * v : ℤ) : ZMod d) = ((u * x + v * y : ℤ) : ZMod d)
    congr 1; ring

theorem psi_surjective {p' q' u v : ℤ} (huv : u * p' + v * q' = 1) (d : ℕ) :
    Function.Surjective (psi p' q' u v d) := by
  rintro ⟨n, r⟩
  obtain ⟨r', hr'⟩ := ZMod.intCast_surjective r
  refine ⟨(n * v + r' * p', -(n * u) + r' * q'), ?_⟩
  rw [psi_apply]
  refine Prod.ext ?_ ?_
  · show q' * (n * v + r' * p') - p' * (-(n * u) + r' * q') = n
    linear_combination n * huv
  · show ((u * (n * v + r' * p') + v * (-(n * u) + r' * q') : ℤ) : ZMod d) = r
    rw [← hr']
    congr 1
    linear_combination r' * huv

theorem psi_ker {p' q' u v : ℤ} (huv : u * p' + v * q' = 1) (d : ℕ) [NeZero d] :
    (psi p' q' u v d).ker = AddSubgroup.zmultiples ((d * p', d * q') : ℤ × ℤ) := by
  ext ⟨x, y⟩
  rw [AddMonoidHom.mem_ker, psi_apply, AddSubgroup.mem_zmultiples_iff]
  constructor
  · intro h
    have h1 : q' * x - p' * y = 0 := congrArg Prod.fst h
    have h2 : ((u * x + v * y : ℤ) : ZMod d) = 0 := congrArg Prod.snd h
    have hx : x = p' * (u * x + v * y) := by linear_combination (-x) * huv + v * h1
    have hy : y = q' * (u * x + v * y) := by linear_combination (-y) * huv - u * h1
    obtain ⟨s, hs⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd _ d).mp h2
    refine ⟨s, ?_⟩
    refine Prod.ext ?_ ?_
    · show s • ((d : ℤ) * p') = x
      rw [smul_eq_mul, hx, hs]; ring
    · show s • ((d : ℤ) * q') = y
      rw [smul_eq_mul, hy, hs]; ring
  · rintro ⟨s, hs⟩
    have hx : x = s * (d * p') := by
      have := congrArg Prod.fst hs
      simpa [smul_eq_mul] using this.symm
    have hy : y = s * (d * q') := by
      have := congrArg Prod.snd hs
      simpa [smul_eq_mul] using this.symm
    refine Prod.ext ?_ ?_
    · show q' * x - p' * y = 0
      rw [hx, hy]; ring
    · show ((u * x + v * y : ℤ) : ZMod d) = 0
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      exact ⟨s, by rw [hx, hy]; linear_combination (s * d) * huv⟩

/-- **`ℤ² / ⟨d (p', q')⟩ ≅ ℤ ⊕ ℤ/d`** for coprime `p', q'` and `d ≥ 1`. -/
noncomputable def quotEquiv {p' q' u v : ℤ} (huv : u * p' + v * q' = 1) (d : ℕ) [NeZero d] :
    (ℤ × ℤ) ⧸ AddSubgroup.zmultiples ((d * p', d * q') : ℤ × ℤ) ≃+ ℤ × ZMod d :=
  (QuotientAddGroup.quotientAddEquivOfEq (psi_ker huv d).symm).trans
    (QuotientAddGroup.quotientKerEquivOfSurjective (psi p' q' u v d) (psi_surjective huv d))

/-- the image of a homomorphism of `ℤ²` whose kernel is `⟨d (p', q')⟩` is isomorphic to `ℤ ⊕ ℤ/d` -/
theorem range_equiv {A : Type*} [AddCommGroup A] (χ : ℤ × ℤ →+ A) {p' q' : ℤ} (h : IsCoprime p' q')
    (d : ℕ) [NeZero d] (hker : χ.ker = AddSubgroup.zmultiples ((d * p', d * q') : ℤ × ℤ)) :
    Nonempty (χ.range ≃+ ℤ × ZMod d) := by
  obtain ⟨u, v, huv⟩ := h
  exact ⟨(QuotientAddGroup.quotientKerEquivRange χ).symm.trans
    ((QuotientAddGroup.quotientAddEquivOfEq hker).trans (quotEquiv huv d))⟩

/-- the label `L (x, y) = q' x − p' y` of a primitive vector vanishes exactly on its multiples (no condition
`p' ≠ 0`) -/
theorem label_ker {p' q' : ℤ} (h : IsCoprime p' q') (x y : ℤ) :
    q' * x - p' * y = 0 ↔ ∃ k : ℤ, x = p' * k ∧ y = q' * k := by
  obtain ⟨u, v, huv⟩ := h
  constructor
  · intro h1
    exact ⟨u * x + v * y, by linear_combination (-x) * huv + v * h1,
      by linear_combination (-y) * huv - u * h1⟩
  · rintro ⟨k, rfl, rfl⟩
    ring

/-- the label is onto `ℤ` -/
theorem label_surjective {p' q' : ℤ} (h : IsCoprime p' q') (n : ℤ) : ∃ x y : ℤ, q' * x - p' * y = n := by
  obtain ⟨u, v, huv⟩ := h
  exact ⟨n * v, -(n * u), by linear_combination n * huv⟩

/-- `(x, y) ↦ x α + y β` in `ℝ/πℤ` -/
noncomputable def chi (α β : ℝ) : ℤ × ℤ →+ ℝ ⧸ AddSubgroup.zmultiples Real.pi :=
  (QuotientAddGroup.mk' (AddSubgroup.zmultiples Real.pi)).comp
    ((zmultiplesHom ℝ α).coprod (zmultiplesHom ℝ β))

theorem chi_eq_zero_iff (α β : ℝ) (x y : ℤ) :
    chi α β (x, y) = 0 ↔ ∃ n : ℤ, n • Real.pi = x • α + y • β := by
  show (QuotientAddGroup.mk' (AddSubgroup.zmultiples Real.pi))
      (((zmultiplesHom ℝ α).coprod (zmultiplesHom ℝ β)) (x, y)) = 0 ↔ _
  rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff, AddSubgroup.mem_zmultiples_iff]
  simp only [AddMonoidHom.coprod_apply, zmultiplesHom_apply]

/-- **`prop:dirgroup`, group clause.**  If the relation lattice `Λ = {(x, y) : x α + y β ∈ πℤ}` is generated by
`(p, q) = d (p', q')` with `gcd(p', q') = 1`, `d ≥ 1`, then the group `⟨α, β⟩ ⊂ ℝ/πℤ` is isomorphic to
`ℤ ⊕ ℤ/d`. -/
theorem dirgroup_iso (α β : ℝ) {p' q' : ℤ} (h : IsCoprime p' q') (d : ℕ) [NeZero d]
    (hΛ : ∀ x y : ℤ, (∃ n : ℤ, n • Real.pi = x • α + y • β) ↔
      ∃ s : ℤ, s • ((d * p', d * q') : ℤ × ℤ) = (x, y)) :
    Nonempty ((chi α β).range ≃+ ℤ × ZMod d) := by
  apply range_equiv (chi α β) h d
  ext ⟨x, y⟩
  rw [AddMonoidHom.mem_ker, AddSubgroup.mem_zmultiples_iff, ← hΛ, chi_eq_zero_iff]

end Erdos634.Draft.DirGroupIso

#print axioms Erdos634.Draft.DirGroupIso.dirgroup_iso
