import Erdos634.BaseBetaTargetCoord

/-!
# The corner lattice of the base-`β` target and its `b`-direction lines

The coordinate clauses concerning the corner lattice `ℤ(a,0) + ℤ·c·u` of the left base corner are
not statements about a tiling: where a `b`-direction line of the lattice meets the base and the left
side, its distance to the side at each row, its length, and which of these lines ends at the apex.
Here they are stated in the coordinates of `BaseBetaTargetCoord.baseBetaTarget e f` (base from
`(0,0)` to `(L,0)`, apex `(L/2, H)`), for every real `0 < e < f`; the case of interest is `e = 1`.

* `lat e f i j` is the lattice vertex `i·(a,0) + j·c·u`, with `a = e f` and `c·u = sideA e f`.
* `bline e f i j t` is the point at parameter `t` of the line through `lat e f i j` with direction
  `c·u − (a,0)`, the direction of the `b`-edge of the corner tile (`bline_eq`, `dist_b_edge`).

Results (with `k = i + j`):

* `bline_base`, `bline_base_unique` : the line meets the base line `y = 0` at `(k·a, 0)` and
  nowhere else;
* `bline_side`, `bline_side_unique` : it meets the line of the left side at `k·c·u` and nowhere
  else;
* `bline_row`, `row_distance` : at row `r` it passes through `(k−r)(a,0) + r·c·u`, at horizontal
  distance `|k−r|·a` from the side point `r·c·u`;
* `lattice_triangle` : the triangle on `(i, j+1)`, `(i, j)`, `(i+1, j)` has sides `c`, `b`, `a`;
* `bline_length` : the stretch between the two boundary points has length `|k|·b`,
  `b = f² − e²`;
* `side_point`, `side_point_mem`, `base_point_mem` : `k·c·u = (k/f)·apex`; for `0 ≤ k ≤ f` both ends
  are on the boundary of the target;
* `k_le_f` : `k·c ≤ f³` forces `k ≤ f`;
* `apex_line` : the line `k = f` runs from `(f·a, 0)` to the apex.

No statement here is about a tiling.  Standard axioms, no `sorry`.
-/

namespace Erdos634.Draft.ColumnLinesGeom

open Erdos634 Erdos634.Geometry Erdos634.CertCoord Erdos634.BaseBetaTargetCoord

theorem plane_ext {u w : Plane} (h0 : u 0 = w 0) (h1 : u 1 = w 1) : u = w := by
  ext i; fin_cases i <;> simpa

/-- The vertex `i·(a,0) + j·c·u` of the corner lattice of the left base corner
(`a = e f`, `c·u = sideA e f`). -/
noncomputable def lat (e f i j : ℝ) : Plane :=
  mkPt (i * (e * f) + j * (sideA e f).1) (j * (sideA e f).2)

theorem lat_zero (e f i j : ℝ) : (lat e f i j) 0 = i * (e * f) + j * (sideA e f).1 := by
  simp [lat]

theorem lat_one (e f i j : ℝ) : (lat e f i j) 1 = j * (sideA e f).2 := by
  simp [lat]

/-- The point at parameter `t` of the `b`-direction line through `lat e f i j`. -/
noncomputable def bline (e f i j t : ℝ) : Plane := lat e f (i - t) (j + t)

/-- `bline` is the line through `lat e f i j` with direction `c·u − (a,0)`. -/
theorem bline_eq (e f i j t : ℝ) :
    bline e f i j t = lat e f i j + t • (lat e f 0 1 - lat e f 1 0) := by
  apply plane_ext <;> simp [bline, lat] <;> ring

/-- The lattice is the lattice generated by `(a,0)` and `c·u`. -/
theorem lat_eq (e f i j : ℝ) :
    lat e f i j = i • mkPt (e * f) 0 + j • mkPt (sideA e f).1 (sideA e f).2 := by
  apply plane_ext <;> simp [lat]

theorem sideA_snd_pos {e f : ℝ} (he : 0 < e) (hef : e < f) : 0 < (sideA e f).2 := by
  have hf : 0 < f := lt_trans he hef
  have hH := height_pos he hef
  unfold sideA; positivity

/-- `|c·u| = c = f²`. -/
theorem dist_c_edge {e f : ℝ} (he : 0 < e) (hef : e < f) :
    dist (lat e f 0 0) (lat e f 0 1) = f ^ 2 := by
  have hf : 0 < f := lt_trans he hef
  have hD : Real.sqrt (Dr e f) ^ 2 = 4 * f ^ 2 - e ^ 2 := sq_sqrtD he hef
  have hsq : dist (lat e f 0 0) (lat e f 0 1) ^ 2 = (f ^ 2) ^ 2 := by
    unfold lat sideA
    rw [dist_sq_mkPt]
    unfold height baseLen Nq
    field_simp
    linear_combination (f ^ 2 - e ^ 2) ^ 2 * hD
  have hnn : 0 ≤ dist (lat e f 0 0) (lat e f 0 1) := dist_nonneg
  have hp : 0 < f ^ 2 := by positivity
  nlinarith [hsq, hnn, hp]

/-- The squared length of the direction vector: `|c·u − (a,0)|² = (f² − e²)²`. -/
theorem dir_sq {e f : ℝ} (he : 0 < e) (hef : e < f) :
    ((sideA e f).1 - e * f) ^ 2 + (sideA e f).2 ^ 2 = (f ^ 2 - e ^ 2) ^ 2 := by
  have hf : 0 < f := lt_trans he hef
  have hD : Real.sqrt (Dr e f) ^ 2 = 4 * f ^ 2 - e ^ 2 := sq_sqrtD he hef
  unfold sideA
  simp only
  unfold height baseLen Nq
  field_simp
  linear_combination (f ^ 2 - e ^ 2) ^ 2 * hD

/-- `|c·u − (a,0)| = b = f² − e²`: the direction is that of the `b`-edge of the corner tile. -/
theorem dist_b_edge {e f : ℝ} (he : 0 < e) (hef : e < f) :
    dist (lat e f 1 0) (lat e f 0 1) = f ^ 2 - e ^ 2 := by
  have hb : 0 < f ^ 2 - e ^ 2 := by nlinarith
  have hsq : dist (lat e f 1 0) (lat e f 0 1) ^ 2 = (f ^ 2 - e ^ 2) ^ 2 := by
    unfold lat
    rw [dist_sq_mkPt, ← dir_sq he hef]
    ring
  have hnn : 0 ≤ dist (lat e f 1 0) (lat e f 0 1) := dist_nonneg
  nlinarith [hsq, hnn, hb]

/-- `|(a,0)| = a = e f`, at any lattice vertex. -/
theorem dist_a_edge {e f : ℝ} (he : 0 < e) (hef : e < f) (i j : ℝ) :
    dist (lat e f i j) (lat e f (i + 1) j) = e * f := by
  have hf : 0 < f := lt_trans he hef
  have ha : 0 < e * f := mul_pos he hf
  have hsq : dist (lat e f i j) (lat e f (i + 1) j) ^ 2 = (e * f) ^ 2 := by
    unfold lat
    rw [dist_sq_mkPt]
    ring
  have hnn : 0 ≤ dist (lat e f i j) (lat e f (i + 1) j) := dist_nonneg
  nlinarith [hsq, hnn, ha]

/-- **The lattice triangle** (`lem:filler`, first clause): the triangle on the vertex `J = (i, j+1)`
and the two consecutive vertices `(i, j)`, `(i+1, j)` of the row below has sides exactly
`c = f²`, `b = f² − e²`, `a = e f`. -/
theorem lattice_triangle {e f : ℝ} (he : 0 < e) (hef : e < f) (i j : ℝ) :
    dist (lat e f i (j + 1)) (lat e f i j) = f ^ 2 ∧
    dist (lat e f i (j + 1)) (lat e f (i + 1) j) = f ^ 2 - e ^ 2 ∧
    dist (lat e f i j) (lat e f (i + 1) j) = e * f := by
  have hb : 0 < f ^ 2 - e ^ 2 := by nlinarith
  have hp : (0:ℝ) < f ^ 2 := by nlinarith
  have hsq := dir_sq he hef
  have hc := dist_c_edge he hef
  have hc2 : (sideA e f).1 ^ 2 + (sideA e f).2 ^ 2 = (f ^ 2) ^ 2 := by
    have h := congrArg (fun x : ℝ => x ^ 2) hc
    simp only at h
    unfold lat at h
    rw [dist_sq_mkPt] at h
    rw [← h]; ring
  refine ⟨?_, ?_, dist_a_edge he hef i j⟩
  · have h2 : dist (lat e f i (j + 1)) (lat e f i j) ^ 2 = (f ^ 2) ^ 2 := by
      unfold lat
      rw [dist_sq_mkPt, ← hc2]; ring
    have hnn : 0 ≤ dist (lat e f i (j + 1)) (lat e f i j) := dist_nonneg
    nlinarith [h2, hnn, hp]
  · have h2 : dist (lat e f i (j + 1)) (lat e f (i + 1) j) ^ 2 = (f ^ 2 - e ^ 2) ^ 2 := by
      unfold lat
      rw [dist_sq_mkPt, ← hsq]; ring
    have hnn : 0 ≤ dist (lat e f i (j + 1)) (lat e f (i + 1) j) := dist_nonneg
    nlinarith [h2, hnn, hb]

/-- **The line meets the base line at `(k·a, 0)`**, `k = i + j`. -/
theorem bline_base (e f i j : ℝ) : bline e f i j (-j) = mkPt ((i + j) * (e * f)) 0 := by
  apply plane_ext
  · rw [bline, lat_zero, mkPt_zero]; ring
  · rw [bline, lat_one, mkPt_one]; ring

/-- **…and nowhere else.** -/
theorem bline_base_unique {e f : ℝ} (he : 0 < e) (hef : e < f) {i j t : ℝ}
    (h : (bline e f i j t) 1 = 0) : t = -j := by
  have hY := sideA_snd_pos he hef
  have h' : (j + t) * (sideA e f).2 = 0 := by rw [bline, lat_one] at h; exact h
  rcases mul_eq_zero.mp h' with h0 | h0
  · linarith
  · exact absurd h0 hY.ne'

/-- **The line meets the line of the left side at `k·c·u`**, `k = i + j`. -/
theorem bline_side (e f i j : ℝ) : bline e f i j i = lat e f 0 (i + j) := by
  apply plane_ext
  · rw [bline, lat_zero, lat_zero]; ring
  · rw [bline, lat_one, lat_one]; ring

/-- **…and nowhere else.** -/
theorem bline_side_unique {e f : ℝ} (he : 0 < e) (hef : e < f) {i j t s : ℝ}
    (h : bline e f i j t = lat e f 0 s) : t = i ∧ s = i + j := by
  have hf : 0 < f := lt_trans he hef
  have hY := sideA_snd_pos he hef
  have h0 := congrArg (fun p : Plane => p 0) h
  have h1 := congrArg (fun p : Plane => p 1) h
  simp only [bline, lat_zero, lat_one] at h0 h1
  have hs : j + t = s := mul_right_cancel₀ hY.ne' h1
  have h2 : (i - t) * (e * f) = 0 := by
    have : (i - t) * (e * f) + (j + t) * (sideA e f).1 = s * (sideA e f).1 := by linarith
    rw [hs] at this; linarith
  have hef0 : e * f ≠ 0 := (mul_pos he hf).ne'
  have hit : i - t = 0 := (mul_eq_zero.mp h2).resolve_right hef0
  exact ⟨by linarith, by linarith⟩

/-- **At row `r` the line passes through `(k−r)(a,0) + r·c·u`.** -/
theorem bline_row (e f i j r : ℝ) : bline e f i j (r - j) = lat e f (i + j - r) r := by
  apply plane_ext
  · rw [bline, lat_zero, lat_zero]; ring
  · rw [bline, lat_one, lat_one]; ring

/-- **Its horizontal distance to the side at row `r` is `|k − r|·a`.** -/
theorem row_distance {e f : ℝ} (he : 0 < e) (hef : e < f) (k r : ℝ) :
    dist (lat e f (k - r) r) (lat e f 0 r) = |k - r| * (e * f) ∧
      (lat e f (k - r) r) 1 = (lat e f 0 r) 1 := by
  have hf : 0 < f := lt_trans he hef
  have ha : 0 < e * f := mul_pos he hf
  refine ⟨?_, by rw [lat_one, lat_one]⟩
  have hsq : dist (lat e f (k - r) r) (lat e f 0 r) ^ 2 = (|k - r| * (e * f)) ^ 2 := by
    unfold lat
    rw [dist_sq_mkPt, mul_pow, sq_abs]
    ring
  have hnn : 0 ≤ dist (lat e f (k - r) r) (lat e f 0 r) := dist_nonneg
  have hr : 0 ≤ |k - r| * (e * f) := mul_nonneg (abs_nonneg _) ha.le
  nlinarith [hsq, hnn, hr, sq_nonneg (dist (lat e f (k - r) r) (lat e f 0 r) - |k - r| * (e * f))]

/-- **The stretch between its two boundary points has length `|k|·b`.** -/
theorem bline_length {e f : ℝ} (he : 0 < e) (hef : e < f) (k : ℝ) :
    dist (mkPt (k * (e * f)) 0) (lat e f 0 k) = |k| * (f ^ 2 - e ^ 2) := by
  have hb : 0 < f ^ 2 - e ^ 2 := by nlinarith
  have hsq : dist (mkPt (k * (e * f)) 0) (lat e f 0 k) ^ 2 = (|k| * (f ^ 2 - e ^ 2)) ^ 2 := by
    unfold lat
    rw [dist_sq_mkPt, mul_pow, sq_abs, ← dir_sq he hef]
    ring
  have hnn : 0 ≤ dist (mkPt (k * (e * f)) 0) (lat e f 0 k) := dist_nonneg
  have hr : 0 ≤ |k| * (f ^ 2 - e ^ 2) := mul_nonneg (abs_nonneg _) hb.le
  nlinarith [hsq, hnn, hr,
    sq_nonneg (dist (mkPt (k * (e * f)) 0) (lat e f 0 k) - |k| * (f ^ 2 - e ^ 2))]

/-- `k·c·u = (k/f)·apex`. -/
theorem side_point {e f : ℝ} (he : 0 < e) (hef : e < f) (k : ℝ) :
    lat e f 0 k = (k / f) • (baseBetaTarget e f he hef).pts 2 := by
  have hf : 0 < f := lt_trans he hef
  apply plane_ext <;> simp [lat, sideA] <;> field_simp

/-- For `0 ≤ k ≤ f` the point `k·c·u` is on the left side of the target. -/
theorem side_point_mem {e f : ℝ} (he : 0 < e) (hef : e < f) {k : ℝ} (hk0 : 0 ≤ k) (hkf : k ≤ f) :
    lat e f 0 k ∈ segment ℝ ((baseBetaTarget e f he hef).pts 0) ((baseBetaTarget e f he hef).pts 2) := by
  have hf : 0 < f := lt_trans he hef
  refine ⟨1 - k / f, k / f, ?_, by positivity, by ring, ?_⟩
  · rw [sub_nonneg, div_le_one hf]; exact hkf
  · rw [side_point he hef]
    have h0 : (baseBetaTarget e f he hef).pts 0 = 0 := by
      apply plane_ext <;> simp
    rw [h0, smul_zero, zero_add]

/-- For `0 ≤ x ≤ L` the point `(x, 0)` is on the base of the target. -/
theorem base_point_mem {e f : ℝ} (he : 0 < e) (hef : e < f) {x : ℝ} (hx0 : 0 ≤ x)
    (hxL : x ≤ baseLen e f) :
    mkPt x 0 ∈ segment ℝ ((baseBetaTarget e f he hef).pts 0) ((baseBetaTarget e f he hef).pts 1) := by
  have hL := baseLen_pos he hef
  refine ⟨1 - x / baseLen e f, x / baseLen e f, ?_, by positivity, by ring, ?_⟩
  · rw [sub_nonneg, div_le_one hL]; exact hxL
  · apply plane_ext <;> simp
    field_simp

/-- The base point `(k·a, 0)` of a line with `0 ≤ k ≤ f` is on the base (`f·a = e f² ≤ L`). -/
theorem base_end_mem {e f : ℝ} (he : 0 < e) (hef : e < f) {k : ℝ} (hk0 : 0 ≤ k) (hkf : k ≤ f) :
    mkPt (k * (e * f)) 0 ∈
      segment ℝ ((baseBetaTarget e f he hef).pts 0) ((baseBetaTarget e f he hef).pts 1) := by
  have hf : 0 < f := lt_trans he hef
  apply base_point_mem he hef (by positivity)
  unfold baseLen Nq
  have h1 : k * (e * f) ≤ f * (e * f) := mul_le_mul_of_nonneg_right hkf (by positivity)
  have h2 : e ^ 2 < f ^ 2 := by nlinarith
  nlinarith [mul_pos he hf, mul_pos he (mul_pos hf hf)]

/-- `k·c ≤ f³` forces `k ≤ f` (`c = f²`). -/
theorem k_le_f {f k : ℝ} (hf : 0 < f) (h : k * f ^ 2 ≤ f ^ 3) : k ≤ f := by
  have h2 : 0 < f ^ 2 := by positivity
  have : k * f ^ 2 ≤ f * f ^ 2 := by nlinarith
  exact le_of_mul_le_mul_right this h2

/-- **The line `k = f` runs from `(f·a, 0)` to the apex.** -/
theorem apex_line {e f : ℝ} (he : 0 < e) (hef : e < f) :
    lat e f 0 f = (baseBetaTarget e f he hef).pts 2 ∧
      ∀ i j : ℝ, i + j = f →
        bline e f i j (-j) = mkPt (f * (e * f)) 0 ∧
        bline e f i j i = (baseBetaTarget e f he hef).pts 2 := by
  have hf : 0 < f := lt_trans he hef
  have h1 : lat e f 0 f = (baseBetaTarget e f he hef).pts 2 := by
    rw [side_point he hef, div_self hf.ne', one_smul]
  refine ⟨h1, fun i j hij => ⟨?_, ?_⟩⟩
  · rw [bline_base, hij]
  · rw [bline_side, hij, h1]

/-- **The paper's case, in one statement** (`e = 1`, tile `(f, f² − 1, f²)`): the `b`-direction
line through the lattice vertex `(i, j)` meets the base exactly at `(k f, 0)` and the left side
exactly at `k·c·u`, `k = i + j`; the stretch between has length `|k|(f² − 1)`; at row `r` it is at
horizontal distance `|k − r|·f` from the side. -/
theorem columnlines_coordinates {f : ℝ} (hf : 1 < f) (i j : ℝ) :
    bline 1 f i j (-j) = mkPt ((i + j) * f) 0 ∧
    (∀ t, (bline 1 f i j t) 1 = 0 → t = -j) ∧
    bline 1 f i j i = lat 1 f 0 (i + j) ∧
    (∀ t s, bline 1 f i j t = lat 1 f 0 s → t = i ∧ s = i + j) ∧
    dist (mkPt ((i + j) * f) 0) (lat 1 f 0 (i + j)) = |i + j| * (f ^ 2 - 1) ∧
    ∀ r, bline 1 f i j (r - j) = lat 1 f (i + j - r) r ∧
      dist (lat 1 f (i + j - r) r) (lat 1 f 0 r) = |i + j - r| * f := by
  have he : (0:ℝ) < 1 := one_pos
  refine ⟨?_, fun t ht => bline_base_unique he hf ht, bline_side 1 f i j,
    fun t s h => bline_side_unique he hf h, ?_, fun r => ⟨bline_row 1 f i j r, ?_⟩⟩
  · rw [bline_base, one_mul]
  · have := bline_length he hf (i + j)
    simpa using this
  · have := (row_distance he hf (i + j) r).1
    simpa using this

end Erdos634.Draft.ColumnLinesGeom
