theorem at_a01 {x y : ℝ} (hx : 0 < x) (hxy : x < y) (hV : 0 < Vp x y) : 0 < a01 x y := by
  obtain ⟨d, hd, rfl⟩ : ∃ d, 0 < d ∧ y = x + d := ⟨y - x, by linarith, by ring⟩
  have e : a01 x (x + d) = d^2 + 2*d*x + 2*x^2 := by unfold a01; ring
  rw [e]; positivity

