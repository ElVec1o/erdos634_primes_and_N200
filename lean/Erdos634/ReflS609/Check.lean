  let Q : Pt := ⟨v.x * d.w * p.pd * p.qd + p.pn * d.x * v.w * p.qd - I.Dn * p.qn * d.y * v.w * p.pd,
                 v.y * d.w * p.pd * p.qd + p.pn * d.y * v.w * p.qd + p.qn * d.x * v.w * p.pd,
                 v.w * d.w * p.pd * p.qd⟩
