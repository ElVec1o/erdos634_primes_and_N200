/-- `sqCond`'s `Bool` and `sep_of_sepBy`'s `Prop` side condition agree. -/
theorem sqCond_iff (pq : R506Tiling.Pt × R506Tiling.Pt) :
    sqCond pq = true ↔
      (zsub (zx (toZPt pq.1)) (zx (toZPt pq.2))).1 ^ 2 ≠ 3 * (zsub (zx (toZPt pq.1)) (zx (toZPt pq.2))).2 ^ 2
        ∨ (zsub (zy (toZPt pq.1)) (zy (toZPt pq.2))).1 ^ 2
            ≠ 3 * (zsub (zy (toZPt pq.1)) (zy (toZPt pq.2))).2 ^ 2 := by
  rw [sqCond, decide_eq_true_iff]

/-- **Every two distinct pieces of the certificate have disjoint interiors, as real `Tri` objects.**
This is (C3) fully assembled: existence of the separating edge (`all_pairs_ok`), transferred to a
genuine affine functional bounded on the whole carrier (`sep_of_sepBy`). -/
theorem pieces_interiors_disjoint {A B : R506Tiling.Tri} (hA : A ∈ R506Tiling.tiles)
    (hB : B ∈ R506Tiling.tiles) (hne : A ≠ B) :
    Disjoint (interior (pieceTri hA).carrier) (interior (pieceTri hB).carrier) := by
  have hok := all_pairs_ok A hA B hB hne
  simp only [pairOK, List.any_eq_true] at hok
  obtain ⟨pq, hmem, hsep⟩ := hok
  rw [Bool.and_eq_true] at hsep
  obtain ⟨hsepBy, hsq⟩ := hsep
  obtain ⟨f, hf, c, h1, h2⟩ := sep_of_sepBy ((sqCond_iff pq).mp hsq) hsepBy hA hB
  exact Erdos634.CertGeom.interiors_disjoint_of_separating f hf c h1 h2

/-! ## (C1): every piece is congruent to a fixed model — the first piece, decided at once -/

/-- **The model tile**: the certificate's first certificate piece. Any piece works as the model since
all are mutually congruent; picking one already in `tiles` avoids naming new coordinates. -/
theorem headI_mem_tiles : R506Tiling.tiles.headI ∈ R506Tiling.tiles := by decide +kernel


/-- **(C1) fully assembled**: every piece of the certificate, as a real `Tri`, is congruent to the
model tile. -/
theorem pieceTri_congruent {t : R506Tiling.Tri} (ht : t ∈ R506Tiling.tiles) :
    (pieceTri ht).Congruent (pieceTri headI_mem_tiles) := by
  have hex := all_pieces_cong t ht
  simp only [congOK', decide_eq_true_eq] at hex
  obtain ⟨σ, hσ⟩ := hex
  refine Erdos634.SssCongruent.congruent_of_sq_dist_perm σ (fun i j => ?_)
  rw [pieceTri_dist_sq t ht, pieceTri_dist_sq R506Tiling.tiles.headI headI_mem_tiles]
  exact congrArg Erdos634.Z3Real.toR (hσ i j)

/-! ## (C2) containment: every piece lies in the target — the part `all_pieces_pos` skipped

`all_pieces_pos` only captured orientation (`insideOK`'s first conjunct); this is the actual
vertex-in-target containment, `insideOK`'s second conjunct. -/

/-- **Cyclic invariance of `cross`**: `cross o a b = cross a b o`. Twice the signed area of a
triangle does not depend on which vertex is named first, only the cyclic order. Needed to match
`insideOK`'s three checks (each anchored at a different target edge) against
`CertCoord.mem_carrier_of_dets`'s fixed vertex-0/1/2 convention. -/
theorem cross_cyclic (o a b : R506Tiling.Pt) : R506Tiling.cross o a b = R506Tiling.cross a b o := by
  simp only [R506Tiling.cross, R506Tiling.zsub, R506Tiling.zmul, R506Tiling.px, R506Tiling.py, Prod.ext_iff]
  constructor <;> ring


/-- Abbreviations for the target's three vertices. -/
theorem insideOK_vertex {t : R506Tiling.Tri} (ht : t ∈ R506Tiling.tiles) (i : Fin 3) :
    R506Tiling.znonneg (R506Tiling.cross (R506Tiling.t1 R506Tiling.target) (R506Tiling.t2 R506Tiling.target)
        (vertexOf t i)) = true
    ∧ R506Tiling.znonneg (R506Tiling.cross (R506Tiling.t2 R506Tiling.target) (R506Tiling.t3 R506Tiling.target)
        (vertexOf t i)) = true
    ∧ R506Tiling.znonneg (R506Tiling.cross (R506Tiling.t3 R506Tiling.target) (R506Tiling.t1 R506Tiling.target)
        (vertexOf t i)) = true := by
  have hins := all_pieces_inside t ht
  simp only [R506Tiling.insideOK, Bool.and_eq_true, List.all_eq_true] at hins
  have hv : vertexOf t i ∈ ([R506Tiling.t1 t, R506Tiling.t2 t, R506Tiling.t3 t] : List R506Tiling.Pt) := by
    fin_cases i <;> simp [vertexOf]
  have h3 := hins.2 (vertexOf t i) hv
  simp only [Bool.and_eq_true] at h3
  exact ⟨h3.1.1, h3.1.2, h3.2⟩

/-- **The target, real vertex-by-vertex, matches `mem_carrier_of_dets`'s convention.** -/
theorem vertexOf_mem_targetTri {t : R506Tiling.Tri} (ht : t ∈ R506Tiling.tiles) (i : Fin 3) :
    Erdos634.CertCoord.mkPt (toR (zx (toZPt (vertexOf t i)))) (toR (zy (toZPt (vertexOf t i))))
      ∈ targetTri.carrier := by
  obtain ⟨h1, h2, h3⟩ := insideOK_vertex ht i
  refine Erdos634.CertCoord.mem_carrier_of_dets (x₀ := toR (zx (toZPt (R506Tiling.t1 R506Tiling.target))))
    (y₀ := toR (zy (toZPt (R506Tiling.t1 R506Tiling.target))))
    (x₁ := toR (zx (toZPt (R506Tiling.t2 R506Tiling.target))))
    (y₁ := toR (zy (toZPt (R506Tiling.t2 R506Tiling.target))))
    (x₂ := toR (zx (toZPt (R506Tiling.t3 R506Tiling.target))))
    (y₂ := toR (zy (toZPt (R506Tiling.t3 R506Tiling.target))))
    target_det_pos ?_ ?_ ?_
  · -- h0 : 0 ≤ det3 a b x1 y1 x2 y2 = cross(v, T2, T3) = cross(T2, T3, v) [cyclic]
    rw [show Erdos634.CertCoord.det3 (toR (zx (toZPt (vertexOf t i)))) (toR (zy (toZPt (vertexOf t i))))
        (toR (zx (toZPt (R506Tiling.t2 R506Tiling.target)))) (toR (zy (toZPt (R506Tiling.t2 R506Tiling.target))))
        (toR (zx (toZPt (R506Tiling.t3 R506Tiling.target)))) (toR (zy (toZPt (R506Tiling.t3 R506Tiling.target))))
      = toR (zcross (toZPt (vertexOf t i)) (toZPt (R506Tiling.t2 R506Tiling.target))
          (toZPt (R506Tiling.t3 R506Tiling.target))) from toR_zcross _ _ _,
      ← cross_eq_zcross, cross_cyclic (vertexOf t i) (R506Tiling.t2 R506Tiling.target) (R506Tiling.t3 R506Tiling.target)]
    exact Erdos634.Z3Real.toR_nonneg h2
  · -- h1 : 0 ≤ det3 x0 y0 a b x2 y2 = cross(T1, v, T3) = cross(T3, T1, v) [two cyclic rotations]
    rw [show Erdos634.CertCoord.det3 (toR (zx (toZPt (R506Tiling.t1 R506Tiling.target))))
        (toR (zy (toZPt (R506Tiling.t1 R506Tiling.target)))) (toR (zx (toZPt (vertexOf t i))))
        (toR (zy (toZPt (vertexOf t i)))) (toR (zx (toZPt (R506Tiling.t3 R506Tiling.target))))
        (toR (zy (toZPt (R506Tiling.t3 R506Tiling.target))))
      = toR (zcross (toZPt (R506Tiling.t1 R506Tiling.target)) (toZPt (vertexOf t i))
          (toZPt (R506Tiling.t3 R506Tiling.target))) from toR_zcross _ _ _,
      ← cross_eq_zcross,
      cross_cyclic (R506Tiling.t1 R506Tiling.target) (vertexOf t i) (R506Tiling.t3 R506Tiling.target),
      cross_cyclic (vertexOf t i) (R506Tiling.t3 R506Tiling.target) (R506Tiling.t1 R506Tiling.target)]
    exact Erdos634.Z3Real.toR_nonneg h3
  · -- h2 : 0 ≤ det3 x0 y0 x1 y1 a b = cross(T1, T2, v), direct match
    rw [show Erdos634.CertCoord.det3 (toR (zx (toZPt (R506Tiling.t1 R506Tiling.target))))
        (toR (zy (toZPt (R506Tiling.t1 R506Tiling.target)))) (toR (zx (toZPt (R506Tiling.t2 R506Tiling.target))))
        (toR (zy (toZPt (R506Tiling.t2 R506Tiling.target)))) (toR (zx (toZPt (vertexOf t i))))
        (toR (zy (toZPt (vertexOf t i))))
      = toR (zcross (toZPt (R506Tiling.t1 R506Tiling.target)) (toZPt (R506Tiling.t2 R506Tiling.target))
          (toZPt (vertexOf t i))) from toR_zcross _ _ _,
      ← cross_eq_zcross]
