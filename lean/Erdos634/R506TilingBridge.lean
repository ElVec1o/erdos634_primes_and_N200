/-- **(C2) fully assembled**: every piece of the certificate, as a real `Tri`, lies in the target. -/
theorem pieceTri_subset_target {t : R506Tiling.Tri} (ht : t ∈ R506Tiling.tiles) :
    (pieceTri ht).carrier ⊆ targetTri.carrier :=
  Erdos634.CertGeom.carrier_subset_of_pts_mem (fun k => by
    rw [pieceTri_pts t ht k]; exact vertexOf_mem_targetTri ht k)

/-! ## (C4): the area sum, and the assembled `CongruentDissection`

the certificate's own `checkAll` already checks `zsum (tiles.map area2) == area2 target`; this section
transfers that Bool equality to the real determinant sum `AreaDet.area_identity_of_det` needs. -/

/-- Every piece of the certificate, indexed by `Fin R506Tiling.tiles.length` (rather than a fixed literal
`44`, so no length-cast bookkeeping is needed anywhere in this section). -/
noncomputable def pieceAt (i : Fin R506Tiling.tiles.length) : Tri :=
  pieceTri (t := R506Tiling.tiles[i.val]) (List.getElem_mem i.isLt)

theorem detTri_pieceAt (i : Fin R506Tiling.tiles.length) :
    Erdos634.AreaDet.detTri (pieceAt i) = toR (R506Tiling.area2 (R506Tiling.tiles[i.val])) := by
  unfold pieceAt pieceTri
  rw [Erdos634.CertCoord.detTri_mkTri, det3_eq_toR_cross]
  rfl

theorem foldl_zadd_eq (l : List R506Tiling.Z3) (acc : R506Tiling.Z3) :
    l.foldl R506Tiling.zadd acc = acc + l.sum := by
  induction l generalizing acc with
  | nil => simp
  | cons a t ih =>
    simp only [List.foldl_cons, List.sum_cons]
    rw [ih]; apply Prod.ext <;> simp [R506Tiling.zadd] <;> ring

theorem zsum_eq_sum (l : List R506Tiling.Z3) : R506Tiling.zsum l = l.sum := by
  simp only [R506Tiling.zsum]; rw [foldl_zadd_eq]; simp

theorem tiling506_zadd_eq_zreal (u v : R506Tiling.Z3) : R506Tiling.zadd u v = zadd u v := rfl

theorem toR_list_sum (l : List R506Tiling.Z3) : toR l.sum = (l.map toR).sum := by
  induction l with
  | nil => simp [toR]
  | cons a t ih =>
    simp only [List.sum_cons, List.map_cons]
    show toR (a + t.sum) = toR a + (List.map toR t).sum
    rw [show (a + t.sum : R506Tiling.Z3) = R506Tiling.zadd a t.sum from rfl,
      tiling506_zadd_eq_zreal, toR_add, ih]

set_option maxRecDepth 100000 in
theorem area_sum_transfer :
    ∑ i : Fin R506Tiling.tiles.length, toR (R506Tiling.area2 (R506Tiling.tiles[i.val]))
      = toR (R506Tiling.zsum (R506Tiling.tiles.map R506Tiling.area2)) := by
  rw [zsum_eq_sum, toR_list_sum, List.map_map,
    ← List.ofFn_getElem_eq_map R506Tiling.tiles (toR ∘ R506Tiling.area2)]
  rfl

/-- **The (C4) area sum, transferred to `ℝ`** — matching the certificate's own `checkAll` equality. -/
theorem area_sum_eq_target :
    ∑ i : Fin R506Tiling.tiles.length, toR (R506Tiling.area2 (R506Tiling.tiles[i.val]))
      = toR (R506Tiling.area2 R506Tiling.target) := by
  rw [area_sum_transfer]
  apply congrArg toR
  have h := R506Tiling.tiling506_certificate
  simp only [R506Tiling.checkAll, Bool.and_eq_true, beq_iff_eq] at h
  exact h.2

/-- **(C4) fully assembled**, with absolute values — every piece is positively oriented
(`all_pieces_pos`) and so is the target (`target_det_pos`), so `|det| = det` throughout. -/
theorem abs_detTri_sum_eq_target :
    ∑ i : Fin R506Tiling.tiles.length, |Erdos634.AreaDet.detTri (pieceAt i)|
      = |Erdos634.AreaDet.detTri targetTri| := by
  have htarget : Erdos634.AreaDet.detTri targetTri = toR (R506Tiling.area2 R506Tiling.target) := by
    unfold targetTri
    rw [Erdos634.CertCoord.detTri_mkTri, det3_eq_toR_cross]
    rfl
  have htpos : (0:ℝ) < Erdos634.AreaDet.detTri targetTri := by
    unfold targetTri; rw [Erdos634.CertCoord.detTri_mkTri]; exact target_det_pos
  rw [htarget, abs_of_pos (htarget ▸ htpos)]
  rw [← area_sum_eq_target]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [detTri_pieceAt]
  exact abs_of_pos (toR_pos (all_pieces_pos _ (List.getElem_mem i.isLt)))

