theorem tiles_getElem_inj : ∀ i j : Fin R506Tiling.tiles.length, i ≠ j →
    R506Tiling.tiles[i.val] ≠ R506Tiling.tiles[j.val] := by
  intro i j hij h
  exact hij (Fin.ext ((List.Nodup.getElem_inj_iff tiles_nodup).mp h))

noncomputable def dissection : CongruentDissection R506Tiling.tiles.length where
  toDissection := Erdos634.AreaDet.ofDetCertificate targetTri pieceAt
    (fun i => pieceTri_subset_target (List.getElem_mem i.isLt))
    (fun i j hij => pieces_interiors_disjoint (List.getElem_mem i.isLt) (List.getElem_mem j.isLt)
      (tiles_getElem_inj i j hij))
    abs_detTri_sum_eq_target
  model := pieceTri headI_mem_tiles
  tiles_congruent := fun i => pieceTri_congruent (List.getElem_mem i.isLt)

/-! ## The shape of `dissection` -/

/-- the corners of `dissection`'s target, read from the certificate -/
theorem targetTri_pts_eq (k : Fin 3) :
    targetTri.pts k = Erdos634.CertCoord.mkPt
      (toR (zx (toZPt (![R506Tiling.t1 R506Tiling.target, R506Tiling.t2 R506Tiling.target,
        R506Tiling.t3 R506Tiling.target] k))))
      (toR (zy (toZPt (![R506Tiling.t1 R506Tiling.target, R506Tiling.t2 R506Tiling.target,
        R506Tiling.t3 R506Tiling.target] k)))) := by
  fin_cases k <;> rfl

theorem targetTri_dist_sq (i j : Fin 3) :
    dist (targetTri.pts i) (targetTri.pts j) ^ 2
      = toR (R506Tiling.dist2
          (![R506Tiling.t1 R506Tiling.target, R506Tiling.t2 R506Tiling.target, R506Tiling.t3 R506Tiling.target] i)
          (![R506Tiling.t1 R506Tiling.target, R506Tiling.t2 R506Tiling.target, R506Tiling.t3 R506Tiling.target] j)) := by
  rw [targetTri_pts_eq i, targetTri_pts_eq j, Erdos634.CertCoord.dist_sq_mkPt, dist2_eq_zdist2]
  exact toR_zdist2 _ _

theorem targetTri_sides :
    dist (targetTri.pts 0) (targetTri.pts 1) ^ 2 = 3262922884
    ∧ dist (targetTri.pts 1) (targetTri.pts 2) ^ 2 = 2961318724
    ∧ dist (targetTri.pts 2) (targetTri.pts 0) ^ 2 = 3538822144 := by
  have e01 : R506Tiling.dist2 (R506Tiling.t1 R506Tiling.target) (R506Tiling.t2 R506Tiling.target)
      = ((3262922884:ℤ),(0:ℤ)) := by decide
  have e12 : R506Tiling.dist2 (R506Tiling.t2 R506Tiling.target) (R506Tiling.t3 R506Tiling.target)
      = ((2961318724:ℤ),(0:ℤ)) := by decide
  have e20 : R506Tiling.dist2 (R506Tiling.t3 R506Tiling.target) (R506Tiling.t1 R506Tiling.target)
      = ((3538822144:ℤ),(0:ℤ)) := by decide
  refine ⟨?_, ?_, ?_⟩
  · rw [targetTri_dist_sq 0 1]; simp; rw [e01]; simp [toR]
  · rw [targetTri_dist_sq 1 2]; simp; rw [e12]; simp [toR]
  · rw [targetTri_dist_sq 2 0]; simp; rw [e20]; simp [toR]

/-- the squared sides of the model tile (the first piece) -/
theorem model_sides :
    dist ((pieceTri headI_mem_tiles).pts 0) ((pieceTri headI_mem_tiles).pts 1) ^ 2 = 19307236
    ∧ dist ((pieceTri headI_mem_tiles).pts 1) ((pieceTri headI_mem_tiles).pts 2) ^ 2 = 5597956
    ∧ dist ((pieceTri headI_mem_tiles).pts 2) ((pieceTri headI_mem_tiles).pts 0) ^ 2 = 7311616 := by
  have e01 : R506Tiling.dist2 (vertexOf R506Tiling.tiles.headI 0) (vertexOf R506Tiling.tiles.headI 1)
      = ((19307236:ℤ),(0:ℤ)) := by decide
  have e12 : R506Tiling.dist2 (vertexOf R506Tiling.tiles.headI 1) (vertexOf R506Tiling.tiles.headI 2)
      = ((5597956:ℤ),(0:ℤ)) := by decide
  have e20 : R506Tiling.dist2 (vertexOf R506Tiling.tiles.headI 2) (vertexOf R506Tiling.tiles.headI 0)
      = ((7311616:ℤ),(0:ℤ)) := by decide
  refine ⟨?_, ?_, ?_⟩
  · rw [pieceTri_dist_sq _ headI_mem_tiles 0 1, e01]; norm_num [toR]
  · rw [pieceTri_dist_sq _ headI_mem_tiles 1 2, e12]; norm_num [toR]
  · rw [pieceTri_dist_sq _ headI_mem_tiles 2 0, e20]; norm_num [toR]

/-- transport of a dissection along an equality of the number of tiles -/
theorem exists_cast {n m : ℕ} (h : n = m) (D : CongruentDissection n) :
    ∃ D' : CongruentDissection m, D'.target = D.target ∧ D'.model = D.model := by
  subst h; exact ⟨D, rfl, rfl⟩

/-- **The 506-tiling with its shape, in one statement**: there is a dissection into 506 congruent triangles whose target
has squared sides `3262922884, 2961318724, 3538822144` and whose tile has squared sides `19307236, 5597956, 7311616` (scale `338`). -/
theorem r506_dissection_shape :
    ∃ D : CongruentDissection 506,
      dist (D.target.pts 0) (D.target.pts 1) ^ 2 = 3262922884 ∧ dist (D.target.pts 1) (D.target.pts 2) ^ 2 = 2961318724 ∧
      dist (D.target.pts 2) (D.target.pts 0) ^ 2 = 3538822144 ∧
      dist (D.model.pts 0) (D.model.pts 1) ^ 2 = 19307236 ∧ dist (D.model.pts 1) (D.model.pts 2) ^ 2 = 5597956 ∧
      dist (D.model.pts 2) (D.model.pts 0) ^ 2 = 7311616 := by
  obtain ⟨D, hT, hM⟩ := exists_cast (by decide +kernel : R506Tiling.tiles.length = 506) dissection
  have hT' : D.target = targetTri := hT
  have hM' : D.model = pieceTri headI_mem_tiles := hM
  obtain ⟨t1, t2, t3⟩ := targetTri_sides
  obtain ⟨m1, m2, m3⟩ := model_sides
  exact ⟨D, by rw [hT']; exact t1, by rw [hT']; exact t2, by rw [hT']; exact t3,
    by rw [hM']; exact m1, by rw [hM']; exact m2, by rw [hM']; exact m3⟩

/-- **`Nonempty (CongruentDissection 506)`** -/
theorem r506_nonempty_congruentDissection : Nonempty (CongruentDissection 506) := by
  obtain ⟨D, _⟩ := r506_dissection_shape
  exact ⟨D⟩

