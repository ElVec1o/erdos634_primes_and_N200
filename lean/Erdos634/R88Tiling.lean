]
def pairSep (A B : Tri) (w : Bool × Nat) : Bool :=
  let pq := edgeOf (if w.1 then A else B) w.2
  sepBy pq.1 pq.2 A B
def checkPairs : List Tri → List (Bool × Nat) → Bool
  | [], ws => ws.isEmpty
  | t :: rest, ws =>
      let n := rest.length
      (ws.take n).length == n
      && (List.zip rest (ws.take n)).all (fun (u, w) => pairSep t u w)
      && checkPairs rest (ws.drop n)
def zsum (l : List Z3) : Z3 := l.foldl zadd ((0:Int),(0:Int))
def checkAll : Bool :=
  tiles.length == 88 && tiles.all congOK && tiles.all insideOK
  && checkPairs tiles wit && zsum (tiles.map area2) == area2 target
set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
theorem tiling88_certificate : checkAll = true := by decide
#print axioms tiling88_certificate
end R88Tiling