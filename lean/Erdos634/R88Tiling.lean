-- Exact kernel verification of an 88-tile certificate (N=88).
-- The scalene triangle (21,55,56) is tiled by 88 congruent copies of the (3,5,7) tile (angle 2pi/3).
-- Found by a float corner-fill search, snapped exactly to Z[sqrt3]/98 and verified by an exact program.
-- Scaled by 98 into Z[sqrt3]: (C1) each tile has squared side multiset {86436,240100,470596} = (98*(3,5,7))^2;
-- (C2) CCW + vertices in closed target (half-planes); (C3) explicit separating edge-line per pair
-- (3828 pairs); (C4) signed 2-areas sum to the target's. No imports, no axioms.
namespace R88Tiling
abbrev Z3 := Int × Int
abbrev Pt := Int × Int × Int × Int
def zmul (u v : Z3) : Z3 := (u.1*v.1 + 3*u.2*v.2, u.1*v.2 + u.2*v.1)
def zsub (u v : Z3) : Z3 := (u.1 - v.1, u.2 - v.2)
def zadd (u v : Z3) : Z3 := (u.1 + v.1, u.2 + v.2)
def znonneg (z : Z3) : Bool :=
  if 0 <= z.1 then (if 0 <= z.2 then true else 3*z.2*z.2 <= z.1*z.1)
  else (if z.2 < 0 then false else z.1*z.1 <= 3*z.2*z.2)
def znonpos (z : Z3) : Bool := znonneg (-z.1, -z.2)
def zpos (z : Z3) : Bool := !(znonpos z)
def px (p : Pt) : Z3 := (p.1, p.2.1)
def py (p : Pt) : Z3 := (p.2.2.1, p.2.2.2)
def cross (o a b : Pt) : Z3 :=
  zsub (zmul (zsub (px a) (px o)) (zsub (py b) (py o))) (zmul (zsub (py a) (py o)) (zsub (px b) (px o)))
def dist2 (p q : Pt) : Z3 :=
  zadd (zmul (zsub (px q) (px p)) (zsub (px q) (px p))) (zmul (zsub (py q) (py p)) (zsub (py q) (py p)))
abbrev Tri := Pt × Pt × Pt
def t1 (t : Tri) : Pt := t.1
def t2 (t : Tri) : Pt := t.2.1
def t3 (t : Tri) : Pt := t.2.2
def congOK (t : Tri) : Bool :=
  let d1 := dist2 (t1 t) (t2 t); let d2 := dist2 (t2 t) (t3 t); let d3 := dist2 (t3 t) (t1 t)
  let s : List Z3 := [d1, d2, d3]
  s.contains ((86436:Int),(0:Int)) && s.contains ((240100:Int),(0:Int)) && s.contains ((470596:Int),(0:Int))
  && d1.2 == 0 && d2.2 == 0 && d3.2 == 0 && (d1.1 + d2.1 + d3.1 == 797132)
def target : Tri := ((0,0,0,0), (2058,0,0,0), (770,0,0,3080))
def insideOK (t : Tri) : Bool :=
  zpos (cross (t1 t) (t2 t) (t3 t)) &&
  [t1 t, t2 t, t3 t].all (fun v =>
    znonneg (cross (t1 target) (t2 target) v) && znonneg (cross (t2 target) (t3 target) v) &&
    znonneg (cross (t3 target) (t1 target) v))
def sepBy (P Q : Pt) (A B : Tri) : Bool :=
  let sA := [t1 A, t2 A, t3 A].map (fun v => cross P Q v)
  let sB := [t1 B, t2 B, t3 B].map (fun v => cross P Q v)
  (sA.all znonneg && sB.all znonpos) || (sA.all znonpos && sB.all znonneg)
def edgeOf (t : Tri) (e : Nat) : Pt × Pt :=
  if e == 0 then (t1 t, t2 t) else if e == 1 then (t2 t, t3 t) else (t3 t, t1 t)
def area2 (t : Tri) : Z3 := cross (t1 t) (t2 t) (t3 t)
