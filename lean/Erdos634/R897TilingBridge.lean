theorem foldl_zadd_eq (l : List R897Tiling.Z55) (acc : R897Tiling.Z55) :
    l.foldl R897Tiling.zadd acc = acc + l.sum := by
  induction l generalizing acc with
  | nil => simp
  | cons a t ih =>
    simp only [List.foldl_cons, List.sum_cons]
    rw [ih]; apply Prod.ext <;> simp [R897Tiling.zadd] <;> ring

theorem zsum_eq_sum (l : List R897Tiling.Z55) : R897Tiling.zsum l = l.sum := by
  simp only [R897Tiling.zsum]; rw [foldl_zadd_eq]; simp

theorem tiling897_zadd_eq_zreal (u v : R897Tiling.Z55) : R897Tiling.zadd u v = zadd u v := rfl

theorem toR_list_sum (l : List R897Tiling.Z55) : toR l.sum = (l.map toR).sum := by
  induction l with
  | nil => simp [toR]
  | cons a t ih =>
    simp only [List.sum_cons, List.map_cons]
    show toR (a + t.sum) = toR a + (List.map toR t).sum
    rw [show (a + t.sum : R897Tiling.Z55) = R897Tiling.zadd a t.sum from rfl,
      tiling897_zadd_eq_zreal, toR_add, ih]

