    dist ((pieceTri headI_mem_tiles).pts 0) ((pieceTri headI_mem_tiles).pts 1) ^ 2 = 50176
    ∧ dist ((pieceTri headI_mem_tiles).pts 1) ((pieceTri headI_mem_tiles).pts 2) ^ 2 = 262144
    ∧ dist ((pieceTri headI_mem_tiles).pts 2) ((pieceTri headI_mem_tiles).pts 0) ^ 2 = 147456 := by
  have e01 : R897Tiling.dist2 (vertexOf R897Tiling.tiles.headI 0) (vertexOf R897Tiling.tiles.headI 1)
      = ((50176:ℤ),(0:ℤ)) := by decide
  have e12 : R897Tiling.dist2 (vertexOf R897Tiling.tiles.headI 1) (vertexOf R897Tiling.tiles.headI 2)
      = ((262144:ℤ),(0:ℤ)) := by decide
  have e20 : R897Tiling.dist2 (vertexOf R897Tiling.tiles.headI 2) (vertexOf R897Tiling.tiles.headI 0)
      = ((147456:ℤ),(0:ℤ)) := by decide
  refine ⟨?_, ?_, ?_⟩
  · rw [pieceTri_dist_sq _ headI_mem_tiles 0 1, e01]; norm_num [toR]
  · rw [pieceTri_dist_sq _ headI_mem_tiles 1 2, e12]; norm_num [toR]
  · rw [pieceTri_dist_sq _ headI_mem_tiles 2 0, e20]; norm_num [toR]

/-- transport of a dissection along an equality of the number of tiles -/
theorem exists_cast {n m : ℕ} (h : n = m) (D : CongruentDissection n) :
    ∃ D' : CongruentDissection m, D'.target = D.target ∧ D'.model = D.model := by
  subst h; exact ⟨D, rfl, rfl⟩

/-- **The 897-tiling with its shape, in one statement**: there is a dissection into 897 congruent triangles whose target
has squared sides `76317696, 138674176, 67108864` and whose tile has squared sides `50176, 262144, 147456` (scale `32`). -/
theorem r897_dissection_shape :
    ∃ D : CongruentDissection 897,
      dist (D.target.pts 0) (D.target.pts 1) ^ 2 = 76317696 ∧ dist (D.target.pts 1) (D.target.pts 2) ^ 2 = 138674176 ∧
      dist (D.target.pts 2) (D.target.pts 0) ^ 2 = 67108864 ∧
      dist (D.model.pts 0) (D.model.pts 1) ^ 2 = 50176 ∧ dist (D.model.pts 1) (D.model.pts 2) ^ 2 = 262144 ∧
      dist (D.model.pts 2) (D.model.pts 0) ^ 2 = 147456 := by
  obtain ⟨D, hT, hM⟩ := exists_cast (by decide +kernel : R897Tiling.tiles.length = 897) dissection
  have hT' : D.target = targetTri := hT
  have hM' : D.model = pieceTri headI_mem_tiles := hM
  obtain ⟨t1, t2, t3⟩ := targetTri_sides
  obtain ⟨m1, m2, m3⟩ := model_sides
  exact ⟨D, by rw [hT']; exact t1, by rw [hT']; exact t2, by rw [hT']; exact t3,
    by rw [hM']; exact m1, by rw [hM']; exact m2, by rw [hM']; exact m3⟩

/-- **`Nonempty (CongruentDissection 897)`** -/
theorem r897_nonempty_congruentDissection : Nonempty (CongruentDissection 897) := by
  obtain ⟨D, _⟩ := r897_dissection_shape
  exact ⟨D⟩

#print axioms r897_dissection_shape
#print axioms r897_nonempty_congruentDissection

end Erdos634.R897TilingBridge
