-- Exact kernel verification of a 897-tile certificate (N=897).
-- A triangle with squared sides [76317696, 138674176, 67108864] (scale 32) is tiled by 897 congruent copies of the (12,7,16) tile.
-- Construction of D. Paliy (github.com/DenisUkranian/erdos-634-tilings, commit 94566090), converted exactly to Z[sqrt55]/32 and checked exactly by an independent program.
-- Scaled by 32 into Z[sqrt55]: (C1) each tile has squared side multiset
-- {50176,147456,262144}; (C2) counterclockwise + vertices in the closed target (half-planes); (C4) signed 2-areas sum to the
-- target's.  (C3), the separation of every pair, is decided in R897TilingBridge.  No imports, no axioms.
namespace R897Tiling
abbrev Z55 := Int × Int
abbrev Pt := Int × Int × Int × Int
def zmul (u v : Z55) : Z55 := (u.1*v.1 + 55*u.2*v.2, u.1*v.2 + u.2*v.1)
def zsub (u v : Z55) : Z55 := (u.1 - v.1, u.2 - v.2)
def zadd (u v : Z55) : Z55 := (u.1 + v.1, u.2 + v.2)
def znonneg (z : Z55) : Bool :=
  if 0 <= z.1 then (if 0 <= z.2 then true else 55*z.2*z.2 <= z.1*z.1)
  else (if z.2 < 0 then false else z.1*z.1 <= 55*z.2*z.2)
def znonpos (z : Z55) : Bool := znonneg (-z.1, -z.2)
def zpos (z : Z55) : Bool := !(znonpos z)
def px (p : Pt) : Z55 := (p.1, p.2.1)
def py (p : Pt) : Z55 := (p.2.2.1, p.2.2.2)
def cross (o a b : Pt) : Z55 :=
  zsub (zmul (zsub (px a) (px o)) (zsub (py b) (py o))) (zmul (zsub (py a) (py o)) (zsub (px b) (px o)))
def dist2 (p q : Pt) : Z55 :=
  zadd (zmul (zsub (px q) (px p)) (zsub (px q) (px p))) (zmul (zsub (py q) (py p)) (zsub (py q) (py p)))
abbrev Tri := Pt × Pt × Pt
def t1 (t : Tri) : Pt := t.1
def t2 (t : Tri) : Pt := t.2.1
def t3 (t : Tri) : Pt := t.2.2
def congOK (t : Tri) : Bool :=
  let d1 := dist2 (t1 t) (t2 t); let d2 := dist2 (t2 t) (t3 t); let d3 := dist2 (t3 t) (t1 t)
  let s : List Z55 := [d1, d2, d3]
  s.contains ((50176:Int),(0:Int)) && s.contains ((147456:Int),(0:Int)) && s.contains ((262144:Int),(0:Int))
  && d1.2 == 0 && d2.2 == 0 && d3.2 == 0 && (d1.1 + d2.1 + d3.1 == 459776)
def target : Tri := ((1568,0,0,0), (-4711,0,0,819), (-4320,0,0,-768))
def insideOK (t : Tri) : Bool :=
  zpos (cross (t1 t) (t2 t) (t3 t)) &&
  [t1 t, t2 t, t3 t].all (fun v =>
    znonneg (cross (t1 target) (t2 target) v) && znonneg (cross (t2 target) (t3 target) v) &&
    znonneg (cross (t3 target) (t1 target) v))
def sepBy (P Q : Pt) (A B : Tri) : Bool :=
  let sA := [t1 A, t2 A, t3 A].map (fun v => cross P Q v)
  let sB := [t1 B, t2 B, t3 B].map (fun v => cross P Q v)
  (sA.all znonneg && sB.all znonpos) || (sA.all znonpos && sB.all znonneg)
def edgeOf (t : Tri) (e : Nat) : Pt × Pt :=
  if e == 0 then (t1 t, t2 t) else if e == 1 then (t2 t, t3 t) else (t3 t, t1 t)
def area2 (t : Tri) : Z55 := cross (t1 t) (t2 t) (t3 t)
