      dist (D.target.pts 2) (D.target.pts 0) ^ 2 = 76527504 ∧
      dist (D.model.pts 0) (D.model.pts 1) ^ 2 = 531441 ∧ dist (D.model.pts 1) (D.model.pts 2) ^ 2 = 236196 ∧
      dist (D.model.pts 2) (D.model.pts 0) ^ 2 = 164025 := by
