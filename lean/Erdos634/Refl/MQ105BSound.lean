theorem hDn : (0:ℝ) < 3 := by norm_num
theorem TGT_pos : 0 < ef 0 0 105 0 (105/2) (105/2) := by unfold ef; norm_num
noncomputable def TGT : Erdos634.Geometry.Tri := rtri 3 hDn 0 0 105 0 (105/2) (105/2) TGT_pos
theorem MODEL_pos : 0 < ef 0 0 5 0 (21/2) (21/2) := by unfold ef; norm_num
noncomputable def MODEL : Erdos634.Geometry.Tri := rtri 3 hDn 0 0 5 0 (21/2) (21/2) MODEL_pos
theorem MODEL_sides : dist (MODEL.pts 0) (MODEL.pts 1) = 5 ∧ dist (MODEL.pts 1) (MODEL.pts 2) = 19 ∧
