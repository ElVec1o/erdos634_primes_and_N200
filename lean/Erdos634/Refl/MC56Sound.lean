import Erdos634.Refl.MC56Data0
import Erdos634.Refl.SoundM3
import Erdos634.NormalPosition

/-! GENERATED by rust/certgenm.  Free-branch-point (`CheckM`) refutation of instance `C56`:
    target `(0, 0), (30, 0), ((34/3), (112/3)·√2)`, tile sides `(6 5 9)`; 409 nodes in 3 pieces.
    `not_dissection`: no `CongruentDissection` (any `N`) has target congruent to `TGT` and model congruent to `MODEL`. -/

open Erdos634.CertNode Erdos634.Geometry Erdos634.CertCoord

namespace Refl.MC56
open Refl

theorem hDn : (0:ℝ) < 2 := by norm_num
theorem TGT_pos : 0 < ef 0 0 30 0 (34/3) (112/3) := by unfold ef; norm_num
noncomputable def TGT : Erdos634.Geometry.Tri := rtri 2 hDn 0 0 30 0 (34/3) (112/3) TGT_pos
theorem MODEL_pos : 0 < ef 0 0 6 0 (23/3) (10/3) := by unfold ef; norm_num
noncomputable def MODEL : Erdos634.Geometry.Tri := rtri 2 hDn 0 0 6 0 (23/3) (10/3) MODEL_pos
theorem MODEL_sides : dist (MODEL.pts 0) (MODEL.pts 1) = 6 ∧ dist (MODEL.pts 1) (MODEL.pts 2) = 5 ∧
    dist (MODEL.pts 0) (MODEL.pts 2) = 9 :=
  model_sides_rp hDn MODEL_pos (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
theorem tgt_ok : inst.tgt.ok = true := by decide +kernel
theorem tgt_carr : inst.tgt.carr 2 = TGT.carrier := by
  obtain ⟨hp, h⟩ := Tri.ok_sem 2 hDn inst.tgt tgt_ok
  rw [h]
  have e1 : inst.tgt.a.X = 0 := by simp [inst, pt, Pt.X]
  have e2 : inst.tgt.a.Y = 0 := by simp [inst, pt, Pt.Y]
  have e3 : inst.tgt.b.X = 30 := by simp [inst, pt, Pt.X]
  have e4 : inst.tgt.b.Y = 0 := by simp [inst, pt, Pt.Y]
  have e5 : inst.tgt.c.X = (34/3) := by simp [inst, pt, Pt.X]
  have e6 : inst.tgt.c.Y = (112/3) := by simp [inst, pt, Pt.Y]
  unfold TGT
  simp only [e1, e2, e3, e4, e5, e6]
theorem hMa : dist (MODEL.pts 0) (MODEL.pts 1) = (inst.sides.1 : ℝ) := by simpa [inst] using MODEL_sides.1
theorem hMb : dist (MODEL.pts 1) (MODEL.pts 2) = (inst.sides.2.1 : ℝ) := by simpa [inst] using MODEL_sides.2.1
theorem hMc : dist (MODEL.pts 0) (MODEL.pts 2) = (inst.sides.2.2 : ℝ) := by simpa [inst] using MODEL_sides.2.2
theorem hDnI : ((inst.Dn : ℤ) : ℝ) = 2 := by norm_num [inst]

theorem sound2 : Sound 2 inst MODEL cfg2 :=
  checkNodeM_sound 2 hDn inst hDnI MODEL hMa hMb hMc inst_ok kn2 (by intro c hc; simp [kn2] at hc) 4000 cfg2 tree2
    (fun t ht => List.all_eq_true.mp cfgok2 t ht) ok2
theorem sound1 : Sound 2 inst MODEL cfg1 :=
  checkNodeM_sound 2 hDn inst hDnI MODEL hMa hMb hMc inst_ok kn1 (by intro c hc; simp [kn1] at hc) 4000 cfg1 tree1
    (fun t ht => List.all_eq_true.mp cfgok1 t ht) ok1
theorem sound0 : Sound 2 inst MODEL cfg0 :=
  checkNodeM_sound 2 hDn inst hDnI MODEL hMa hMb hMc inst_ok kn0 (by
    intro c hc
    simp only [kn0, List.mem_cons, List.mem_nil_iff, or_false] at hc
    rcases hc with rfl | rfl
    · exact sound1
    · exact sound2) 4000 cfg0 tree0
    (fun t ht => List.all_eq_true.mp cfgok0 t ht) ok0

theorem not_dissection {N : ℕ} (D : CongruentDissection N)
    (hT : D.target.Congruent TGT) (hM : D.model.Congruent MODEL) : False := by
  obtain ⟨g, D', hD'T, hD'M, -⟩ := Erdos634.NormalPosition.exists_normal_position_congruent D hT
  exact sound0 (N := N) D' (by rw [hD'T, tgt_carr]) (by rw [hD'M]; exact hM) (by simp [cfg0])

end Refl.MC56
#print axioms Refl.MC56.not_dissection
