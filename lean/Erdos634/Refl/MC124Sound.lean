/-! GENERATED by rust/certgenm.  Free-branch-point (`CheckM`) refutation of instance `C124`:
    target `(0, 0), (62, 0), (15, 45·√7)`, tile sides `(4 15 16)`; 2010 nodes in 162 pieces.
    `not_dissection`: no `CongruentDissection` (any `N`) has target congruent to `TGT` and model congruent to `MODEL`. -/

open Erdos634.CertNode Erdos634.Geometry Erdos634.CertCoord

namespace Refl.MC124
open Refl

theorem hDn : (0:ℝ) < 7 := by norm_num
theorem TGT_pos : 0 < ef 0 0 62 0 15 45 := by unfold ef; norm_num
noncomputable def TGT : Erdos634.Geometry.Tri := rtri 7 hDn 0 0 62 0 15 45 TGT_pos
theorem MODEL_pos : 0 < ef 0 0 4 0 (47/8) (45/8) := by unfold ef; norm_num
noncomputable def MODEL : Erdos634.Geometry.Tri := rtri 7 hDn 0 0 4 0 (47/8) (45/8) MODEL_pos
theorem MODEL_sides : dist (MODEL.pts 0) (MODEL.pts 1) = 4 ∧ dist (MODEL.pts 1) (MODEL.pts 2) = 15 ∧
    dist (MODEL.pts 0) (MODEL.pts 2) = 16 :=
  model_sides_rp hDn MODEL_pos (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
theorem tgt_ok : inst.tgt.ok = true := by decide +kernel
theorem tgt_carr : inst.tgt.carr 7 = TGT.carrier := by
  obtain ⟨hp, h⟩ := Tri.ok_sem 7 hDn inst.tgt tgt_ok
  rw [h]
  have e1 : inst.tgt.a.X = 0 := by simp [inst, pt, Pt.X]
  have e2 : inst.tgt.a.Y = 0 := by simp [inst, pt, Pt.Y]
  have e3 : inst.tgt.b.X = 62 := by simp [inst, pt, Pt.X]
  have e4 : inst.tgt.b.Y = 0 := by simp [inst, pt, Pt.Y]
  have e5 : inst.tgt.c.X = 15 := by simp [inst, pt, Pt.X]
  have e6 : inst.tgt.c.Y = 45 := by simp [inst, pt, Pt.Y]
  unfold TGT
  simp only [e1, e2, e3, e4, e5, e6]
theorem hMa : dist (MODEL.pts 0) (MODEL.pts 1) = (inst.sides.1 : ℝ) := by simpa [inst] using MODEL_sides.1
theorem hMb : dist (MODEL.pts 1) (MODEL.pts 2) = (inst.sides.2.1 : ℝ) := by simpa [inst] using MODEL_sides.2.1
theorem hMc : dist (MODEL.pts 0) (MODEL.pts 2) = (inst.sides.2.2 : ℝ) := by simpa [inst] using MODEL_sides.2.2
theorem hDnI : ((inst.Dn : ℤ) : ℝ) = 7 := by norm_num [inst]

