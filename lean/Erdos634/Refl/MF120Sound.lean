theorem MODEL_pos : 0 < ef 0 0 7 0 11 4 := by unfold ef; norm_num
noncomputable def MODEL : Erdos634.Geometry.Tri := rtri 3 hDn 0 0 7 0 11 4 MODEL_pos
theorem MODEL_sides : dist (MODEL.pts 0) (MODEL.pts 1) = 7 ∧ dist (MODEL.pts 1) (MODEL.pts 2) = 8 ∧
