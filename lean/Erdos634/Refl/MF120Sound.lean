  have e2 : inst.tgt.a.Y = 0 := by simp [inst, pt, Pt.Y]
  have e3 : inst.tgt.b.X = 120 := by simp [inst, pt, Pt.X]
  have e4 : inst.tgt.b.Y = 0 := by simp [inst, pt, Pt.Y]
  have e5 : inst.tgt.c.X = 92 := by simp [inst, pt, Pt.X]
  have e6 : inst.tgt.c.Y = 28 := by simp [inst, pt, Pt.Y]
  unfold TGT
  simp only [e1, e2, e3, e4, e5, e6]
