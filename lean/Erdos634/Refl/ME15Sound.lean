import Erdos634.Refl.ME15Data0
import Erdos634.Refl.SoundM3
import Erdos634.NormalPosition

/-! GENERATED by rust/certgenm.  Free-branch-point (`CheckM`) refutation of instance `E15`:
    target `(0, 0), (15, 0), ((15/2), (15/2)·√3)`, tile sides `(3 5 7)`; 53 nodes in 4 pieces.
    `not_dissection`: no `CongruentDissection` (any `N`) has target congruent to `TGT` and model congruent to `MODEL`. -/

open Erdos634.CertNode Erdos634.Geometry Erdos634.CertCoord

namespace Refl.ME15
open Refl

theorem hDn : (0:ℝ) < 3 := by norm_num
theorem TGT_pos : 0 < ef 0 0 15 0 (15/2) (15/2) := by unfold ef; norm_num
noncomputable def TGT : Erdos634.Geometry.Tri := rtri 3 hDn 0 0 15 0 (15/2) (15/2) TGT_pos
theorem MODEL_pos : 0 < ef 0 0 3 0 (11/2) (5/2) := by unfold ef; norm_num
noncomputable def MODEL : Erdos634.Geometry.Tri := rtri 3 hDn 0 0 3 0 (11/2) (5/2) MODEL_pos
theorem MODEL_sides : dist (MODEL.pts 0) (MODEL.pts 1) = 3 ∧ dist (MODEL.pts 1) (MODEL.pts 2) = 5 ∧
    dist (MODEL.pts 0) (MODEL.pts 2) = 7 :=
  model_sides_rp hDn MODEL_pos (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
theorem tgt_ok : inst.tgt.ok = true := by decide +kernel
theorem tgt_carr : inst.tgt.carr 3 = TGT.carrier := by
  obtain ⟨hp, h⟩ := Tri.ok_sem 3 hDn inst.tgt tgt_ok
  rw [h]
  have e1 : inst.tgt.a.X = 0 := by simp [inst, pt, Pt.X]
  have e2 : inst.tgt.a.Y = 0 := by simp [inst, pt, Pt.Y]
  have e3 : inst.tgt.b.X = 15 := by simp [inst, pt, Pt.X]
  have e4 : inst.tgt.b.Y = 0 := by simp [inst, pt, Pt.Y]
  have e5 : inst.tgt.c.X = (15/2) := by simp [inst, pt, Pt.X]
  have e6 : inst.tgt.c.Y = (15/2) := by simp [inst, pt, Pt.Y]
  unfold TGT
  simp only [e1, e2, e3, e4, e5, e6]
theorem hMa : dist (MODEL.pts 0) (MODEL.pts 1) = (inst.sides.1 : ℝ) := by simpa [inst] using MODEL_sides.1
theorem hMb : dist (MODEL.pts 1) (MODEL.pts 2) = (inst.sides.2.1 : ℝ) := by simpa [inst] using MODEL_sides.2.1
theorem hMc : dist (MODEL.pts 0) (MODEL.pts 2) = (inst.sides.2.2 : ℝ) := by simpa [inst] using MODEL_sides.2.2
theorem hDnI : ((inst.Dn : ℤ) : ℝ) = 3 := by norm_num [inst]

theorem sound3 : Sound 3 inst MODEL cfg3 :=
  checkNodeM_sound 3 hDn inst hDnI MODEL hMa hMb hMc inst_ok kn3 (by intro c hc; simp [kn3] at hc) 4000 cfg3 tree3
    (fun t ht => List.all_eq_true.mp cfgok3 t ht) ok3
theorem sound2 : Sound 3 inst MODEL cfg2 :=
  checkNodeM_sound 3 hDn inst hDnI MODEL hMa hMb hMc inst_ok kn2 (by intro c hc; simp [kn2] at hc) 4000 cfg2 tree2
    (fun t ht => List.all_eq_true.mp cfgok2 t ht) ok2
theorem sound1 : Sound 3 inst MODEL cfg1 :=
  checkNodeM_sound 3 hDn inst hDnI MODEL hMa hMb hMc inst_ok kn1 (by intro c hc; simp [kn1] at hc) 4000 cfg1 tree1
    (fun t ht => List.all_eq_true.mp cfgok1 t ht) ok1
theorem sound0 : Sound 3 inst MODEL cfg0 :=
  checkNodeM_sound 3 hDn inst hDnI MODEL hMa hMb hMc inst_ok kn0 (by
    intro c hc
    simp only [kn0, List.mem_cons, List.mem_nil_iff, or_false] at hc
    rcases hc with rfl | rfl | rfl
    · exact sound1
    · exact sound2
    · exact sound3) 4000 cfg0 tree0
    (fun t ht => List.all_eq_true.mp cfgok0 t ht) ok0

theorem not_dissection {N : ℕ} (D : CongruentDissection N)
    (hT : D.target.Congruent TGT) (hM : D.model.Congruent MODEL) : False := by
  obtain ⟨g, D', hD'T, hD'M, -⟩ := Erdos634.NormalPosition.exists_normal_position_congruent D hT
  exact sound0 (N := N) D' (by rw [hD'T, tgt_carr]) (by rw [hD'M]; exact hM) (by simp [cfg0])

end Refl.ME15
#print axioms Refl.ME15.not_dissection
