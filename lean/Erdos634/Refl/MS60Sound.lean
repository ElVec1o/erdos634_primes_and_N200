theorem hDn : (0:ℝ) < 23 := by norm_num
theorem TGT_pos : 0 < ef 0 0 210 0 105 45 := by unfold ef; norm_num
noncomputable def TGT : Erdos634.Geometry.Tri := rtri 23 hDn 0 0 210 0 105 45 TGT_pos
theorem MODEL_pos : 0 < ef 0 0 56 0 (1001/16) (45/16) := by unfold ef; norm_num
noncomputable def MODEL : Erdos634.Geometry.Tri := rtri 23 hDn 0 0 56 0 (1001/16) (45/16) MODEL_pos
theorem MODEL_sides : dist (MODEL.pts 0) (MODEL.pts 1) = 56 ∧ dist (MODEL.pts 1) (MODEL.pts 2) = 15 ∧
    dist (MODEL.pts 0) (MODEL.pts 2) = 64 :=
  model_sides_rp hDn MODEL_pos (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
theorem tgt_ok : inst.tgt.ok = true := by decide +kernel
theorem tgt_carr : inst.tgt.carr 23 = TGT.carrier := by
  obtain ⟨hp, h⟩ := Tri.ok_sem 23 hDn inst.tgt tgt_ok
  rw [h]
  have e1 : inst.tgt.a.X = 0 := by simp [inst, pt, Pt.X]
  have e2 : inst.tgt.a.Y = 0 := by simp [inst, pt, Pt.Y]
  have e3 : inst.tgt.b.X = 210 := by simp [inst, pt, Pt.X]
  have e4 : inst.tgt.b.Y = 0 := by simp [inst, pt, Pt.Y]
  have e5 : inst.tgt.c.X = 105 := by simp [inst, pt, Pt.X]
  have e6 : inst.tgt.c.Y = 45 := by simp [inst, pt, Pt.Y]
  unfold TGT
  simp only [e1, e2, e3, e4, e5, e6]
theorem hMa : dist (MODEL.pts 0) (MODEL.pts 1) = (inst.sides.1 : ℝ) := by simpa [inst] using MODEL_sides.1
theorem hMb : dist (MODEL.pts 1) (MODEL.pts 2) = (inst.sides.2.1 : ℝ) := by simpa [inst] using MODEL_sides.2.1
theorem hMc : dist (MODEL.pts 0) (MODEL.pts 2) = (inst.sides.2.2 : ℝ) := by simpa [inst] using MODEL_sides.2.2
theorem hDnI : ((inst.Dn : ℤ) : ℝ) = 23 := by norm_num [inst]

theorem sound11 : Sound 23 inst MODEL cfg11 :=
  checkNodeM_sound 23 hDn inst hDnI MODEL hMa hMb hMc inst_ok kn11 (by intro c hc; simp [kn11] at hc) 4000 cfg11 tree11
    (fun t ht => List.all_eq_true.mp cfgok11 t ht) ok11
