def zmul (u v : Z35) : Z35 := (u.1*v.1 + 35*u.2*v.2, u.1*v.2 + u.2*v.1)
def zsub (u v : Z35) : Z35 := (u.1 - v.1, u.2 - v.2)
def zadd (u v : Z35) : Z35 := (u.1 + v.1, u.2 + v.2)
def znonneg (z : Z35) : Bool :=
