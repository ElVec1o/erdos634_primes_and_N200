import Erdos634.R990Tiling
import Erdos634.Z3Real
import Erdos634.CertGeom
import Erdos634.SssCongruent
import Erdos634.Ladder
import Erdos634.Tiling44Bridge

/-!
# `R990Tiling`, assembled into a genuine `CongruentDissection`

Erdős #634. `990` is a tile count: 990 copies of the tile `(8,7,13)` tile the triangle with squared
sides `[3262922884, 11335860900, 9344702224]` at scale `338`. Same pattern as `R88TilingBridge`/`R990TilingBridge`: the certificate's
`Z3`/`Pt`/`cross`/`dist2`/`znonneg` are literally `Z3Real`'s through `toZPt`. Generated by
a script.

Axiom-clean; no `sorry`.
-/

namespace Erdos634.R990TilingBridge

open Erdos634.Z3Real Erdos634.Geometry
open Erdos634.Tiling44Bridge (affNeg_apply lineFun_ne_zero_of_sq_ne)

def toZPt (p : R990Tiling.Pt) : ZPt := p

/-- **The real determinant of a `R990Tiling.Tri`'s three vertices**, transferred from its `ℤ[√3]`
cross product. -/
theorem det3_eq_toR_cross (t : R990Tiling.Tri) :
    Erdos634.CertCoord.det3
      (toR (zx (toZPt (R990Tiling.t1 t)))) (toR (zy (toZPt (R990Tiling.t1 t))))
      (toR (zx (toZPt (R990Tiling.t2 t)))) (toR (zy (toZPt (R990Tiling.t2 t))))
      (toR (zx (toZPt (R990Tiling.t3 t)))) (toR (zy (toZPt (R990Tiling.t3 t))))
    = toR (zcross (toZPt (R990Tiling.t1 t)) (toZPt (R990Tiling.t2 t)) (toZPt (R990Tiling.t3 t))) :=
  toR_zcross _ _ _

/-- **The target's determinant is `18144√15`**, positive. -/
theorem target_det_pos :
    (0:ℝ) < Erdos634.CertCoord.det3
      (toR (zx (toZPt (R990Tiling.t1 R990Tiling.target))))
      (toR (zy (toZPt (R990Tiling.t1 R990Tiling.target))))
      (toR (zx (toZPt (R990Tiling.t2 R990Tiling.target))))
      (toR (zy (toZPt (R990Tiling.t2 R990Tiling.target))))
      (toR (zx (toZPt (R990Tiling.t3 R990Tiling.target))))
      (toR (zy (toZPt (R990Tiling.t3 R990Tiling.target)))) := by
  rw [det3_eq_toR_cross]
  exact toR_pos (z := zcross (toZPt (R990Tiling.t1 R990Tiling.target))
    (toZPt (R990Tiling.t2 R990Tiling.target)) (toZPt (R990Tiling.t3 R990Tiling.target))) (by decide)

/-- **The target, as a real `Tri`.** -/
noncomputable def targetTri : Tri :=
  Erdos634.CertCoord.mkTri
    (toR (zx (toZPt (R990Tiling.t1 R990Tiling.target))))
    (toR (zy (toZPt (R990Tiling.t1 R990Tiling.target))))
    (toR (zx (toZPt (R990Tiling.t2 R990Tiling.target))))
    (toR (zy (toZPt (R990Tiling.t2 R990Tiling.target))))
    (toR (zx (toZPt (R990Tiling.t3 R990Tiling.target))))
    (toR (zy (toZPt (R990Tiling.t3 R990Tiling.target))))
    target_det_pos.ne'

/-- **The first piece's determinant is `48√15`**, positive — a smaller instance of the same
computation, confirming the pattern generalizes piece-by-piece. -/
theorem piece0_det_pos :
    (0:ℝ) < Erdos634.CertCoord.det3
      (toR (zx (toZPt (R990Tiling.t1 (R990Tiling.tiles.headI)))))
      (toR (zy (toZPt (R990Tiling.t1 (R990Tiling.tiles.headI)))))
      (toR (zx (toZPt (R990Tiling.t2 (R990Tiling.tiles.headI)))))
      (toR (zy (toZPt (R990Tiling.t2 (R990Tiling.tiles.headI)))))
      (toR (zx (toZPt (R990Tiling.t3 (R990Tiling.tiles.headI)))))
      (toR (zy (toZPt (R990Tiling.t3 (R990Tiling.tiles.headI))))) := by
  rw [det3_eq_toR_cross]
  exact toR_pos (z := zcross (toZPt (R990Tiling.t1 (R990Tiling.tiles.headI)))
    (toZPt (R990Tiling.t2 (R990Tiling.tiles.headI))) (toZPt (R990Tiling.t3 (R990Tiling.tiles.headI))))
    (by decide)

-- Every one of the 990 pieces is positively oriented.
set_option maxRecDepth 400000 in
set_option maxHeartbeats 0 in
theorem all_pieces_pos :
    ∀ t ∈ R990Tiling.tiles,
      zpos (zcross (toZPt (R990Tiling.t1 t)) (toZPt (R990Tiling.t2 t)) (toZPt (R990Tiling.t3 t)))
        = true := by
  decide +kernel

/-- **Every piece, as a real `Tri`**, uniformly — the general form `thm:44`'s data entry needs,
combining `all_pieces_pos` with `det3_eq_toR_cross` instead of writing 44 separate constructions. -/
noncomputable def pieceTri {t : R990Tiling.Tri} (ht : t ∈ R990Tiling.tiles) : Tri :=
  Erdos634.CertCoord.mkTri
    (toR (zx (toZPt (R990Tiling.t1 t)))) (toR (zy (toZPt (R990Tiling.t1 t))))
    (toR (zx (toZPt (R990Tiling.t2 t)))) (toR (zy (toZPt (R990Tiling.t2 t))))
    (toR (zx (toZPt (R990Tiling.t3 t)))) (toR (zy (toZPt (R990Tiling.t3 t))))
    (by
      rw [det3_eq_toR_cross]
      exact (toR_pos (all_pieces_pos t ht)).ne')

/-- **The `lineFun` of a certificate edge is nonconstant**, for two *concrete* endpoints `P ≠ Q`
whose real coordinates differ — resolved via `Z3Real.toR_ne_zero_of_sq_ne` rather than injectivity
of `toR` (which this project deliberately never proves). `hx`/`hy` are the decidable `ℤ[√3]`
side conditions (`zx Q - zx P` resp. `zy Q - zy P` squared-nonequal to `3 * (other coord)²`); one
of the two always holds for a genuine edge, matching whichever coordinate actually differs. -/
theorem lineFun_ne_zero_of_sq_ne {P Q : ZPt}
    (h : (zsub (zx P) (zx Q)).1 ^ 2 ≠ 3 * (zsub (zx P) (zx Q)).2 ^ 2
       ∨ (zsub (zy P) (zy Q)).1 ^ 2 ≠ 3 * (zsub (zy P) (zy Q)).2 ^ 2) :
    (Erdos634.CertGeom.lineFun (toR (zx P)) (toR (zy P)) (toR (zx Q)) (toR (zy Q))).linear ≠ 0 := by
  apply Erdos634.CertGeom.lineFun_linear_ne_zero
  rcases h with h | h
  · exact Or.inl (sub_ne_zero.mp (by rw [← toR_sub]; exact toR_ne_zero_of_sq_ne h))
  · exact Or.inr (sub_ne_zero.mp (by rw [← toR_sub]; exact toR_ne_zero_of_sq_ne h))

/-- Pointwise negation of an affine map into `ℝ`. -/
theorem affNeg_apply (g : Plane →ᵃ[ℝ] ℝ) (p : Plane) : (-g) p = -(g p) := by
  have := congrFun (AffineMap.coe_neg g) p
  simpa using this

/-- `R990Tiling.cross` is literally `Z3Real.zcross` read through `toZPt` — the two files define the
same operations on the same underlying type, so this is `rfl`. -/
theorem cross_eq_zcross (o a b : R990Tiling.Pt) :
    R990Tiling.cross o a b = zcross (toZPt o) (toZPt a) (toZPt b) := rfl

/-- `R990Tiling.dist2` is literally `Z3Real.zdist2` read through `toZPt` — again `rfl`. -/
theorem dist2_eq_zdist2 (p q : R990Tiling.Pt) :
    R990Tiling.dist2 p q = zdist2 (toZPt p) (toZPt q) := rfl

/-- **A piece's vertex, named by index.** -/
def vertexOf (t : R990Tiling.Tri) (i : Fin 3) : R990Tiling.Pt :=
  ![R990Tiling.t1 t, R990Tiling.t2 t, R990Tiling.t3 t] i

/-- **`pieceTri`'s vertices are exactly `vertexOf`, read as real points.** -/
theorem pieceTri_pts (t : R990Tiling.Tri) (ht : t ∈ R990Tiling.tiles) (i : Fin 3) :
    (pieceTri ht).pts i
      = Erdos634.CertCoord.mkPt (toR (zx (toZPt (vertexOf t i)))) (toR (zy (toZPt (vertexOf t i)))) := by
  fin_cases i <;> rfl

/-- **Squared distances between a piece's vertices, transferred to `ℝ` from the certificate's own
`dist2`.** -/
theorem pieceTri_dist_sq (t : R990Tiling.Tri) (ht : t ∈ R990Tiling.tiles) (i j : Fin 3) :
    dist ((pieceTri ht).pts i) ((pieceTri ht).pts j) ^ 2 = toR (R990Tiling.dist2 (vertexOf t i) (vertexOf t j)) := by
  rw [pieceTri_pts t ht i, pieceTri_pts t ht j, Erdos634.CertCoord.dist_sq_mkPt,
    dist2_eq_zdist2]
  exact toR_zdist2 _ _

/-- **A single `sepBy`-true witness gives a genuine separating affine functional** between two
pieces, read as real `Tri` objects — the assembly step `CertGeom.pairwise_disjoint_of_separating`
needs, for one pair. `hPQ` is `lineFun_ne_zero_of_sq_ne`'s decidable side condition on the edge
`(P, Q)`; the certificate's own `sepBy` supplies which sign pattern holds. -/
theorem sep_of_sepBy {P Q : R990Tiling.Pt} {A B : R990Tiling.Tri}
    (hPQ : (zsub (zx (toZPt P)) (zx (toZPt Q))).1 ^ 2
             ≠ 3 * (zsub (zx (toZPt P)) (zx (toZPt Q))).2 ^ 2
         ∨ (zsub (zy (toZPt P)) (zy (toZPt Q))).1 ^ 2
             ≠ 3 * (zsub (zy (toZPt P)) (zy (toZPt Q))).2 ^ 2)
    (hsep : R990Tiling.sepBy P Q A B = true) (hA : A ∈ R990Tiling.tiles) (hB : B ∈ R990Tiling.tiles) :
    ∃ (f : Plane →ᵃ[ℝ] ℝ) (_ : f.linear ≠ 0) (c : ℝ),
      (∀ x ∈ (pieceTri hA).carrier, f x ≤ c) ∧ (∀ x ∈ (pieceTri hB).carrier, c ≤ f x) := by
  set f : Plane →ᵃ[ℝ] ℝ :=
    Erdos634.CertGeom.lineFun (toR (zx (toZPt P))) (toR (zy (toZPt P)))
      (toR (zx (toZPt Q))) (toR (zy (toZPt Q))) with hfdef
  have hflin : f.linear ≠ 0 := lineFun_ne_zero_of_sq_ne hPQ
  have hfval : ∀ v : R990Tiling.Pt,
      f (Erdos634.CertCoord.mkPt (toR (zx (toZPt v))) (toR (zy (toZPt v))))
        = toR (R990Tiling.cross P Q v) := by
    intro v
    rw [hfdef, Erdos634.CertGeom.lineFun_apply, Erdos634.CertCoord.mkPt_zero,
      Erdos634.CertCoord.mkPt_one, cross_eq_zcross]
    exact toR_zcross _ _ _
  have hpts : ∀ (t : R990Tiling.Tri) (ht : t ∈ R990Tiling.tiles) (k : Fin 3),
      (pieceTri ht).pts k
        = Erdos634.CertCoord.mkPt (toR (zx (toZPt (![R990Tiling.t1 t, R990Tiling.t2 t, R990Tiling.t3 t] k))))
            (toR (zy (toZPt (![R990Tiling.t1 t, R990Tiling.t2 t, R990Tiling.t3 t] k)))) := by
    intro t ht k; fin_cases k <;> rfl
  simp only [R990Tiling.sepBy, List.all_eq_true, List.mem_cons, Bool.and_eq_true,
    Bool.or_eq_true, List.map, forall_eq_or_imp] at hsep
  rcases hsep with ⟨hsA, hsB⟩ | ⟨hsA, hsB⟩
  · -- A's vertices have cross ≥ 0, B's have cross ≤ 0 (znonpos)
    refine ⟨-f, neg_ne_zero.mpr hflin, 0, ?_, ?_⟩
    · exact Erdos634.CertGeom.le_of_forall_pts_le (-f) (t := pieceTri hA) (c := 0)
        (fun k => by
          rw [affNeg_apply, hpts A hA k, hfval, neg_le, neg_zero]
          fin_cases k <;> first | exact Erdos634.Z3Real.toR_nonneg hsA.1 | exact Erdos634.Z3Real.toR_nonneg hsA.2.1 | exact Erdos634.Z3Real.toR_nonneg hsA.2.2.1)
    · intro x hx
      have hb := Erdos634.CertGeom.le_of_forall_pts_le f (t := pieceTri hB) (c := 0)
        (fun k => by
          rw [hpts B hB k, hfval]
          fin_cases k <;> first | exact Erdos634.Z3Real.toR_nonpos hsB.1 | exact Erdos634.Z3Real.toR_nonpos hsB.2.1 | exact Erdos634.Z3Real.toR_nonpos hsB.2.2.1)
      have := hb x hx
      rw [affNeg_apply]
      linarith
  · -- A's vertices have cross ≤ 0 (znonpos), B's have cross ≥ 0
    refine ⟨f, hflin, 0, ?_, ?_⟩
    · exact Erdos634.CertGeom.le_of_forall_pts_le f (t := pieceTri hA) (c := 0)
        (fun k => by
          rw [hpts A hA k, hfval]
          fin_cases k <;> first | exact Erdos634.Z3Real.toR_nonpos hsA.1 | exact Erdos634.Z3Real.toR_nonpos hsA.2.1 | exact Erdos634.Z3Real.toR_nonpos hsA.2.2.1)
    · intro x hx
      have hb := Erdos634.CertGeom.le_of_forall_pts_le (-f) (t := pieceTri hB) (c := 0)
        (fun k => by
          rw [affNeg_apply, hpts B hB k, hfval, neg_le, neg_zero]
          fin_cases k <;> first | exact Erdos634.Z3Real.toR_nonneg hsB.1 | exact Erdos634.Z3Real.toR_nonneg hsB.2.1 | exact Erdos634.Z3Real.toR_nonneg hsB.2.2.1)
      have := hb x hx
      rw [affNeg_apply] at this
      linarith

/-! ## Every pair of distinct pieces is separated — decided by the kernel in chunks

Rather than unpacking an explicit witness list, it is cheaper to `decide` the *existence* of a separating edge candidate per
pair directly: for each of the ordered pairs, some one of the 6 candidate edges (3 from each
triangle) both separates them (`sepBy`) and satisfies `sep_of_sepBy`'s decidable side condition
(`sqCond`). This one `decide` (~12s) replaces per-pair data entry entirely. -/

/-- The 6 candidate separating edges for a pair: each triangle's own 3 edges. -/
def edgeCands (A B : R990Tiling.Tri) : List (R990Tiling.Pt × R990Tiling.Pt) :=
  [R990Tiling.edgeOf A 0, R990Tiling.edgeOf A 1, R990Tiling.edgeOf A 2,
   R990Tiling.edgeOf B 0, R990Tiling.edgeOf B 1, R990Tiling.edgeOf B 2]

/-- The decidable side condition `sep_of_sepBy` needs for an edge `(P, Q)`, as a `Bool` — a direct
`decide` of the exact `Prop` `sep_of_sepBy` wants, so `sqCond_iff` is immediate. -/
def sqCond (pq : R990Tiling.Pt × R990Tiling.Pt) : Bool :=
  decide ((zsub (zx (toZPt pq.1)) (zx (toZPt pq.2))).1 ^ 2
             ≠ 3 * (zsub (zx (toZPt pq.1)) (zx (toZPt pq.2))).2 ^ 2
         ∨ (zsub (zy (toZPt pq.1)) (zy (toZPt pq.2))).1 ^ 2
             ≠ 3 * (zsub (zy (toZPt pq.1)) (zy (toZPt pq.2))).2 ^ 2)

/-- Some candidate edge both separates `A` and `B` and satisfies the side condition. -/
def pairOK (A B : R990Tiling.Tri) : Bool :=
  (edgeCands A B).any (fun pq => R990Tiling.sepBy pq.1 pq.2 A B && sqCond pq)

-- Every one of the 990*990 ordered pairs of distinct pieces has a working separating edge.
-- (R84TilingBridge decides the `∀ A ∈ tiles, ∀ B ∈ tiles` statement in one `decide`; at this many tiles that needs more
-- than 10 GB, so here the check is a Bool function evaluated by the kernel on 124 chunks of 8 tiles.)

/-- `pairOK A B` for every `A` of `L` and every tile `B ≠ A`, as a `Bool` -/
noncomputable def pairsOK (L : List R990Tiling.Tri) : Bool :=
  L.all (fun A => R990Tiling.tiles.all (fun B => decide (A = B) || pairOK A B))

/-- the `k`-th block of 8 tiles -/
noncomputable def chunk (k : Nat) : List R990Tiling.Tri := (R990Tiling.tiles.drop (8 * k)).take 8


end Erdos634.R990TilingBridge
