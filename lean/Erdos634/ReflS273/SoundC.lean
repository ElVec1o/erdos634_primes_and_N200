  set G := rtri Dn hD t.a.X t.a.Y t.b.X t.b.Y t.c.X t.c.Y hp with hG
  have hGc : G.carrier = T.carrier := by rw [hc, hcar]
  have hex : ∀ m : Fin 3, ∃ k, T.pts k = G.pts m := by
    intro m
    have h1 := Erdos634.Geometry.A1Pos.target_vertex_extreme G m
    rw [hGc] at h1
    have h1' : G.pts m ∈ (convexHull ℝ (Set.range T.pts)).extremePoints ℝ := h1
    obtain ⟨k, hk⟩ := extremePoints_convexHull_subset h1'
    exact ⟨k, hk⟩
  obtain ⟨k0, h0⟩ := hex 0
  obtain ⟨k1, h1⟩ := hex 1
  obtain ⟨k2, h2⟩ := hex 2
  have hinj := G.indep.injective
  refine ⟨k0, k1, k2, ?_, ?_, ?_, h0, h1, h2⟩
  · intro h; exact absurd (hinj (show G.pts 0 = G.pts 1 by rw [← h0, ← h1, h])) (by decide)
  · intro h; exact absurd (hinj (show G.pts 0 = G.pts 2 by rw [← h0, ← h2, h])) (by decide)
  · intro h; exact absurd (hinj (show G.pts 1 = G.pts 2 by rw [← h1, ← h2, h])) (by decide)

/-- every vertex of a real triangle is a vertex of a checker triangle with the same carrier -/
theorem pts_of_carrier (Dn : ℝ) (T : Erdos634.Geometry.Tri) (t : Tri) (hc : T.carrier = t.carr Dn) (k : Fin 3) :
    T.pts k = t.a.re Dn ∨ T.pts k = t.b.re Dn ∨ T.pts k = t.c.re Dn := by
  have h1 := Erdos634.Geometry.A1Pos.target_vertex_extreme T k
  rw [hc] at h1
  have h2 : T.pts k ∈ ({t.a.re Dn, t.b.re Dn, t.c.re Dn} : Set Plane) := extremePoints_convexHull_subset h1
  simpa using h2

