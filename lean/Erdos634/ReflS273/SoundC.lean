              (Tri.vert_re_mem Dn (placeTri I v d p) 1) hdet
          · simp only [if_true] at hdet
            exact esc_sound_D Dn hD I htok D htarget _ j hj e _ hwc
              (Tri.vert_re_mem Dn (placeTri I v d p) 2) hdet
        | ovl m w =>
          simp only [killsCheckC, killOkC] at hk
          cases hm : cfg[m]? with
