/-- **The conjugate-dissection property of an instance**: every dissection of the instance has a conjugate dissection
of the same target, tile by tile. -/
def ConjHyp (Dn : ℝ) (I : Inst) (M : Erdos634.Geometry.Tri) : Prop :=
  ∀ (N : ℕ) (D : Erdos634.Geometry.CongruentDissection N), D.target.carrier = I.tgt.carr Dn → D.model.Congruent M →
    ∃ D' : Erdos634.Geometry.CongruentDissection N, D'.target.carrier = I.tgt.carr Dn ∧
      ∀ (i : Fin N) (t : Tri), t.ok = true → (cjTri t).ok = true → (D.tile i).carrier = t.carr Dn →
        (D'.tile i).carrier = (cjTri t).carr Dn

