    (cfg : List Tri) (hcfgok : ∀ t ∈ cfg, t.ok = true)
    {N : ℕ} (D : Erdos634.Geometry.CongruentDissection N)
    (htarget : D.target.carrier = I.tgt.carr Dn)
    (D' : Erdos634.Geometry.CongruentDissection N) (htarget' : D'.target.carrier = I.tgt.carr Dn)
