/-- the vertices of a checker triangle are vertices of any real triangle with the same carrier -/
theorem verts_of_carrier (Dn : ℝ) (hD : 0 < Dn) (T : Erdos634.Geometry.Tri) (t : Tri) (ht : t.ok = true)
    (hc : T.carrier = t.carr Dn) :
    ∃ k0 k1 k2 : Fin 3, k0 ≠ k1 ∧ k0 ≠ k2 ∧ k1 ≠ k2 ∧ T.pts k0 = t.a.re Dn ∧ T.pts k1 = t.b.re Dn ∧
      T.pts k2 = t.c.re Dn := by
