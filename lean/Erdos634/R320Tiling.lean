abbrev Z2 := Int × Int
abbrev Pt := Int × Int × Int × Int
def zmul (u v : Z2) : Z2 := (u.1*v.1 + 2*u.2*v.2, u.1*v.2 + u.2*v.1)
def zsub (u v : Z2) : Z2 := (u.1 - v.1, u.2 - v.2)
def zadd (u v : Z2) : Z2 := (u.1 + v.1, u.2 + v.2)
def znonneg (z : Z2) : Bool :=
  if 0 <= z.1 then (if 0 <= z.2 then true else 2*z.2*z.2 <= z.1*z.1)
  else (if z.2 < 0 then false else z.1*z.1 <= 2*z.2*z.2)
def znonpos (z : Z2) : Bool := znonneg (-z.1, -z.2)
def zpos (z : Z2) : Bool := !(znonpos z)
def px (p : Pt) : Z2 := (p.1, p.2.1)
def py (p : Pt) : Z2 := (p.2.2.1, p.2.2.2)
def cross (o a b : Pt) : Z2 :=
  zsub (zmul (zsub (px a) (px o)) (zsub (py b) (py o))) (zmul (zsub (py a) (py o)) (zsub (px b) (px o)))
def dist2 (p q : Pt) : Z2 :=
  zadd (zmul (zsub (px q) (px p)) (zsub (px q) (px p))) (zmul (zsub (py q) (py p)) (zsub (py q) (py p)))
abbrev Tri := Pt × Pt × Pt
def t1 (t : Tri) : Pt := t.1
